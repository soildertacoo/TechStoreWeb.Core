@model TechStore.Models.OrderDetails_model

@{
    ViewBag.Title = "Order Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 bg-light">
        <div class="row mb-4">
            <div class="col-12">
                @if (ViewBag.RefundStatus != null)
                {
                    string re = (string)ViewBag.RefundStatus;
                    string[] refund = re.Split('|').ToArray();
                    string stat = refund.Length > 0 ? refund[0].ToLower().Trim() : "";
                    string message = refund.Length > 0 ? refund[1].Trim() : "";

                    if (stat == "accepted")
                    {
                        <div class="alert alert-success shadow-sm border-0 d-flex align-items-center" style="border-radius: 12px;">
                            <i class="fas fa-check-circle fs-4 me-3 text-success"></i>
                            <div>
                                <h6 class="mb-1 fw-bold">Yêu cầu được chấp nhận</h6>
                                <span class="mb-0">@message</span>
                            </div>
                        </div>
                    }
                    else if (stat == "rejected")
                    {
                        <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center" style="border-radius: 12px;">
                            <i class="fas fa-times-circle fs-4 me-3 text-danger"></i>
                            <div>
                                <h6 class="mb-1 fw-bold">Yêu cầu bị từ chối</h6>
                                <span class="mb-0">@message</span>
                            </div>
                        </div>
                    }
                    else if (stat == "sended")
                    {
                        <div class="alert alert-info shadow-sm border-0 d-flex align-items-center" style="border-radius: 12px;">
                            <i class="fas fa-clock fs-4 me-3 text-info"></i>
                            <div>
                                <h6 class="mb-1 fw-bold">Đang xử lý yêu cầu</h6>
                                <span class="mb-0">@message</span>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    

    <div class="row g-4">
        
        <div class="col-lg-8">
            
            <div class="card shadow-sm border-0 mb-4 rounded-4 overflow-hidden">
                <div class="card-body d-flex justify-content-between align-items-center p-4" style="background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);">
                    <div class="text-white">
                        <h4 class="fw-bold mb-1"><i class="fas fa-file-invoice me-2"></i>Chi tiết đơn hàng</h4>
                        <span class="opacity-75">Mã đơn: <strong class="fs-5">#@Model.OrderPro.TrackingNumber</strong></span>
                    </div>
                    <div>
                        @{
                            string statusBg = "bg-warning text-dark";
                            if (Model.OrderPro.Status == "Đã giao") statusBg = "bg-success text-white";
                            else if (Model.OrderPro.Status == "Đã bị hủy") statusBg = "bg-danger text-white";
                        }
                        <span class="badge @statusBg px-4 py-2 rounded-pill fs-6 fw-semibold shadow-sm">
                            @Html.DisplayFor(model => model.OrderPro.Status)
                        </span>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4 rounded-4">
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-6 border-end">
                            <h6 class="text-uppercase fw-bold text-muted mb-3"><i class="fas fa-user-circle me-2 text-primary"></i>Thông tin người nhận</h6>
                            <h5 class="fw-bold text-dark mb-2">@Html.DisplayFor(model => model.OrderPro.Customer.NameCus)</h5>
                            <p class="text-muted mb-0 lh-lg">
                                <i class="fas fa-map-marker-alt text-secondary me-2"></i> @Html.DisplayFor(model => model.OrderPro.AddressDeliverry)<br>
                                <i class="fas fa-phone-alt text-secondary me-2"></i> @(string.IsNullOrEmpty(Model.OrderPro.Customer.PhoneCus) ? "Chưa cập nhật" : Model.OrderPro.Customer.PhoneCus)
                            </p>
                        </div>
                        <div class="col-md-6 ps-md-4">
                            <h6 class="text-uppercase fw-bold text-muted mb-3"><i class="fas fa-shipping-fast me-2 text-info"></i>Thông tin giao hàng</h6>
                            <ul class="list-unstyled mb-0 lh-lg text-muted">
                                <li><strong>Mã vận đơn:</strong> <span class="text-dark fw-medium">@Html.DisplayFor(model => model.OrderPro.TrackingNumber)</span></li>
                                <li>
                                    <strong>Mã vận đơn ĐVVC:</strong> 
                                    <span class="text-dark fw-medium">
                                        @(string.IsNullOrEmpty(Model.OrderPro.ShippingCode) ? "Chưa có ĐVVC" : Model.OrderPro.ShippingCode)
                                    </span>
                                </li>
                                <li><strong>Ngày đặt:</strong> <span class="text-dark fw-medium">@Model.OrderPro.DateOrder</span></li>
                                <li><strong>Ngày giao dự kiến:</strong> 
                                    @if (Model.OrderPro.DeliveryDate.HasValue)
                                    {
                                        <span class="text-success fw-bold">@Model.OrderPro.DeliveryDate.Value.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span>Đang cập nhật</span>
                                    }
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold text-dark mb-4"><i class="fas fa-shopping-cart me-2 text-primary"></i>Sản phẩm đã đặt</h5>
                    
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle mb-0 custom-product-table">
                            <thead class="text-muted bg-light rounded-top">
                                <tr>
                                    <th scope="col" class="ps-3 py-3 rounded-start">Sản phẩm</th>
                                    <th scope="col" class="text-center py-3">Đơn giá</th>
                                    <th scope="col" class="text-center py-3">SL</th>
                                    <th scope="col" class="text-end pe-3 py-3 rounded-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderDetails)
                                {
                                    <tr class="border-bottom border-light">
                                        <td class="ps-3 py-3">
                                            <a style="text-decoration: none;" href="@Url.Action("Details", "CustomerPro", new { id = item.Products.ProductID })">
                                                <div class="d-flex align-items-center">
                                                    <img src="~/Images/@item.Products.ImagePro" alt="@item.Products.NamePro" class="rounded-3 shadow-sm me-3" style="width: 70px; height: 70px; object-fit: cover;">
                                                    <div>
                                                        <h6 class="mb-0 fw-bold text-dark">@item.Products.NamePro</h6>
                                                        <small class="text-muted">Mã SP: #@item.Products.ProductID</small>
                                                    </div>
                                                </div>
                                            </a>
                                        </td>
                                        <td class="text-center fw-medium text-muted">@string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", item.UnitPrice)</td>
                                        <td class="text-center fw-bold text-dark">x @item.Quantity</td>
                                        <td class="text-end pe-3 fw-bold text-primary">@string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", item.UnitPrice * item.Quantity)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div> <div class="col-lg-4">
            
            <div class="card shadow-sm border-0 mb-4 rounded-4" style="background: #f8fafc;">
                <div class="card-body p-4">
                    <h6 class="text-uppercase fw-bold text-muted mb-4"><i class="fas fa-wallet me-2 text-success"></i>Chi tiết thanh toán</h6>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Phương thức:</span>
                        <span class="fw-medium text-dark">@Html.DisplayFor(model => model.OrderPro.PaymentMethod)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 pb-3 border-bottom border-light">
                        <span class="text-muted">Trạng thái TT:</span>
                        <span class="badge @(Model.OrderPro.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark") rounded-pill">
                            @Html.DisplayFor(model => model.OrderPro.PaymentStatus)
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính:</span>
                        <span class="fw-medium text-dark">@string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", Model.OrderPro.TotalAmount - Model.OrderPro.ShippingCost)</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 pb-3 border-bottom border-light">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span class="fw-medium text-dark">+ @string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", Model.OrderPro.ShippingCost)</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="fw-bold fs-5 text-dark">Tổng cộng:</span>
                        <span class="fw-bold fs-3 text-danger">@string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", Model.OrderPro.TotalAmount)</span>
                    </div>

                    @if (Model.OrderPro.Status == "Đã giao")
                    {
                        <div class="mt-4 pt-3 border-top border-light text-center">
                            <a class="btn btn-outline-dark rounded-pill px-4 fw-bold w-100" id="idSupport" 
                               href="@Url.Action("IndexSupport", "Contact", new { idOrder = Model.OrderPro.ID, namecus = Model.OrderPro.Customer.NameCus, email = Model.OrderPro.Customer.EmailCus, phone = Model.OrderPro.Customer.PhoneCus, trackingNumber = Model.OrderPro.TrackingNumber })">
                               <i class="fas fa-headset me-2"></i> Yêu cầu hỗ trợ
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase fw-bold text-muted mb-4"><i class="fas fa-route me-2 text-primary"></i>Hành trình đơn hàng</h6>
                    
                    <div class="custom-timeline">
                        <div class="timeline-step">
                            <div class="timeline-icon bg-success"><i class="fas fa-check text-white"></i></div>
                            <div class="timeline-info">
                                <h6 class="fw-bold text-dark mb-1">Đơn hàng đã đặt</h6>
                                <span class="text-muted small">@Model.OrderPro.DateOrder</span>
                            </div>
                        </div>

                        @if (Model.OrderPro.Status != "Đã giao" && Model.OrderPro.Status != "Đã bị hủy")
                        {
                            <div class="timeline-step">
                                <div class="timeline-icon bg-primary"><i class="fas fa-box text-white"></i></div>
                                <div class="timeline-info">
                                    <h6 class="fw-bold text-dark mb-1">Đang xử lý</h6>
                                    <span class="text-muted small">Người bán đang chuẩn bị hàng</span>
                                </div>
                            </div>
                        }

                        @if (Model.OrderPro.Status == "Đang giao")
                        {
                            <div class="timeline-step">
                                <div class="timeline-icon bg-info"><i class="fas fa-truck text-white"></i></div>
                                <div class="timeline-info">
                                    <h6 class="fw-bold text-dark mb-1">Đang giao hàng</h6>
                                    <span class="text-muted small">Đơn hàng đang trên đường đến bạn</span>
                                </div>
                            </div>
                        }

                        @if (Model.OrderPro.Status == "Đã giao")
                        {
                            <div class="timeline-step">
                                <div class="timeline-icon bg-success"><i class="fas fa-home text-white"></i></div>
                                <div class="timeline-info">
                                    <h6 class="fw-bold text-dark mb-1">Giao hàng thành công</h6>
                                    <span class="text-muted small">
                                        @(Model.OrderPro.DeliveryDate.HasValue ? Model.OrderPro.DeliveryDate.Value.ToString("dd/MM/yyyy HH:mm") : "Đã nhận hàng")
                                    </span>
                                </div>
                            </div>
                        }

                        @if (Model.OrderPro.Status == "Đã bị hủy")
                        {
                            <div class="timeline-step">
                                <div class="timeline-icon bg-danger"><i class="fas fa-times text-white"></i></div>
                                <div class="timeline-info">
                                    <h6 class="fw-bold text-danger mb-1">Đã hủy</h6>
                                    <span class="text-muted small">Đơn hàng đã bị hủy</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div> </div>
</div>

<style>
    /* CSS cho Bảng sản phẩm */
    .custom-product-table tbody tr:last-child {
        border-bottom: none !important;
    }
    .custom-product-table th {
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
    }

    /* CSS cho Timeline Hành Trình */
    .custom-timeline {
        position: relative;
        padding-left: 20px;
    }
    .custom-timeline::before {
        content: '';
        position: absolute;
        left: 28px; /* Căn giữa đường thẳng với icon */
        top: 0;
        bottom: 0;
        width: 2px;
        background-color: #e2e8f0;
    }
    .timeline-step {
        position: relative;
        display: flex;
        align-items: flex-start;
        margin-bottom: 1.5rem;
    }
    .timeline-step:last-child {
        margin-bottom: 0;
    }
    /* Xóa đoạn kẻ vạch thừa ở step cuối cùng */
    .timeline-step:last-child::after {
        content: '';
        position: absolute;
        left: 8px; /* Che đi phần đường thẳng thừa */
        top: 25px; 
        bottom: -20px;
        width: 4px;
        background-color: #fff;
    }
    
    .timeline-icon {
        position: relative;
        z-index: 2;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        margin-top: 3px;
        box-shadow: 0 0 0 4px #fff; /* Tạo viền trắng tách biệt với đường kẻ */
    }
    .timeline-icon i {
        font-size: 0.6rem;
    }
    .timeline-info {
        flex: 1;
    }
</style>
