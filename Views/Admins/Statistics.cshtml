@using System.Text.Json
@{
    ViewBag.Title = "Thống kê";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/luxon@3.4.4/build/global/luxon.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-luxon@1.3.1"></script>

<style>
    .chart-card {
        height: 100%;
        min-height: 420px;
        display: flex;
        flex-direction: column;
    }

    .chart-card .card-body {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    canvas {
        max-height: 320px;
        width: 100% !important;
    }
</style>

<div class="container-fluid">
    <!-- Tổng hợp thống kê -->
    <div class="row mb-4">
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow-sm rounded border-left-primary">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="mr-3">
                            <div class="icon-circle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="fas fa-dollar-sign fa-2x"></i>
                            </div>
                        </div>
                        <div>
                            <p class="mb-1 text-gray-500">Tổng doanh thu</p>
                            <h5 class="mb-0 font-weight-bold text-primary">
                                @(((ViewBag.DataRevenue as List<decimal>)?.Sum())?.ToString("N0") ?? "0") ₫
                            </h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow-sm rounded border-left-warning">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="mr-3">
                            <div class="icon-circle bg-warning text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="fas fa-shopping-cart fa-2x"></i>
                            </div>
                        </div>
                        <div>
                            <p class="mb-1 text-gray-500">Tổng giá vốn hàng bán</p>
                            <h5 class="mb-0 font-weight-bold text-warning">
                                @((ViewBag.TotalCost as decimal?)?.ToString("N0") ?? "0") ₫
                            </h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow-sm rounded border-left-success">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="mr-3">
                            <div class="icon-circle bg-success text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="fas fa-chart-bar fa-2x"></i>
                            </div>
                        </div>
                        <div>
                            <p class="mb-1 text-gray-500">Tổng lợi nhuận gộp</p>
                            <h5 class="mb-0 font-weight-bold text-success">
                                @((ViewBag.TotalProfit as decimal?)?.ToString("N0") ?? "0") ₫
                            </h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 mb-4">
            <div class="card shadow-sm rounded border-left-info">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="mr-3">
                            <div class="icon-circle bg-info text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                <i class="fas fa-percentage fa-2x"></i>
                            </div>
                        </div>
                        <div>
                            <p class="mb-1 text-gray-500">Tỷ suất lợi nhuận</p>
                            <h5 class="mb-0 font-weight-bold text-info">
                                @{
                                    var totalRevenue = (ViewBag.DataRevenue as List<decimal>)?.Sum() ?? 0;
                                    var profitMargin = totalRevenue > 0 ? ((ViewBag.TotalProfit as decimal?) / totalRevenue * 100) : 0;
                                    <text>@(profitMargin?.ToString("F2") ?? "0")</text>
                                }%
                            </h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm rounded chart-card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Biểu đồ Doanh thu</h5>
                    <form asp-action="Statistics" method="get" class="row mt-3">
                        <div class="col-md-3">
                            <label>Kiểu thống kê</label>
                            <select id="filterType" name="type" class="form-control">
                                 <option value="day" selected="@(Context.Request.Query["type"] == "day" ? "true" : "false")">Theo ngày</option>
                                 <option value="month" selected="@(Context.Request.Query["type"] == "month" ? "true" : "false")">Theo tháng</option>
                                 <option value="quarter" selected="@(Context.Request.Query["type"] == "quarter" ? "true" : "false")">Theo quý</option>
                                 <option value="range" selected="@(Context.Request.Query["type"] == "range" ? "true" : "false")">Nâng cao</option>
                            </select>
                        </div>

                        <div class="col-md-3 filter-day d-none">
                            <label>Ngày</label>
                            <input type="date" name="date" class="form-control" value="@Context.Request.Query["date"]" />
                        </div>

                        <div class="col-md-3 filter-month d-none">
                            <label>Tháng</label>
                            <select name="month" class="form-control">
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i" selected="@(Context.Request.Query["month"] == i.ToString() ? "true" : "false")">@i</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-2 filter-month d-none">
                            <label>Năm</label>
                            <input type="number" name="year" class="form-control" value="@(Context.Request.Query["year"].Count > 0 ? Context.Request.Query["year"].ToString() : DateTime.Now.Year.ToString())">
                        </div>

                        <div class="col-md-3 filter-quarter d-none">
                            <label>Quý</label>
                            <select name="quarter" class="form-control">
                                <option value="1" selected="@(Context.Request.Query["quarter"] == "1" ? "true" : "false")">Quý I</option>
                                <option value="2" selected="@(Context.Request.Query["quarter"] == "2" ? "true" : "false")">Quý II</option>
                                <option value="3" selected="@(Context.Request.Query["quarter"] == "3" ? "true" : "false")">Quý III</option>
                                <option value="4" selected="@(Context.Request.Query["quarter"] == "4" ? "true" : "false")">Quý IV</option>
                            </select>
                        </div>

                         <div class="col-md-2 filter-quarter d-none">
                             <label>Năm</label>
                             <input type="number" name="year" class="form-control" value="@(Context.Request.Query["year"].Count > 0 ? Context.Request.Query["year"].ToString() : DateTime.Now.Year.ToString())">
                         </div>

                        <div class="col-md-3 filter-range d-none">
                            <label>Từ ngày</label>
                            <input type="date" name="fromDate" class="form-control" value="@Context.Request.Query["fromDate"]" />
                        </div>

                        <div class="col-md-3 filter-range d-none">
                            <label>Đến ngày</label>
                            <input type="date" name="toDate" class="form-control" value="@Context.Request.Query["toDate"]" />
                        </div>

                        <div class="col-md-2">
                            <button type="submit" class="btn btn-info w-100">
                                <i class="fas fa-filter"></i> Thống kê
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm rounded chart-card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-trophy me-2"></i>Sản phẩm bán chạy</h5>
                </div>
                <div class="card-body">
                    <canvas id="bestSellingChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card shadow-sm rounded chart-card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-star me-2"></i>Thống kê Đánh giá</h5>
                </div>
                <div class="card-body">
                    <canvas id="reviewChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card shadow-sm rounded chart-card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-calculator me-2"></i>Thống kê Lời Lỗ</h5>
                </div>
                <div class="card-body">
                    <canvas id="profitLossChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Revenue Chart
    const revenueLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.Labels ?? new string[0]));
    const revenueData = @Html.Raw(JsonSerializer.Serialize(ViewBag.DataRevenue ?? new decimal[0]));

    const revenueCtx = document.getElementById('revenueChart')?.getContext('2d');

    if (revenueCtx) {
        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: revenueData,
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    borderColor: 'rgba(102, 126, 234, 1)',
                    borderWidth: 2,
                    tension: 0.4,
                    pointRadius: 4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Biểu đồ Doanh thu',
                        font: { size: 18 },
                        padding: { top: 10, bottom: 10 }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return 'Doanh thu: ' + new Intl.NumberFormat('vi-VN', {
                                    style: 'currency',
                                    currency: 'VND'
                                }).format(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        type: 'time',
                        time: {
                            unit: 'day', 
                            tooltipFormat: 'DD', 
                            displayFormats: {
                                day: 'dd/MM/yyyy'
                            }
                        },
                        title: {
                            display: true,
                            text: 'Ngày'
                        }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value => value.toLocaleString('vi-VN') + ' ₫'
                        },
                        title: {
                            display: true,
                            text: 'Doanh thu (VNĐ)'
                        }
                    }
                }
            }
        });
    }

    // Best Selling Chart
    const bestCtx = document.getElementById('bestSellingChart')?.getContext('2d');
    if (bestCtx) {
        new Chart(bestCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(ViewBag.BestSellingLabels ?? new string[0])),
                datasets: [{
                    data: @Html.Raw(JsonSerializer.Serialize(ViewBag.BestSellingData ?? new int[0])),
                    backgroundColor: [
                        '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF'
                    ],
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Sản phẩm bán chạy',
                        font: { size: 18 },
                        padding: { top: 10, bottom: 10 }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percent = ((context.parsed / total) * 100).toFixed(1);
                                return `${context.label}: ${context.parsed} (${percent}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    // Review Chart
    const reviewCtx = document.getElementById('reviewChart')?.getContext('2d');
    
    console.log("Review Chart Labels:", @Html.Raw(JsonSerializer.Serialize(ViewBag.ReviewLabels ?? new string[0])));
    console.log("Review Chart Data:", @Html.Raw(JsonSerializer.Serialize(ViewBag.ReviewData ?? new int[0])));
    console.log("Average Rating:", @Html.Raw(JsonSerializer.Serialize(ViewBag.AverageRating ?? new decimal[0])));
    
    if (reviewCtx) {
        new Chart(reviewCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(ViewBag.ReviewLabels ?? new string[0])),
                datasets: [
                    {
                        label: 'Số lượng đánh giá',
                        data: @Html.Raw(JsonSerializer.Serialize(ViewBag.ReviewData ?? new int[0])),
                        backgroundColor: 'rgba(240, 147, 251, 0.8)'
                    },
                    {
                        label: 'Điểm trung bình',
                        data: @Html.Raw(JsonSerializer.Serialize(ViewBag.AverageRating ?? new decimal[0])),
                        type: 'line',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        borderWidth: 2,
                        tension: 0.3,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Thống kê Đánh giá',
                        font: { size: 18 },
                        padding: { top: 10, bottom: 10 }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        position: 'left',
                        title: {
                            display: true,
                            text: 'Số lượng đánh giá'
                        }
                    },
                    y1: {
                        beginAtZero: true,
                        max: 5,
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Điểm trung bình (1-5)'
                        },
                        grid: {
                            drawOnChartArea: false
                        }
                    }
                }
            }
        });
    }

    // Profit/Loss Chart
    const profitLossCtx = document.getElementById('profitLossChart')?.getContext('2d');
    const profitLossLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.ProfitLossLabels ?? new string[0]));
    const profitLossRevenueData = @Html.Raw(JsonSerializer.Serialize(ViewBag.ProfitLossRevenueData ?? new decimal[0]));
    const profitLossCostData = @Html.Raw(JsonSerializer.Serialize(ViewBag.ProfitLossCostData ?? new decimal[0]));
    const profitLossProfitData = @Html.Raw(JsonSerializer.Serialize(ViewBag.ProfitLossProfitData ?? new decimal[0]));
    
    if (profitLossCtx) {
        new Chart(profitLossCtx, {
            type: 'line',
            data: {
                labels: profitLossLabels,
                datasets: [
                    {
                        label: 'Doanh thu',
                        data: profitLossRevenueData,
                        backgroundColor: 'rgba(54, 162, 235, 0.2)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 2,
                        tension: 0.4
                    },
                    {
                        label: 'Giá vốn hàng bán',
                        data: profitLossCostData,
                        backgroundColor: 'rgba(255, 99, 132, 0.2)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 2,
                        tension: 0.4
                    },
                    {
                        label: 'Lợi nhuận gộp',
                        data: profitLossProfitData,
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        borderWidth: 3,
                        tension: 0.4,
                        fill: false
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Thống kê Lời Lỗ',
                        font: { size: 18 },
                        padding: { top: 10, bottom: 10 }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return context.dataset.label + ': ' + new Intl.NumberFormat('vi-VN', {
                                    style: 'currency',
                                    currency: 'VND'
                                }).format(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        type: 'time',
                        time: {
                            unit: 'day',
                            tooltipFormat: 'DD',
                            displayFormats: {
                                day: 'dd/MM/yyyy'
                            }
                        },
                        title: {
                            display: true,
                            text: 'Ngày'
                        }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value => value.toLocaleString('vi-VN') + ' ₫'
                        },
                        title: {
                            display: true,
                            text: 'Số tiền (VNĐ)'
                        }
                    }
                }
            }
        });
    }

    const type = document.getElementById("filterType");

    function updateFilter(){

        document.querySelectorAll(".filter-day,.filter-month,.filter-quarter,.filter-range")
        .forEach(x=>x.classList.add("d-none"));

       if(type.value==="day")
        document.querySelectorAll(".filter-day").forEach(x=>x.classList.remove("d-none"));

       if(type.value==="month")
        document.querySelectorAll(".filter-month").forEach(x=>x.classList.remove("d-none"));

       if(type.value==="quarter")
        document.querySelectorAll(".filter-quarter").forEach(x=>x.classList.remove("d-none"));

       if(type.value==="range")
        document.querySelectorAll(".filter-range").forEach(x=>x.classList.remove("d-none"));
    }

// Gọi updateFilter ngay khi load trang để hiển thị đúng filter
updateFilter();

type.onchange=updateFilter;
</script>

