@using System.Text.Json
@{
    ViewBag.Title = "Thống kê";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/luxon@3.4.4/build/global/luxon.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-luxon@1.3.1"></script>

<style>
    .chart-card {
        height: 100%;
        min-height: 420px;
        display: flex;
        flex-direction: column;
    }

    .chart-card .card-body {
        flex: 1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    canvas {
        max-height: 320px;
        width: 100% !important;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm rounded chart-card">
                <div class="card-header bg-gradient-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-line me-2"></i>Biểu đồ Doanh thu</h5>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm rounded chart-card">
                <div class="card-header bg-gradient-success text-white">
                    <h5 class="mb-0"><i class="fas fa-trophy me-2"></i>Sản phẩm bán chạy</h5>
                </div>
                <div class="card-body">
                    <canvas id="bestSellingChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12 mb-4">
            <div class="card shadow-sm rounded chart-card">
                <div class="card-header bg-gradient-warning text-white">
                    <h5 class="mb-0"><i class="fas fa-star me-2"></i>Thống kê Đánh giá</h5>
                </div>
                <div class="card-body">
                    <canvas id="reviewChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Revenue Chart
    const revenueLabels = @Html.Raw(JsonSerializer.Serialize(ViewBag.Labels ?? new string[0]));
    const revenueData = @Html.Raw(JsonSerializer.Serialize(ViewBag.DataRevenue ?? new decimal[0]));

    const revenueCtx = document.getElementById('revenueChart')?.getContext('2d');

    if (revenueCtx) {
        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: revenueData,
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    borderColor: 'rgba(102, 126, 234, 1)',
                    borderWidth: 2,
                    tension: 0.4,
                    pointRadius: 4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Biểu đồ Doanh thu',
                        font: { size: 18 },
                        padding: { top: 10, bottom: 10 }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                return 'Doanh thu: ' + new Intl.NumberFormat('vi-VN', {
                                    style: 'currency',
                                    currency: 'VND'
                                }).format(context.parsed.y);
                            }
                        }
                    }
                },
                scales: {
                    x: {
                        type: 'time',
                        time: {
                            unit: 'day', 
                            tooltipFormat: 'DD', 
                            displayFormats: {
                                day: 'dd/MM/yyyy'
                            }
                        },
                        title: {
                            display: true,
                            text: 'Ngày'
                        }
                    },
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value => value.toLocaleString('vi-VN') + ' ₫'
                        },
                        title: {
                            display: true,
                            text: 'Doanh thu (VNĐ)'
                        }
                    }
                }
            }
        });
    }

    // Best Selling Chart
    const bestCtx = document.getElementById('bestSellingChart')?.getContext('2d');
    if (bestCtx) {
        new Chart(bestCtx, {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(ViewBag.BestSellingLabels ?? new string[0])),
                datasets: [{
                    data: @Html.Raw(JsonSerializer.Serialize(ViewBag.BestSellingData ?? new int[0])),
                    backgroundColor: [
                        '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', '#9966FF'
                    ],
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Sản phẩm bán chạy',
                        font: { size: 18 },
                        padding: { top: 10, bottom: 10 }
                    },
                    tooltip: {
                        callbacks: {
                            label: function (context) {
                                const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                const percent = ((context.parsed / total) * 100).toFixed(1);
                                return `${context.label}: ${context.parsed} (${percent}%)`;
                            }
                        }
                    }
                }
            }
        });
    }

    // Review Chart
    const reviewCtx = document.getElementById('reviewChart')?.getContext('2d');
    
    console.log("Review Chart Labels:", @Html.Raw(JsonSerializer.Serialize(ViewBag.ReviewLabels ?? new string[0])));
    console.log("Review Chart Data:", @Html.Raw(JsonSerializer.Serialize(ViewBag.ReviewData ?? new int[0])));
    console.log("Average Rating:", @Html.Raw(JsonSerializer.Serialize(ViewBag.AverageRating ?? new decimal[0])));
    
    if (reviewCtx) {
        new Chart(reviewCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(JsonSerializer.Serialize(ViewBag.ReviewLabels ?? new string[0])),
                datasets: [
                    {
                        label: 'Số lượng đánh giá',
                        data: @Html.Raw(JsonSerializer.Serialize(ViewBag.ReviewData ?? new int[0])),
                        backgroundColor: 'rgba(240, 147, 251, 0.8)'
                    },
                    {
                        label: 'Điểm trung bình',
                        data: @Html.Raw(JsonSerializer.Serialize(ViewBag.AverageRating ?? new decimal[0])),
                        type: 'line',
                        borderColor: 'rgba(75, 192, 192, 1)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        borderWidth: 2,
                        tension: 0.3,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: {
                    title: {
                        display: true,
                        text: 'Thống kê Đánh giá',
                        font: { size: 18 },
                        padding: { top: 10, bottom: 10 }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        position: 'left',
                        title: {
                            display: true,
                            text: 'Số lượng đánh giá'
                        }
                    },
                    y1: {
                        beginAtZero: true,
                        max: 5,
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Điểm trung bình (1-5)'
                        },
                        grid: {
                            drawOnChartArea: false
                        }
                    }
                }
            }
        });
    }
</script>