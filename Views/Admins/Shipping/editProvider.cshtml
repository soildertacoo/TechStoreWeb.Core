@model TechStore.Models.ShippingProviders 
@{
    ViewBag.Title = "Chỉnh sửa Đơn vị Vận chuyển";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4" style="max-width: 1000px;">
    <div class="d-flex align-items-center mb-4">
        <a href="@Url.Action("shippingManagement")" class="btn btn-light text-secondary rounded-circle me-3" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-arrow-left"></i>
        </a>
        <div>
            <h3 class="mb-0 fw-bold" style="color: #4f46e5;">Chỉnh sửa Đối tác: GHN</h3>
            <p class="text-muted mb-0">Cập nhật thông tin kết nối và API</p>
        </div>
    </div>

    @using (Html.BeginForm("editProvider", "Admins", FormMethod.Post, new { @class = "needs-validation" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(model => model.ProviderCode) 
        
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4 p-md-5">
                
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-secondary text-uppercase mb-0" style="font-size: 0.85rem; letter-spacing: 1px;">1. Thông tin cơ bản</h6>
                    
                    <div class="form-check form-switch d-flex align-items-center gap-2 m-0">
                        <label class="form-check-label text-muted small" for="isActive">Trạng thái hoạt động</label>
                        @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-check-input fs-5", @id = "isActive", @style="cursor: pointer;" })
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-8">
                        <label class="form-label fw-semibold">Tên Đơn vị Vận chuyển <span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.ProviderName, new { htmlAttributes = new { @class = "form-control rounded-3 py-2", placeholder = "Ví dụ: Giao Hàng Nhanh" } })
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Mã Code <span class="text-danger">*</span></label>
                        @Html.EditorFor(model => model.ProviderCode, new { htmlAttributes = new { @class = "form-control rounded-3 py-2 text-uppercase bg-light", @readonly = "readonly" } })
                        <small class="text-muted">Mã code không được phép sửa.</small>
                    </div>
                </div>

                <hr class="text-muted opacity-25 my-4">

                <h6 class="fw-bold text-secondary mb-3 text-uppercase" style="font-size: 0.85rem; letter-spacing: 1px;">2. Cấu hình Xác thực (Token)</h6>
                <div class="mb-4">
                    <label class="form-label fw-semibold">API Token / Client Secret <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="fas fa-key text-warning"></i></span>
                        @Html.EditorFor(model => model.ApiToken, new { htmlAttributes = new { @class = "form-control py-2", placeholder = "Nhập mã Token..." } })
                    </div>
                </div>

                <hr class="text-muted opacity-25 my-4">

                <h6 class="fw-bold text-secondary mb-3 text-uppercase" style="font-size: 0.85rem; letter-spacing: 1px;">3. Cấu hình Endpoints API</h6>
                
                <div class="mb-3">
                    <label class="form-label fw-semibold">API Tạo đơn hàng</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold text-primary" style="width: 70px;">POST</span>
                        @Html.EditorFor(model => model.ApiCreateOrder, new { htmlAttributes = new { @class = "form-control py-2", type="url" } })
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">API Hủy đơn hàng</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold text-danger" style="width: 70px;">POST</span>
                        @Html.EditorFor(model => model.ApiCancelOrder, new { htmlAttributes = new { @class = "form-control py-2", type="url" } })
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">API Kiểm tra trạng thái</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light fw-bold text-success" style="width: 70px;">GET</span>
                        @Html.EditorFor(model => model.ApiCheckStatus, new { htmlAttributes = new { @class = "form-control py-2", type="url" } })
                    </div>
                </div>
            </div>
            <div class="bg-light p-4 rounded-4 mb-4 border border-dashed">
            <label class="form-label fw-bold text-dark d-block mb-3"><i class="fas fa-money-bill-wave me-2 text-success"></i>Thiết lập Gói cước & Giá vận chuyển:</label>
            
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body p-3">
                            <div class="form-check custom-checkbox mb-2">
                                @Html.CheckBoxFor(model => model.SupportStandard, new { @class = "form-check-input", @id = "checkStandard" })
                                <label class="form-check-label fw-semibold text-secondary" for="checkStandard">Giao Chậm</label>
                            </div>
                            <div class="input-group input-group-sm">
                                @Html.EditorFor(model => model.PriceStandard, new { htmlAttributes = new { @class = "form-control", placeholder = "0", type="number" } })
                                <span class="input-group-text fw-semibold text-muted bg-white">đ</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body p-3">
                            <div class="form-check custom-checkbox mb-2">
                                @Html.CheckBoxFor(model => model.SupportFast, new { @class = "form-check-input", @id = "checkFast" })
                                <label class="form-check-label fw-semibold text-primary" for="checkFast">Giao hoa toc</label>
                            </div>
                            <div class="input-group input-group-sm">
                                @Html.EditorFor(model => model.PriceFast, new { htmlAttributes = new { @class = "form-control", placeholder = "0", type="number" } })
                                <span class="input-group-text fw-semibold text-muted bg-white">đ</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-3">
                        <div class="card-body p-3 border-start border-4 border-danger">
                            <div class="form-check custom-checkbox mb-2">
                                @Html.CheckBoxFor(model => model.SupportExpress, new { @class = "form-check-input", @id = "checkExpress" })
                                <label class="form-check-label fw-bold text-danger" for="checkExpress">Nhanh</label>
                            </div>
                            <div class="input-group input-group-sm">
                                @Html.EditorFor(model => model.PriceExpress, new { htmlAttributes = new { @class = "form-control", placeholder = "0", type="number" } })
                                <span class="input-group-text fw-semibold text-muted bg-white">đ</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <small class="text-muted d-block mt-3 px-1"><i class="fas fa-info-circle me-1"></i>Chỉ những gói được tích xanh mới hiển thị cho khách hàng chọn lúc thanh toán.</small>
        </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mb-5">
            <a href="@Url.Action("shippingManagement")" class="btn btn-light text-secondary border rounded-pill px-5 py-2 fw-semibold">Hủy</a>
            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 shadow-sm fw-semibold" style="background: #4f46e5; border: none;">
                <i class="fas fa-check-circle me-2"></i>Lưu thay đổi
            </button>
        </div>
    }
</div>