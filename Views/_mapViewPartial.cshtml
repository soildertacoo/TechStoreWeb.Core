<!-- BẮT ĐẦU: Modal chứa Google Map (Mặc định ẩn) -->
<div id="map-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 9999; backdrop-filter: blur(5px);">
    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #fff; padding: 20px; border-radius: 15px; width: 90%; max-width: 800px; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
        <h4 style="margin-top: 0; color: #2c3e50; font-weight: bold; border-bottom: 2px solid #e9ecef; padding-bottom: 10px;">
            <i class="fas fa-map-pin" style="color: #e74c3c;"></i> Di chuyển ghim để chọn vị trí
        </h4>
        <div id="google-map" style="width: 100%; height: 400px; border-radius: 10px; margin: 15px 0;"></div>
        <p style="font-weight: bold; color: #495057;">Địa chỉ đang chọn: <span id="map-selected-address" style="color: #667eea; font-weight: normal;">Đang tải...</span></p>
        
        <div style="text-align: right; margin-top: 15px;">
            <button type="button" id="btn-close-map" style="padding: 10px 20px; border: none; background: #6c757d; color: white; border-radius: 5px; cursor: pointer; margin-right: 10px;">Đóng</button>
            <button type="button" id="btn-confirm-map" class="enhanced-submit-btn" style="padding: 10px 20px; font-size: 1rem;">Xác nhận vị trí này</button>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        
        // ============================================================
        // PHẦN 2: BẢN ĐỒ OPENSTREETMAP & ĐIỀN FORM THÔNG MINH
        // ============================================================
        let map, marker;
        let selectedPlaceComponents = null;
        const defaultLat = 10.7769; 
        const defaultLng = 106.7009; 

        function initOsmMap() {
            map = L.map('google-map').setView([defaultLat, defaultLng], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);
            marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);

            marker.on('dragend', function (e) {
                const pos = marker.getLatLng();
                geocodePositionOsm(pos.lat, pos.lng);
            });

            map.on('click', function (e) {
                marker.setLatLng(e.latlng);
                geocodePositionOsm(e.latlng.lat, e.latlng.lng);
            });
        }

        async function geocodePositionOsm(lat, lng) {
            document.getElementById('map-selected-address').innerText = "Đang tải địa chỉ...";
            try {
                let api = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&addressdetails=1&accept-language=vi`;
                const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&addressdetails=1&accept-language=vi`);
                const data = await response.json();

                if (data && data.address) {
                    document.getElementById('map-selected-address').innerText = data.display_name;
                    console.log("dữ liệu tả về data.display_name" + api);
                    selectedPlaceComponents = data.address;
                } else {
                    document.getElementById('map-selected-address').innerText = "Không lấy được chi tiết vị trí này.";
                    selectedPlaceComponents = null;
                }
            } catch (error) {
                document.getElementById('map-selected-address').innerText = "Lỗi kết nối bản đồ.";
                selectedPlaceComponents = null;
            }
        }

        const modal = document.getElementById('map-modal');
        let mapInitialized = false;
        
        document.getElementById('btn-open-map').addEventListener('click', function(e) {
            e.preventDefault(); 
            modal.style.display = 'block';
            if (!mapInitialized) {
                initOsmMap();
                geocodePositionOsm(defaultLat, defaultLng);
                mapInitialized = true;
            } else {
                setTimeout(() => { map.invalidateSize(); }, 200);
            }
        });

        document.getElementById('btn-close-map').addEventListener('click', function(e) {
            e.preventDefault(); 
            modal.style.display = 'none';
        });

        // BẤM NÚT XÁC NHẬN - CHỈ DÙNG KHỚP CHÍNH XÁC
        document.getElementById('btn-confirm-map').addEventListener('click', async function(e) {
            e.preventDefault(); 
            
            if (!selectedPlaceComponents) {
                Swal.fire("Thông báo", "Vui lòng chọn một địa chỉ trên bản đồ.", "warning");
                return;
            }

            const c = selectedPlaceComponents;
            
            // 1. Điền Số nhà, đường phố
            let streetNum = c.house_number || '';
            let route = c.road || c.pedestrian || c.footway || '';
            let fullStreet = [];
            if (streetNum) fullStreet.push(streetNum);
            if (route) fullStreet.push(route);
            document.getElementById('StreetAddress').value = fullStreet.join(', ');

            // Gom TẤT CẢ các trường theo cấu trúc Việt Nam
            let cityName = [c.city, c.province, c.state].find(Boolean) || '';
            let wardName  = [c.quarter, c.suburb, c.ward, c.county,c.neighbourhood, c.village, c.hamlet].find(Boolean) || '';

            function forceFill(elementId, valueToFill) {

                let el = document.getElementById(elementId);
                if (!el || !valueToFill) return;
                el.innerHTML = `<option value="${valueToFill}" selected>${valueToFill}</option>`;

                @* if (el.tagName === 'SELECT') {
                    // Nếu là thẻ Dropdown, ta xóa hết tạo 1 thẻ option duy nhất và ép nó chọn
                    el.innerHTML = `<option value="${valueToFill}" selected>${valueToFill}</option>`;
                } else {
                    // Nếu là thẻ Input Text bình thường
                    el.value = valueToFill;
                } *@
            }

            // GỌI HÀM ÉP ĐIỀN DỮ LIỆU
            // Lưu ý: Sửa 'province', 'district', 'ward' cho đúng với ID trong file HTML của bạn
            forceFill('province', cityName);
            forceFill('ward', wardName);

            modal.style.display = 'none';
            Swal.fire({
                title: "Thành công!",
                text: "Đã trích xuất thông tin địa chỉ.",
                icon: "success",
                timer: 1500,
                showConfirmButton: false
            });
        });
    </script>
