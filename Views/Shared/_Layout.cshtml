    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            
            // Lấy các phần tử cần thiết
            const hamburgerBtn = document.getElementById('categoryDropdown');
            const menuDropdown = document.getElementById('categoryDropdownMenu');
            const menuItems = document.querySelectorAll('.dropdown-item');
            const isTabValidated = sessionStorage.getItem("IsTabHuman");
            // Kiểm tra xem có đang đứng ở đúng trang GateKeeper hay không
            const isAtGateKeeper = window.location.pathname.toLowerCase().includes("gatekeeper");
            if (isTabValidated !== "true" && !isAtGateKeeper) {
                window.location.href = '/GateKeeper/turnstileSafeGuard';
            }
            // --- Hàm để đóng menu ---
            function closeMenu() {
                hamburgerBtn.classList.remove('active');
                menuDropdown.classList.remove('show');
            }

            // --- Hàm để mở/đóng menu ---
            function toggleMenu() {
                hamburgerBtn.classList.toggle('active');
                menuDropdown.classList.toggle('show');
            }

            // 1. Sự kiện click vào nút hamburger
            hamburgerBtn.addEventListener('click', function (event) {
                event.stopPropagation();
                toggleMenu();
            });

            // 2. Sự kiện click vào các mục trong menu
            menuItems.forEach(item => {
                item.addEventListener('click', function (e) {
                    this.classList.add('clicked');
                    setTimeout(() => {
                        this.classList.remove('clicked');
                    }, 150);
                    setTimeout(() => {
                        closeMenu();
                    }, 300);
                });
            });

            // 3. Sự kiện click ra ngoài để đóng menu
            document.addEventListener('click', function (event) {
                if (menuDropdown.classList.contains('show') && !hamburgerBtn.contains(event.target) && !menuDropdown.contains(event.target)) {
                    closeMenu();
                }
            });
            //Nhận thông báo 
            const connection = new signalR.HubConnectionBuilder()
                                .withUrl("/notifyHub") 
                                .withAutomaticReconnect() 
                                .build();
    
            connection.on("ReceiveNotification", function (user, room, message,type) {
               
                if (!user.trim() || !message.trim()) {console.log("Lỗi, ko thể set thông báo cho người dùng");return;}
                pushChatNotification(user, message)
                if (type === "banUser") {
                    console.log("Tài khoản này đã bị Ban. Sẽ tự động văng ra sau 5 phút.");

                    // Khởi tạo bộ đếm thời gian 1 phút (1 phút * 60 giây * 1000 mili-giây = 60.000 ms)
                    setTimeout(function () {
                        // Điều hướng người dùng về trang Đăng xuất để xóa Session/Cookie
                        window.location.href = "User/DangXuat"; 

                    }, 60000); 
                }
                
            });
            //Khởi động notifyHub lên, quan trọng 
            connection.start().catch(err => console.error("Lỗi SignalR: ", err));
            connection.onreconnected(() => console.log("Đã kết nối lại thành công!"));

        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let timer = null;
            const id_hold = document.getElementById('idHoldCopy');
            id_hold.addEventListener('mousedown', start)
            id_hold.addEventListener('mouseup', cancel);
            id_hold.addEventListener('mouseleave', cancel);
            function start() {
                timer = setTimeout(() => {
                    window.location.href = '@Url.Action("Index","Admins")'
                }, 1000);
            }
            function cancel() {
                if (timer) {
                    clearTimeout(timer);
                    timer = null;
                }
            }
        });
    </script>
    <script>
        function pushChatNotification(senderName, message, avatarUrl) {
            const container = document.getElementById('toast-stack-container');
            // 1. Tạo một thẻ <div> mới
            const card = document.createElement('div');
            card.className = 'chat-toast-card';
            
            // Nếu không truyền avatar thì xài ảnh mặc định
            const imgUrl = avatarUrl || 'https://cdn-icons-png.flaticon.com/512/149/149071.png';

            // 2. Nhồi HTML vào trong tấm thẻ
            card.innerHTML = `
                <div class="toast-content">
                    <div class="toast-name">${senderName}</div>
                    <div class="toast-msg">${message}</div>
                </div>
                <button class="toast-close" onclick="removeToast(this.parentElement)">&times;</button>
            `;
            
            // 3. Nhét thẻ vào đầu rổ (prepend để thẻ mới nhất luôn nằm trên cùng)
            container.prepend(card);
            
            // 4.  CSS kích hoạt hiệu ứng văng ra
            requestAnimationFrame(() => {
                setTimeout(() => {
                    card.classList.add('show');
                }, 10);
            });
            
            // 5. Cài đặt đồng hồ cát: Tự động xóa thẻ sau 5 giây
            setTimeout(() => {
                if (container.contains(card)) {
                    removeToast(card);
                }
            }, 10000);
        }

        // HÀM XÓA THẺ (Kèm hiệu ứng thu gọn mượt mà)
        function removeToast(card) {
            card.classList.remove('show');
            card.classList.add('hide'); 
            
            // Chờ 0.4s cho hiệu ứng bay ra hoàn tất rồi mới chém bỏ thẻ HTML
            setTimeout(() => {
                card.remove();
            }, 400); 
        }

    </script>
