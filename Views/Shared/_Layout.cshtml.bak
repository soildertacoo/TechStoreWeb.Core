@using Microsoft.AspNetCore.Http
@using System.Diagnostics.Eventing.Reader
@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title | TechStoreVN</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/Site.css" asp-append-version="true" />
   <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --accent-gradient: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            --danger-gradient: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
            --success-gradient: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
            --warning-gradient: linear-gradient(135deg, #ffeaa7 0%, #fdcb6e 100%);
            --glass-bg: rgba(255, 255, 255, 0.08);
            --glass-border: rgba(255, 255, 255, 0.12);
            --text-primary: #ffffff;
            --text-secondary: #b3b3b3;
            --text-accent: #00d4ff;
            --bg-color: #ffffff;
            --text-color: #333333;
        }
        html[data-theme="dark"] body {
            background-color: #1a202c ; /* Đen nhạt */
            color: #e2e8f0 !important; /* Chữ trắng */
        }

        /* Đổi luôn màu mấy cái thẻ Div màu trắng (Ví dụ form đăng nhập) */
        html[data-theme="dark"] .container,
        html[data-theme="dark"] .otp-card,
        html[data-theme="dark"] .settings-modal,
        html[data-theme="dark"] .profile-card, html[data-theme="dark"] .settings-sidebar,
        html[data-theme="dark"] .tab-pane.active,html[data-theme="dark"] .setting-row
        {
            background-color: #2d3748 !important;
            color: #ffffff !important;
        }

        /* Đổi màu mấy ô nhập liệu cho ngầu */
        html[data-theme="dark"] .form-control {
            background-color: #1a202c !important;
            color: white !important;
            border-color: #4a5568 !important;
        }
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            overflow-x: hidden;
            position: relative;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        /* Enhanced animated background */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background:
                radial-gradient(circle at 20% 50%, rgba(102, 126, 234, 0.15) 0%, transparent 70%),
                radial-gradient(circle at 80% 20%, rgba(118, 75, 162, 0.12) 0%, transparent 70%),
                radial-gradient(circle at 40% 80%, rgba(0, 212, 255, 0.1) 0%, transparent 70%),
                radial-gradient(circle at 60% 30%, rgba(245, 87, 108, 0.08) 0%, transparent 70%);
            animation: backgroundShift 20s ease-in-out infinite;
            pointer-events: none;
            z-index: -2;
        }

        @@keyframes backgroundShift {
            0%, 100% { transform: scale(1) rotate(0deg); }
            33% { transform: scale(1.1) rotate(1deg); }
            66% { transform: scale(0.95) rotate(-1deg); }
        }

        /* Enhanced Navbar Styles */
/*        .navbar {
            background: rgba(10, 10, 10, 0.95) !important;
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--glass-border);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            padding: 0.8rem 0;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }*/
        .navbar {
            background: rgba(255, 255, 255, 0.2) !important; /* Lighten background for higher translucency */
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-bottom: 1px solid var(--glass-border);
            transition: all 0.4s ease;
            padding: 0.8rem 0;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }

        .navbar.scrolled {
            background: rgba(5, 5, 5, 0.98) !important;
            border-bottom-color: var(--text-accent);
            box-shadow: 0 8px 40px rgba(0, 212, 255, 0.1);
        }

        /* Custom navbar layout */
        .navbar .container-fluid {
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
        }

        /* Left section - Category menu + Logo */
        .navbar-left {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        /* Category Menu Button */
        .category-menu-btn {
            background: rgba(255, 255, 255, 0.2) !important; /* Lighten background for higher translucency */
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid var(--glass-border);
            color: var(--text-primary);
            border-radius: 12px;
            padding: 0.8rem 1rem;
            font-weight: 500;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            position: relative;
            overflow: hidden;
        }

        .category-menu-btn:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: var(--text-accent);
            color: var(--text-accent);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 212, 255, 0.3);
        }

        /* Hamburger icon animation */
        .hamburger-icon {
            display: flex;
            flex-direction: column;
            gap: 3px;
            transition: all 0.3s ease;
        }

        .hamburger-line {
            width: 20px;
            height: 2px;
            background: currentColor;
            border-radius: 2px;
            transition: all 0.3s ease;
        }

        /* Active state for hamburger */
        .category-menu-btn.active .hamburger-line:nth-child(1) {
            transform: rotate(45deg) translate(5px, 5px);
        }

        .category-menu-btn.active .hamburger-line:nth-child(2) {
            opacity: 0;
        }

        .category-menu-btn.active .hamburger-line:nth-child(3) {
            transform: rotate(-45deg) translate(7px, -6px);
        }

        /* Logo (Next to hamburger) */
        .navbar-brand {
            font-family: 'JetBrains Mono', monospace;
            font-size: 2rem;
            font-weight: 700;
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            text-shadow: 0 0 30px rgba(0, 212, 255, 0.6);
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            text-decoration: none;
            position: static; /* Changed from absolute positioning */
        }

        .navbar-brand:hover {
            transform: scale(1.05);
            filter: brightness(1.2);
        }

        .navbar-brand .brand-icon {
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            margin-right: 0.5rem;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.1); }
        }

        /* Right section (Search + User Actions) */
        .navbar-right {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        /* Enhanced Dropdown Styles */
        .dropdown-menu {
            background: rgba(255, 255, 255, 0.2) !important;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 0.8rem 0;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            margin-top: 0.5rem;
            min-width: 220px;
            opacity: 0;
            transform: translateY(-10px) scale(0.95);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            pointer-events: none;
        }

        .dropdown-menu.show {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: all;
        }

        .dropdown-item {
            color: var(--text-primary) !important;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            padding: 0.8rem 1rem;
            border-radius: 12px;
            margin: 0.2rem 0;
            display: flex;
            align-items: center;
            font-weight: 500;
        }

        .dropdown-item:hover {
            background: var(--glass-bg);
            color: var(--text-accent) !important;
            transform: translateX(8px) scale(1.02);
            box-shadow: 0 4px 20px rgba(0, 212, 255, 0.2);
        }

        .dropdown-item i {
            width: 20px;
            margin-right: 0.5rem;
            transition: all 0.3s ease;
        }

        .dropdown-item:hover i {
            color: var(--text-accent);
            transform: scale(1.2);
        }

        /* Enhanced Search Container */
        .search-container {
            position: relative;
        }

        .search-form {
            display: flex;
            align-items: center;
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            border-radius: 25px;
            padding: 0.2rem;
            transition: all 0.3s ease;
            overflow: hidden;
        }

        .search-form:hover,
        .search-form:focus-within {
            border-color: var(--text-accent);
            box-shadow: 0 0 25px rgba(0, 212, 255, 0.3);
            background: rgba(255, 255, 255, 0.12);
        }

        .search-form input {
            background: transparent;
            border: none;
            color: var(--text-primary);
            padding: 0.8rem 1rem;
            font-size: 0.95rem;
            width: 280px;
            transition: all 0.3s ease;
        }

        .search-form input:focus {
            outline: none;
            width: 320px;
        }

        .search-form input::placeholder {
            color: var(--text-secondary);
        }

        .search-btn {
            background: var(--accent-gradient);
            border: none;
            border-radius: 20px;
            padding: 0.8rem 1.2rem;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .search-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 15px rgba(0, 212, 255, 0.4);
        }

        /* Enhanced User Actions */
        .user-actions {
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .user-btn {
            background: var(--glass-bg);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid var(--glass-border);
            color: var(--text-primary);
            border-radius: 20px;
            padding: 0.7rem 1.2rem;
            font-weight: 500;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            position: relative;
            overflow: hidden;
        }

        .user-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: var(--accent-gradient);
            transition: left 0.5s ease;
            z-index: -1;
        }

        .user-btn:hover::before {
            left: 0; 
        }

        .user-btn:hover {
            color: white !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 212, 255, 0.3);
            border-color: transparent;
        }

        /* Enhanced Footer */
        footer {
            background: linear-gradient(135deg, rgba(10, 10, 10, 0.98) 0%, rgba(15, 15, 15, 0.98) 100%);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border-top: 1px solid var(--glass-border);
            margin-top: 100px;
            position: relative;
            overflow: hidden;
        }

        footer::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background:
                radial-gradient(circle at 20% 20%, rgba(102, 126, 234, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(0, 212, 255, 0.08) 0%, transparent 50%);
            pointer-events: none;
            z-index: -1;
        }

        .footer-section h4 {
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 700;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 1.3rem;
        }

        .footer-section p {
            color: var(--text-secondary);
            margin-bottom: 0.8rem;
            line-height: 1.8;
        }

        .footer-section a {
            color: var(--text-accent);
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .footer-section a:hover {
            color: #8b5cf6;
            text-shadow: 0 0 10px rgba(139, 92, 246, 0.5);
            transform: translateX(5px);
        }

        /* Enhanced Social Icons */
        .social-icons {
            display: flex;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .social-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 55px;
            height: 55px;
            border-radius: 50%;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-decoration: none;
        }

        .social-icon::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            transition: all 0.3s ease;
            z-index: -1;
        }

        .social-icon i {
            font-size: 22px;
            color: white;
            z-index: 1;
            transition: all 0.3s ease;
        }

        .social-icon:hover {
            transform: translateY(-8px) scale(1.15);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .social-facebook::before { background: linear-gradient(135deg, #3B5998, #4c6ef5); }
        .social-youtube::before { background: linear-gradient(135deg, #bb0000, #ff3333); }
        .social-instagram::before { background: linear-gradient(135deg, #125688, #e4405f); }

        /* Quick Links Enhancement */
        .quick-links {
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .quick-link {
            background: var(--glass-bg);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 1rem;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 0.8rem;
        }

        .quick-link:hover {
            background: rgba(255, 255, 255, 0.12);
            border-color: var(--text-accent);
            transform: translateX(8px);
            box-shadow: 0 8px 25px rgba(0, 212, 255, 0.2);
            color: var(--text-accent);
        }

        .quick-link i {
            width: 20px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .quick-link:hover i {
            transform: scale(1.2);
            color: var(--text-accent);
        }

        /* Footer Bottom */
        .footer-bottom {
            border-top: 1px solid var(--glass-border);
            margin-top: 3rem;
            padding-top: 2rem;
            text-align: center;
        }

        .footer-bottom p {
            color: var(--text-secondary);
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .footer-bottom .powered-by {
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 600;
        }

        /* Enhanced Scrollbar */
        ::-webkit-scrollbar {
            width: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #0a0a0a;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--accent-gradient);
            border-radius: 5px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: var(--primary-gradient);
        }

        /* Responsive Design */
        @@media (max-width: 768px) {
            .navbar-brand {
                font-size: 1.5rem;
            }

            .navbar .container-fluid {
                flex-direction: column;
                gap: 1rem;
            }

            .navbar-left {
                align-self: flex-start;
            }

            .navbar-right {
                width: 100%;
                justify-content: center;
                flex-wrap: wrap;
            }

            .search-form input {
                width: 200px;
            }

            .search-form input:focus {
                width: 220px;
            }

            .social-icons {
                justify-content: center;
            }

            .social-icon {
                width: 45px;
                height: 45px;
            }

            .user-actions {
                flex-direction: column;
                gap: 0.5rem;
                width: 100%;
                margin-top: 1rem;
            }

            .user-btn {
                justify-content: center;
                width: 100%;
            }
        }

        /* Main Content */
        .main-content {
            position: relative;
            z-index: 1;
            min-height: calc(100vh - 200px);
        }

        /* Enhanced Animations */
        .animate-fade-in {
            animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-slide-in {
            animation: slideInRight 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @@keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        #toast-stack-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column; 
            width: 340px;
            pointer-events: none;
        }

        /* 2. GIAO DIỆN TỪNG TẤM THẺ (Card) */
        .chat-toast-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-left: 5px solid #667eea;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
            display: flex;
            align-items: flex-start;
            gap: 15px;
            pointer-events: auto;
            overflow: hidden; /* Cực kỳ quan trọng để cắt gọt phần thừa khi thẻ bị xẹp */
            
            /* TRẠNG THÁI BỊ ẨN (Nằm tít ở trên và bị xẹp lép) */
            transform: translateY(-60px) scale(0.9); /* Nằm cao hơn 60px và hơi nhỏ một chút */
            opacity: 0;
            max-height: 0;       /* Chiều cao bằng 0 */
            padding: 0 16px;     /* Bóp nghẹt padding dọc */
            margin-bottom: 0;    /* Không có khoảng cách với thẻ dưới */
            border-left-width: 0;
            
            /* Animation: Nảy, trượt và nở ra cùng lúc */
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        /* 3. TRẠNG THÁI HIỂN THỊ (Rơi xuống & Nở ra) */
        .chat-toast-card.show {
            transform: translateY(0) scale(1); /* Rơi về vị trí chuẩn, to ra bình thường */
            opacity: 1;
            max-height: 150px;   /* Nở chiều cao ra để chứa nội dung */
            padding: 16px;       /* Phục hồi đệm dọc */
            margin-bottom: 12px; /* Tạo khoảng cách để đẩy thẻ cũ xuống 12px */
            border-left-width: 5px;
        }

        /* 4. TRẠNG THÁI BIẾN MẤT (Trượt sang phải và Bay màu) */
        /* Khi hết 5 giây hoặc khách bấm nút X, nó sẽ trượt ngang để biến mất cho lãng mạn */
        .chat-toast-card.hide {
            transform: translateX(120%); /* Trượt sang mép phải màn hình */
            opacity: 0;
            max-height: 0;
            padding: 0 16px;
            margin-bottom: 0; /* Hút các thẻ bên dưới trượt lên lấp chỗ trống */
            border-width: 0;
            transition: all 0.4s ease; /* Chuyển động biến mất mượt mà hơn */
        }

        /* --- TRANG TRÍ NỘI DUNG BÊN TRONG (Giữ nguyên) --- */
        .toast-avatar { width: 45px; height: 45px; border-radius: 50%; object-fit: cover; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .toast-content { flex: 1; min-width: 0; }
        .toast-name { font-weight: bold; color: #2c3e50; font-size: 0.95rem; margin-bottom: 3px; }
        .toast-msg { color: #6c757d; font-size: 0.85rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .toast-close { background: none; border: none; color: #adb5bd; font-size: 1.2rem; cursor: pointer; line-height: 1; transition: 0.2s; }
        .toast-close:hover { color: #e74c3c; }`
    </style>
    <script>
        const currentTheme = localStorage.getItem("theme");
        if (currentTheme === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
        }
    </script>
    @if(User.Identity.IsAuthenticated){
        @if (User.HasClaim("TrangThaiAnalytic","True")){
            <!-- Google tag (gtag.js), theo dõi luồng dữ liệu web -->
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-5BTV4J7VBN"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-5BTV4J7VBN');
            console.log("Đã mở Google Analytic");
        </script>
        }
    }
</head>

<body >
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
        <div class="container-fluid px-4">
            <div class="navbar-left">
                <div class="dropdown">
                    <button class="category-menu-btn" type="button" id="categoryDropdown">
