<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - TechStoreVN</title>

    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" />
    
    <style>
        /* 1. Thiết lập chung */
        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #f4f7fc; /* Màu nền xám xanh nhạt, dịu mắt */
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* 2. Style cho Navbar Header */
        .navbar-custom {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); /* Màu tím hiện đại */
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.2);
            padding: 0.8rem 1rem;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-custom .navbar-brand {
            font-weight: 700;
            color: #ffffff;
            font-size: 1.25rem;
            letter-spacing: 0.5px;
        }

        /* 3. Style cho các Link trong Menu */
        .navbar-custom .nav-link {
            color: rgba(255, 255, 255, 0.85); /* Chữ trắng hơi mờ */
            font-weight: 500;
            font-size: 0.9rem;
            padding: 0.5rem 0.9rem;
            margin: 0 0.2rem;
            border-radius: 8px; /* Bo góc dạng nút mềm */
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 6px; /* Khoảng cách giữa icon và chữ */
        }

        .navbar-custom .nav-link i {
            font-size: 1rem;
            width: 18px;
            text-align: center;
        }

        /* Hiệu ứng khi Hover vào Menu */
        .navbar-custom .nav-link:hover, 
        .navbar-custom .nav-item.active .nav-link {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.15); /* Nền sáng lên một chút */
            transform: translateY(-1px);
        }

        /* 4. Style cho Nút Toggle trên Mobile */
        .navbar-toggler {
            border: 1px solid rgba(255, 255, 255, 0.3);
            outline: none !important;
        }
        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg viewBox='0 0 30 30' xmlns='http://www.w3.org/2000/svg'%3e%3cpath stroke='rgba(255, 255, 255, 0.9)' stroke-width='2' stroke-linecap='round' stroke-miterlimit='10' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        /* 5. Vùng chứa nội dung chính (RenderBody) */
        .main-wrapper {
            flex: 1;
            padding-bottom: 40px;
        }

        .content-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 30px;
            margin-top: 30px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.03); /* Bóng đổ siêu mịn */
            border: 1px solid rgba(0,0,0,0.04);
            min-height: calc(100vh - 160px); /* Đảm bảo form luôn dài xuống dưới */
        }

        /* Responsive: Chỉnh lại layout menu trên điện thoại */
        @@media (max-width: 991px) {
            .navbar-custom .nav-link {
                margin: 5px 0;
                padding: 10px 15px;
                justify-content: flex-start;
            }
        }
    </style>

</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container-fluid px-lg-4">
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Statistics", "Admins")">
                <i class="fas fa-cogs mr-2"></i> TechStore Admin
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ml-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Statistics","Admins")"><i class="fas fa-chart-line"></i> Thống kê</a>
                    </li>
                    
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Products")"><i class="fas fa-box-open"></i> Sản phẩm</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Category")"><i class="fas fa-tags"></i> Danh mục</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("shippingManagement","Admins")"><i class="fas fa-box-open"></i> QL DVVC</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","OrderPro")"><i class="fas fa-shopping-cart"></i> Đơn hàng</a>
                    </li>
                     <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Inventory")"><i class="fas fa-warehouse"></i> Tồn kho</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Banners","Advertising")"><i class="fas fa-ad"></i> Quảng cáo</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Promotions")"><i class="fas fa-bullhorn"></i> Khuyến mãi</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Reviews")"><i class="fas fa-star"></i> Đánh giá</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("SupportRequestManagement", "Admins")"><i class="fas fa-headset"></i> Hỗ trợ</a>
                    </li>
                    <li class="nav-item border-left border-light ml-2 pl-2 d-none d-lg-block"></li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index","Home")"><i class="fas fa-store"></i> Xem Cửa Hàng</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-lg-4 main-wrapper">
        <main role="main" class="content-card">
            @RenderBody()
        </main>
    </div>
    @await Html.PartialAsync(partialViewName: "~/Views/_ChatAdminPartial.cshtml")
    <script src="https://code.jquery.com/jquery-3.3.1.slim.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.7/umd/popper.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/js/bootstrap.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let currentRoom = '';
        });
        // Thêm chữ 'async' vào đầu hàm
        async function sendNotify(sender, receiver, msg, type) {
            // 1. Khởi tạo
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/notifyHub") 
                .withAutomaticReconnect() 
                .build();
                
            // Kiểm tra dữ liệu đầu vào
            if (!sender.trim() || !receiver.trim() || !msg.trim()) {
                console.log("Lỗi: Dữ liệu rỗng, không gửi thông báo được");
                return;
            }

            try {
             
                await connection.start();
                console.log("Đã kết nối thành công tới NotifyHub để gửi thông báo!");

                // 3. Sau khi kết nối xong mới gọi invoke
                await connection.invoke("JoinNotifyHub", receiver);
                await connection.invoke("sendNotify", sender, receiver, msg, type);
                
                console.log("Đã gửi thông báo thành công!");

            } catch (err) {
                console.error("Lỗi SignalR khi gửi thông báo: ", err);
            }
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>