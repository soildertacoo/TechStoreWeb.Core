@model TechStore.Models.RelatedPro
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int numReview = 0;
    decimal avg = 0;
    string? currentCustomerId = User.Identity.IsAuthenticated ? User.Identity.Name : null;

    if (Model != null && Model.Products != null)
    {
        numReview = (Model.RelatedReviews != null) ? Model.RelatedReviews.Count() : 0;
        avg = numReview > 0 ? Model.RelatedReviews.Average(a => a.Rating) : 0;
    }
}
@functions{
    private int getStarCount(double min, int max, int numReview){
        return numReview > 0 && Model != null && Model.RelatedReviews != null
            ? Model.RelatedReviews.Count(s => s.Rating > (decimal)min && s.Rating <= max) : 0;
    }
    private double getLineCount(double min, int max, int numReview){
        return numReview > 0 && Model != null && Model.RelatedReviews != null
            ? Model.RelatedReviews.Count(s => s.Rating > (decimal)min && s.Rating <= max) / (double)numReview * 100 : 0;
    }
}

@if (Model == null || Model.Products == null)
{
    <div class="container text-center py-5 mt-5" style="min-height:50vh;">
        <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="#cbd5e1" class="bi bi-box-seam mb-4" viewBox="0 0 16 16">
            <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.958l-7.15 2.85a1.5 1.5 0 0 1-1.114 0l-7.149-2.85A1 1 0 0 1 0 12.162V3.5a.5.5 0 0 1 .316-.464L7.443.184z"/>
        </svg>
        <h2 class="fw-semibold text-danger mb-2">Không tìm thấy sản phẩm</h2>
        <p class="text-muted">Sản phẩm này không tồn tại hoặc đã bị xóa.</p>
        <a href="@Url.Action("Index","Home")" class="btn btn-primary px-4 rounded-pill mt-2">
            <i class="fas fa-arrow-left me-2"></i>Quay lại trang chủ
        </a>
    </div>
}
else
{
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>

<style>
/* ── Reset & base ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body { font-family: 'Inter', sans-serif; }

/* ── Page wrap ── */
.dp-wrap {
    background: #f5f6f8;
    min-height: 80vh;
    padding: 0 0 80px;
}

.dp-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* ── Breadcrumb ── */
.dp-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 20px 0 24px;
    font-size: 13px;
    color: #9ca3af;
}
.dp-breadcrumb a {
    color: #9ca3af;
    text-decoration: none;
    transition: color .2s;
}
.dp-breadcrumb a:hover { color: #374151; }
.dp-breadcrumb .sep { opacity: .5; font-size: 11px; }
.dp-breadcrumb .current { color: #374151; font-weight: 500; }

/* ── Main card ── */
.dp-main {
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid #e5e7eb;
    margin-bottom: 24px;
}

/* ── Gallery ── */
.dp-gallery {
    position: relative;
    background: #fafafa;
    border-right: 1px solid #f0f0f0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: 32px 32px 20px; /* Giảm padding top/bottom để chừa không gian cho ảnh to ra */
    min-height: 520px;
}

.dp-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .3px;
    z-index: 2;
}
.dp-badge.hot { background: #fff0f0; color: #dc2626; border: 1px solid #fecaca; }
.dp-badge.sale { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }

/* Full-frame image: fills the gallery area */
.dp-img-wrap {
    width: 100%;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
    margin-top: 30px; /* Đẩy nhẹ ảnh xuống để không đụng vào badge */
}
.dp-img-wrap img {
    width: 100%;
    height: 100%;
    max-height: 480px; /* Tăng giới hạn chiều cao từ 400px lên 480px giúp ảnh to rõ hơn */
    object-fit: contain;
    transition: transform .5s cubic-bezier(.25,.46,.45,.94);
    display: block;
}
.dp-gallery:hover .dp-img-wrap img {
    transform: scale(1.04);
}

/* Thumbnail strip */
.dp-thumbs {
    display: flex;
    gap: 8px;
    margin-top: 20px;
    justify-content: center;
}
.dp-thumb {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    border: 2px solid #e5e7eb;
    overflow: hidden;
    cursor: pointer;
    transition: border-color .2s;
    background: #fff;
    padding: 4px;
}
.dp-thumb.active,
.dp-thumb:hover { border-color: #374151; }
.dp-thumb img { width: 100%; height: 100%; object-fit: contain; }

/* ── Buy box ── */
.dp-info {
    padding: 44px 48px 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
}

/* Status chips */
.dp-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}
.dp-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    border: 1px solid transparent;
}
.dp-chip.star   { background: #fffbeb; color: #92400e; border-color: #fde68a; }
.dp-chip.stock  { background: #f0fdf4; color: #166534; border-color: #bbf7d0; }
.dp-chip.nostock{ background: #fef2f2; color: #991b1b; border-color: #fecaca; }
.dp-chip.auth   { background: #eff6ff; color: #1e40af; border-color: #bfdbfe; }

/* Title */
.dp-title {
    font-size: 26px;
    font-weight: 600;
    color: #111827;
    line-height: 1.3;
    letter-spacing: -.4px;
}

/* Price block */
.dp-price-wrap {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 20px 24px;
}
.dp-price {
    font-size: 32px;
    font-weight: 600;
    color: #dc2626;
    letter-spacing: -.5px;
    line-height: 1;
}
.dp-price-note {
    font-size: 12px;
    color: #9ca3af;
    margin-top: 6px;
}

/* Delivery estimate */
.dp-delivery {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #374151;
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    border-radius: 10px;
    padding: 12px 16px;
}
.dp-delivery i { color: #16a34a; font-size: 14px; }
.dp-delivery strong { font-weight: 600; }

/* Trust row */
.dp-trust {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
}
.dp-trust-item {
    text-align: center;
    padding: 14px 8px;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    transition: border-color .2s;
}
.dp-trust-item:hover { border-color: #9ca3af; }
.dp-trust-item i {
    font-size: 18px;
    color: #374151;
    display: block;
    margin-bottom: 6px;
}
.dp-trust-item span {
    font-size: 11px;
    color: #6b7280;
    font-weight: 500;
    display: block;
    line-height: 1.4;
}

/* Description */
.dp-desc-label {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #9ca3af;
    margin-bottom: 10px;
}
.dp-desc-body {
    font-size: 14px;
    color: #4b5563;
    line-height: 1.75;
    max-height: 130px;
    overflow-y: auto;
    padding-right: 8px;
    scrollbar-width: thin;
    scrollbar-color: #d1d5db transparent;
}
.dp-desc-body::-webkit-scrollbar { width: 4px; }
.dp-desc-body::-webkit-scrollbar-thumb { background: #d1d5db; border-radius: 4px; }

/* Quantity + actions */
.dp-purchase {
    margin-top: auto;
    border-top: 1px solid #f3f4f6;
    padding-top: 20px;
}
.dp-purchase-row {
    display: flex;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 16px;
    flex-wrap: wrap;
}
.dp-qty-label {
    font-size: 12px;
    font-weight: 500;
    color: #6b7280;
    margin-bottom: 8px;
    display: block;
}
.dp-stepper {
    display: inline-flex;
    align-items: center;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
}
.dp-stepper button {
    width: 40px;
    height: 40px;
    border: none;
    background: transparent;
    color: #374151;
    font-size: 18px;
    font-weight: 400;
    cursor: pointer;
    transition: background .15s;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
}
.dp-stepper button:hover:not(:disabled) { background: #e5e7eb; }
.dp-stepper button:disabled { opacity: .35; cursor: not-allowed; }
.dp-stepper input {
    width: 52px;
    height: 40px;
    border: none;
    border-left: 1px solid #e5e7eb;
    border-right: 1px solid #e5e7eb;
    text-align: center;
    font-size: 15px;
    font-weight: 500;
    color: #111827;
    background: #fff;
}
.dp-stepper input:focus { outline: none; }

.dp-stock-tag {
    font-size: 12px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
}
.dp-stock-tag.ok  { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
.dp-stock-tag.out { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

/* Action buttons */
.dp-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

.dp-btn {
    padding: 14px 20px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    border: none;
    transition: all .2s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
}
.dp-btn-primary {
    background: #111827;
    color: #fff;
    grid-column: span 2;
    font-size: 15px;
    padding: 16px;
}
.dp-btn-primary:hover:not(:disabled) {
    background: #1f2937;
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0,0,0,.2);
}
.dp-btn-primary:disabled { opacity: .45; cursor: not-allowed; }

.dp-btn-secondary {
    background: #f9fafb;
    color: #374151;
    border: 1px solid #e5e7eb;
}
.dp-btn-secondary:hover:not(:disabled) {
    background: #f3f4f6;
    border-color: #9ca3af;
    color: #111827;
}
.dp-btn-secondary:disabled { opacity: .45; cursor: not-allowed; }

/* ── Feature strip ── */
.dp-features {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    overflow: hidden;
    margin-bottom: 24px;
}
.dp-feature {
    padding: 24px 20px;
    text-align: center;
    border-right: 1px solid #f0f0f0;
    transition: background .2s;
}
.dp-feature:last-child { border-right: none; }
.dp-feature:hover { background: #f9fafb; }
.dp-feature i {
    font-size: 20px;
    color: #374151;
    display: block;
    margin-bottom: 10px;
}
.dp-feature strong {
    font-size: 13px;
    font-weight: 600;
    color: #111827;
    display: block;
    margin-bottom: 4px;
}
.dp-feature span { font-size: 12px; color: #9ca3af; }

/* ── Review section ── */
.dp-reviews {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    padding: 48px;
    margin-bottom: 24px;
}

.dp-section-title {
    font-size: 18px;
    font-weight: 600;
    color: #111827;
    margin-bottom: 28px;
    display: flex;
    align-items: center;
    gap: 10px;
}
.dp-section-title i { color: #374151; font-size: 16px; }

.dp-review-stats {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 40px;
    margin-bottom: 40px;
    padding: 28px;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
}

.dp-rating-big {
    text-align: center;
    padding: 24px 20px;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
}
.dp-rating-num {
    font-size: 48px;
    font-weight: 600;
    color: #111827;
    line-height: 1;
    letter-spacing: -2px;
}
.dp-rating-stars { margin: 10px 0; }
.dp-rating-stars i { color: #f59e0b; font-size: 14px; }
.dp-rating-count { font-size: 12px; color: #9ca3af; }

.dp-bar-row { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
.dp-bar-label { font-size: 12px; color: #6b7280; min-width: 44px; font-weight: 500; }
.dp-bar-track { flex: 1; height: 6px; background: #f3f4f6; border-radius: 3px; overflow: hidden; }
.dp-bar-fill { height: 100%; background: #f59e0b; border-radius: 3px; transition: width 1s ease; }
.dp-bar-count { font-size: 12px; color: #9ca3af; min-width: 24px; text-align: right; }

/* Write review */
.dp-write-review {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 28px;
    margin-bottom: 32px;
    position: relative;
}
.dp-write-title { font-size: 15px; font-weight: 600; color: #111827; margin-bottom: 20px; }

.dp-star-input { display: flex; gap: 6px; }
.dp-star-input i {
    font-size: 24px;
    color: #d1d5db;
    cursor: pointer;
    transition: color .2s, transform .15s;
}
.dp-star-input i:hover,
.dp-star-input i.active { color: #f59e0b; transform: scale(1.1); }

.dp-form-input {
    width: 100%;
    padding: 12px 16px;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    font-size: 14px;
    color: #374151;
    background: #fff;
    font-family: 'Inter', sans-serif;
    resize: vertical;
    transition: border-color .2s, box-shadow .2s;
}
.dp-form-input:focus {
    outline: none;
    border-color: #9ca3af;
    box-shadow: 0 0 0 3px rgba(156,163,175,.15);
}

/* Review items */
.dp-review-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; }
.dp-review-badge {
    font-size: 12px;
    font-weight: 500;
    color: #6b7280;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    padding: 4px 12px;
    border-radius: 6px;
}

.dp-review-item {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 24px;
    margin-bottom: 14px;
    transition: border-color .2s, box-shadow .2s;
}
.dp-review-item:hover {
    border-color: #d1d5db;
    box-shadow: 0 2px 8px rgba(0,0,0,.06);
}

.dp-reviewer-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #374151;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.dp-review-name { font-size: 14px; font-weight: 500; color: #111827; }
.dp-review-meta { font-size: 12px; color: #9ca3af; margin-top: 2px; }
.dp-review-text { font-size: 14px; color: #4b5563; line-height: 1.7; margin-top: 14px; }
.dp-review-stars i { font-size: 13px; color: #f59e0b; }

.dp-review-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; padding-top: 14px; border-top: 1px solid #f3f4f6; }
.dp-review-action-btn {
    font-size: 12px;
    font-weight: 500;
    padding: 6px 14px;
    border-radius: 7px;
    border: 1px solid #e5e7eb;
    background: #f9fafb;
    color: #6b7280;
    cursor: pointer;
    transition: all .2s;
    display: flex;
    align-items: center;
    gap: 5px;
}
.dp-review-action-btn.edit:hover { background: #eff6ff; border-color: #bfdbfe; color: #2563eb; }
.dp-review-action-btn.delete:hover { background: #fef2f2; border-color: #fecaca; color: #dc2626; }

.dp-review-empty {
    text-align: center;
    padding: 48px 24px;
    background: #f9fafb;
    border: 1px dashed #d1d5db;
    border-radius: 14px;
}
.dp-review-empty i { font-size: 32px; color: #d1d5db; display: block; margin-bottom: 12px; }
.dp-review-empty p { font-size: 14px; color: #9ca3af; margin-top: 6px; }

.review-hidden { display: none !important; }
.show-animation { animation: fadeSlide .4s ease; }
@@keyframes fadeSlide { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }

/* ── Load more ── */
#loadMoreBtn, #showLessBtn {
    font-size: 13px;
    font-weight: 500;
    padding: 10px 28px;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
    background: #fff;
    color: #374151;
    cursor: pointer;
    transition: all .2s;
}
#loadMoreBtn:hover, #showLessBtn:hover {
    background: #f3f4f6;
    border-color: #9ca3af;
}

/* ── Responsive ── */
@@media (max-width: 991px) {
    .dp-main { grid-template-columns: 1fr; }
    .dp-gallery { border-right: none; border-bottom: 1px solid #f0f0f0; min-height: 360px; padding: 36px 28px 24px; }
    .dp-info { padding: 32px 28px; }
    .dp-review-stats { grid-template-columns: 1fr; }
    .dp-features { grid-template-columns: repeat(2, 1fr); }
    .dp-feature:nth-child(2) { border-right: none; }
}
@@media (max-width: 600px) {
    .dp-trust { grid-template-columns: 1fr 1fr; }
    .dp-features { grid-template-columns: 1fr; }
    .dp-feature { border-right: none; border-bottom: 1px solid #f0f0f0; }
    .dp-feature:last-child { border-bottom: none; }
    .dp-actions { grid-template-columns: 1fr; }
    .dp-btn-primary { grid-column: span 1; }
    .dp-reviews { padding: 28px 20px; }
    .dp-info { padding: 24px 20px; }
    .dp-gallery { padding: 28px 16px 20px; }
}
</style>

<div class="dp-wrap">
    <div class="dp-container">

        @using (Html.BeginForm("AddToShowCart", "Cart", FormMethod.Post))
        {
            @Html.Hidden("id", Model.Products.ProductID)
            var inStock = Model.StockQuantity > 0;

            <nav class="dp-breadcrumb">
                <a href="@Url.Action("Index","Home")"><i class="fas fa-home" style="font-size:11px;"></i> Trang chủ</a>
                <span class="sep">›</span>
                <a href="@Url.Action("Index","Home")#ts-products">Sản phẩm</a>
                <span class="sep">›</span>
                <span class="current">@Model.Products.NamePro</span>
            </nav>

            <div class="dp-main">
                <!-- Gallery -->
                <div class="dp-gallery">
                    @if (Model.Products.Discount.HasValue && Model.Products.Discount > 0)
                    {
                        <span class="dp-badge sale"><i class="fas fa-tag me-1"></i>-@Model.Products.Discount%</span>
                    }
                    else
                    {
                        <span class="dp-badge hot"><i class="fas fa-fire me-1"></i>Nổi bật</span>
                    }
                    <div class="dp-img-wrap">
                        <img src="~/Images/@Model.Products.ImagePro" alt="@Model.Products.NamePro" id="pdMainImg"/>
                    </div>
                    <!-- Thumbnail strip (same image as demo, replace with actual thumbs if available) -->
                    <div class="dp-thumbs" id="thumbStrip">
                        <div class="dp-thumb active" onclick="switchImg(this, '@Url.Content("~/Images/" + Model.Products.ImagePro)')">
                            <img src="~/Images/@Model.Products.ImagePro" alt=""/>
                        </div>
                    </div>
                </div>

                <!-- Buy box -->
                <div class="dp-info">
                    <div class="dp-chips">
                        <span class="dp-chip star">
                            <i class="fas fa-star" style="font-size:10px;"></i>
                            @Math.Round(avg, 1) &middot; @numReview đánh giá
                        </span>
                        <span class="dp-chip @(inStock ? "stock" : "nostock")">
                            <i class="fas fa-@(inStock ? "check-circle" : "times-circle")" style="font-size:10px;"></i>
                            @(inStock ? $"Còn {Model.StockQuantity} sp" : "Hết hàng")
                        </span>
                        <span class="dp-chip auth">
                            <i class="fas fa-shield-alt" style="font-size:10px;"></i> Chính hãng
                        </span>
                    </div>

                    <h1 class="dp-title">@Model.Products.NamePro</h1>

                    <div class="dp-price-wrap">
                        <div class="dp-price">@String.Format("{0:#,##0}", Model.Products.Price) ₫</div>
                        <div class="dp-price-note">Đã bao gồm VAT · Miễn phí đổi trả 7 ngày</div>
                    </div>

                    <!-- Live delivery estimate -->
                    <div class="dp-delivery">
                        <i class="fas fa-truck-fast"></i>
                        <span>Giao hàng dự kiến <strong id="deliveryDate"></strong> &mdash; miễn phí cho đơn từ 500.000₫</span>
                    </div>

                    <div class="dp-trust">
                        <div class="dp-trust-item"><i class="fas fa-certificate"></i><span>Chính hãng 100%</span></div>
                        <div class="dp-trust-item"><i class="fas fa-rotate-left"></i><span>Đổi trả 7 ngày</span></div>
                        <div class="dp-trust-item"><i class="fas fa-shield-check"></i><span>BH 12 tháng</span></div>
                    </div>

                    <div>
                        <div class="dp-desc-label">Mô tả sản phẩm</div>
                        <div class="dp-desc-body">@Model.Products.DecriptionPro</div>
                    </div>

                    <div class="dp-purchase">
                        <div class="dp-purchase-row">
                            <div>
                                <span class="dp-qty-label">Số lượng</span>
                                <div class="dp-stepper">
                                    <button type="button" id="qtyMinus">−</button>
                                    <input type="number" name="quantity" id="quantityInput" value="1" min="1" max="@Model.StockQuantity" @(inStock ? "" : "disabled")/>
                                    <button type="button" id="qtyPlus">+</button>
                                </div>
                            </div>
                            <span class="dp-stock-tag @(inStock ? "ok" : "out")">
                                <i class="fas fa-@(inStock ? "box" : "exclamation-triangle")" style="font-size:11px;"></i>
                                @(inStock ? $"Kho: {Model.StockQuantity}" : "Tạm hết")
                            </span>
                        </div>

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger mb-3 py-2" style="font-size:13px;border-radius:8px;">@TempData["Error"]</div>
                        }

                        <div class="dp-actions">
                            <button type="submit" class="dp-btn dp-btn-primary" @(inStock ? "" : "disabled")>
                                <i class="fas fa-bolt"></i> Mua ngay
                            </button>
                            <button type="submit" class="dp-btn dp-btn-secondary" @(inStock ? "" : "disabled")>
                                <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                            </button>
                            <a href="#dp-reviews" class="dp-btn dp-btn-secondary" style="text-decoration:none;">
                                <i class="fas fa-star"></i> Xem đánh giá
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Feature strip -->
        <div class="dp-features">
            <div class="dp-feature">
                <i class="fas fa-shield-check"></i>
                <strong>Chính hãng</strong>
                <span>Nguồn gốc rõ ràng</span>
            </div>
            <div class="dp-feature">
                <i class="fas fa-truck-fast"></i>
                <strong>Giao nhanh 2–3 ngày</strong>
                <span>Toàn quốc</span>
            </div>
            <div class="dp-feature">
                <i class="fas fa-rotate-left"></i>
                <strong>Đổi trả 7 ngày</strong>
                <span>Miễn phí, không hỏi</span>
            </div>
            <div class="dp-feature">
                <i class="fas fa-headset"></i>
                <strong>Hỗ trợ 24/7</strong>
                <span>Tư vấn tận tâm</span>
            </div>
        </div>

        <!-- Reviews -->
        <div class="dp-reviews" id="dp-reviews">
            <h2 class="dp-section-title"><i class="fas fa-star"></i> Đánh giá từ khách hàng</h2>

            <div class="dp-review-stats">
                <div class="dp-rating-big">
                    <div class="dp-rating-num">@Math.Round(avg, 1)</div>
                    <div class="dp-rating-stars">
                        @for (int s = 1; s <= 5; s++)
                        {
                            if (s <= Math.Round(avg)) { <i class="fas fa-star"></i> }
                            else { <i class="far fa-star" style="color:#e5e7eb;"></i> }
                        }
                    </div>
                    <div class="dp-rating-count">@numReview lượt đánh giá</div>
                </div>
                <div>
                    @{
                        var p5 = getLineCount(4.5, 5, numReview);
                        var p4 = getLineCount(3.5, 4, numReview);
                        var p3 = getLineCount(2.5, 3, numReview);
                        var p2 = getLineCount(1.5, 2, numReview);
                        var p1 = getLineCount(0,   1, numReview);
                    }
                    <div class="dp-bar-row"><span class="dp-bar-label">5 sao</span><div class="dp-bar-track"><div class="dp-bar-fill" style="width:@p5%"></div></div><span class="dp-bar-count">@getStarCount(4.5,5,numReview)</span></div>
                    <div class="dp-bar-row"><span class="dp-bar-label">4 sao</span><div class="dp-bar-track"><div class="dp-bar-fill" style="width:@p4%"></div></div><span class="dp-bar-count">@getStarCount(3.5,4,numReview)</span></div>
                    <div class="dp-bar-row"><span class="dp-bar-label">3 sao</span><div class="dp-bar-track"><div class="dp-bar-fill" style="width:@p3%"></div></div><span class="dp-bar-count">@getStarCount(2.5,3,numReview)</span></div>
                    <div class="dp-bar-row"><span class="dp-bar-label">2 sao</span><div class="dp-bar-track"><div class="dp-bar-fill" style="width:@p2%"></div></div><span class="dp-bar-count">@getStarCount(1.5,2,numReview)</span></div>
                    <div class="dp-bar-row"><span class="dp-bar-label">1 sao</span><div class="dp-bar-track"><div class="dp-bar-fill" style="width:@p1%"></div></div><span class="dp-bar-count">@getStarCount(0,1,numReview)</span></div>
                </div>
            </div>

            <!-- Write review -->
            <div class="dp-write-review">
                <h3 class="dp-write-title">Chia sẻ trải nghiệm của bạn</h3>
                <form id="reviewForm" class="row g-3">
                    <input type="hidden" id="editReviewId" value="0"/>
                    <div class="col-12">
                        <label class="dp-desc-label mb-2">Đánh giá sao</label>
                        <div style="display:flex;align-items:center;gap:12px;">
                            <div class="dp-star-input" id="ratingInput">
                                <i class="fas fa-star" data-rating="1"></i>
                                <i class="fas fa-star" data-rating="2"></i>
                                <i class="fas fa-star" data-rating="3"></i>
                                <i class="fas fa-star" data-rating="4"></i>
                                <i class="fas fa-star" data-rating="5"></i>
                            </div>
                            <span id="ratingText" style="font-size:13px;color:#9ca3af;">Chưa chọn</span>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="dp-desc-label mb-2">Nội dung đánh giá</label>
                        <textarea id="reviewContent" class="dp-form-input" rows="4" placeholder="Sản phẩm này như thế nào? Hãy chia sẻ nhé..."></textarea>
                    </div>
                    <div class="col-12 d-flex justify-content-end">
                        <button type="submit" class="dp-btn dp-btn-primary btn-submit-review" style="grid-column:auto;width:auto;padding:12px 28px;">
                            <i class="fas fa-paper-plane"></i> Gửi đánh giá
                        </button>
                    </div>
                </form>
            </div>

            <!-- Review list -->
            <div>
                <div class="dp-review-header">
                    <span style="font-size:15px;font-weight:600;color:#111827;">Tất cả đánh giá</span>
                    <span class="dp-review-badge">@numReview đánh giá</span>
                </div>

                @if (numReview > 0)
                {
                    <div id="reviewContainer">
                        @{ var numReviewToShow = 3; }
                        @for (int i = 0; i < numReview; i++)
                        {
                            var item = Model.RelatedReviews[i];
                            string hideClass = i >= numReviewToShow ? "review-hidden" : "";
                            <div class="dp-review-item @hideClass" data-review-index="@i">
                                <div style="display:flex;align-items:center;justify-content:space-between;">
                                    <div style="display:flex;align-items:center;gap:12px;">
                                        <div class="dp-reviewer-avatar">
                                            @(string.IsNullOrEmpty(item.ReviewerName) ? "K" : item.ReviewerName.Substring(0,1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="dp-review-name">@(string.IsNullOrEmpty(item.ReviewerName) ? "Khách hàng ẩn danh" : item.ReviewerName)</div>
                                            <div class="dp-review-meta">Đã mua · @(item.ReviewDate?.ToString("dd/MM/yyyy") ?? "")</div>
                                        </div>
                                    </div>
                                    <div class="dp-review-stars">
                                        @for (int j = 0; j < 5; j++)
                                        {
                                            if (j < item.Rating) { <i class="fas fa-star"></i> }
                                            else { <i class="far fa-star" style="color:#e5e7eb;"></i> }
                                        }
                                    </div>
                                </div>
                                <div class="dp-review-text">@item.ReviewContent</div>
                                @if (currentCustomerId != null && item.ReviewerName == currentCustomerId)
                                {
                                    <div class="dp-review-actions">
                                        <button class="dp-review-action-btn edit btn-edit-review"
                                                data-id="@item.ReviewID"
                                                data-content="@item.ReviewContent"
                                                data-rating="@item.Rating">
                                            <i class="fas fa-pen fa-xs"></i> Sửa
                                        </button>
                                        <button class="dp-review-action-btn delete btn-delete-review"
                                                data-id="@item.ReviewID">
                                            <i class="fas fa-trash fa-xs"></i> Xóa
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    if (numReview > numReviewToShow)
                    {
                        <div class="text-center mt-4" id="loadMoreContainer">
                            <button id="loadMoreBtn">
                                Xem thêm <span id="remainingCount">@(numReview - numReviewToShow)</span> đánh giá <i class="fas fa-angle-down ms-1"></i>
                            </button>
                        </div>
                        <div class="text-center mt-4" style="display:none;" id="showLessContainer">
                            <button id="showLessBtn">Thu gọn <i class="fas fa-angle-up ms-1"></i></button>
                        </div>
                    }
                }
                else
                {
                    <div class="dp-review-empty">
                        <i class="fas fa-comment-dots"></i>
                        <strong style="font-size:14px;color:#374151;font-weight:600;">Chưa có đánh giá nào</strong>
                        <p>Hãy là người đầu tiên chia sẻ trải nghiệm về sản phẩm này.</p>
                    </div>
                }
            </div>

            <!-- Related products placeholder -->
            <div class="mt-5 pt-4" style="border-top:1px solid #f3f4f6;">
                <h2 class="dp-section-title"><i class="fas fa-layer-group"></i> Sản phẩm liên quan</h2>
                <div class="Products-grid"></div>
            </div>
        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {

    // ── Delivery date estimate ──
    const d = new Date();
    d.setDate(d.getDate() + 2 + Math.floor(Math.random() * 2));
    const days = ['CN','T2','T3','T4','T5','T6','T7'];
    document.getElementById('deliveryDate').textContent =
        days[d.getDay()] + ', ' + d.getDate() + '/' + (d.getMonth()+1);

    // ── Thumbnail switcher ──
    window.switchImg = function(el, src) {
        document.getElementById('pdMainImg').src = src;
        document.querySelectorAll('.dp-thumb').forEach(t => t.classList.remove('active'));
        el.classList.add('active');
    };

    // ── Gallery hover tilt ──
    const gallery = document.querySelector('.dp-gallery');
    const mainImg = document.getElementById('pdMainImg');
    if (gallery && mainImg) {
        gallery.addEventListener('mousemove', e => {
            const r = gallery.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - .5;
            const y = (e.clientY - r.top)  / r.height - .5;
            mainImg.style.transform = `scale(1.04) rotateY(${x*6}deg) rotateX(${-y*4}deg)`;
        });
        gallery.addEventListener('mouseleave', () => { mainImg.style.transform = ''; });
    }

    // ── Quantity stepper ──
    const qInput = document.getElementById('quantityInput');
    const qMinus = document.getElementById('qtyMinus');
    const qPlus  = document.getElementById('qtyPlus');
    if (qInput) {
        const max = parseInt(qInput.max) || 1, min = parseInt(qInput.min) || 1;
        const sync = () => {
            let v = Math.max(min, Math.min(max, parseInt(qInput.value) || min));
            qInput.value = v;
            if (qMinus) qMinus.disabled = v <= min;
            if (qPlus)  qPlus.disabled  = v >= max;
        };
        sync();
        qMinus?.addEventListener('click', () => { qInput.value = parseInt(qInput.value) - 1; sync(); });
        qPlus?.addEventListener('click',  () => { qInput.value = parseInt(qInput.value) + 1; sync(); });
        qInput.addEventListener('change', sync);
    }

    // ── Smooth scroll ──
    document.querySelectorAll('a[href^="#"]').forEach(a => {
        a.addEventListener('click', e => {
            e.preventDefault();
            document.querySelector(a.getAttribute('href'))?.scrollIntoView({ behavior:'smooth', block:'start' });
        });
    });

    // ── Load more / show less ──
    const loadMoreBtn   = document.getElementById('loadMoreBtn');
    const showLessBtn   = document.getElementById('showLessBtn');
    const loadMoreCont  = document.getElementById('loadMoreContainer');
    const showLessCont  = document.getElementById('showLessContainer');
    const remainSpan    = document.getElementById('remainingCount');
    let visible = 3;
    const total = @numReview;
    const perLoad = 5;

    loadMoreBtn?.addEventListener('click', () => {
        const show = Math.min(perLoad, total - visible);
        for (let i = visible; i < visible + show; i++) {
            const el = document.querySelector(`[data-review-index="${i}"]`);
            if (el) { el.classList.remove('review-hidden'); el.classList.add('show-animation'); }
        }
        document.querySelector(`[data-review-index="${visible}"]`)?.scrollIntoView({ behavior:'smooth', block:'center' });
        visible += show;
        remainSpan.textContent = total - visible;
        if (total - visible <= 0) loadMoreCont.style.display = 'none';
        showLessCont.style.display = 'block';
    });

    showLessBtn?.addEventListener('click', () => {
        for (let i = 3; i < total; i++) {
            const el = document.querySelector(`[data-review-index="${i}"]`);
            if (el) { el.classList.add('review-hidden'); el.classList.remove('show-animation'); }
        }
        visible = 3;
        remainSpan.textContent = total - 3;
        loadMoreCont.style.display = 'block';
        showLessCont.style.display = 'none';
        document.querySelector('.dp-review-header')?.scrollIntoView({ behavior:'smooth', block:'start' });
    });

    // ── Star rating input ──
    const rStars = document.querySelectorAll('#ratingInput i');
    const rText  = document.getElementById('ratingText');
    const labels = ['','Rất tệ','Tệ','Bình thường','Tốt','Rất tốt'];
    let selectedRating = 0;

    const paintStars = rating => rStars.forEach((s,i) => s.classList.toggle('active', i < rating));

    rStars.forEach((s, i) => {
        s.addEventListener('click', () => {
            selectedRating = i + 1;
            paintStars(selectedRating);
            rText.textContent = labels[selectedRating];
        });
        s.addEventListener('mouseenter', () => paintStars(i + 1));
        s.addEventListener('mouseleave', () => paintStars(selectedRating));
    });

    // ── Submit review ──
    document.querySelectorAll('.btn-submit-review').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            const content = document.getElementById('reviewContent').value.trim();
            const editId  = parseInt(document.getElementById('editReviewId').value);
            if (!selectedRating) { Swal.fire('Cảnh báo','Vui lòng chọn số sao!','warning'); return; }
            if (!content)        { Swal.fire('Cảnh báo','Vui lòng nhập nội dung!','warning'); return; }

            const orig = this.innerHTML;
            this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...';
            this.style.pointerEvents = 'none';

            const url     = editId > 0 ? '@Url.Action("EditReview","Reviews")' : '@Url.Action("CreateReview","CustomerPro")';
            const payload = { score: selectedRating, content, proID: @Model.Products.ProductID };
            if (editId > 0) payload.reviewId = editId;

            fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) })
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire({ title:'Thành công!', text: data.message || 'Đã lưu đánh giá.', icon:'success', confirmButtonColor:'#111827' })
                            .then(() => location.reload());
                    } else {
                        Swal.fire('Thất bại!', data.message || 'Lỗi xử lý.', 'error');
                    }
                })
                .catch(() => Swal.fire('Lỗi kết nối','Vui lòng thử lại.','error'))
                .finally(() => { this.innerHTML = orig; this.style.pointerEvents = 'auto'; });
        });
    });

    // ── Edit review ──
    document.querySelectorAll('.btn-edit-review').forEach(btn => {
        btn.addEventListener('click', function() {
            document.getElementById('editReviewId').value = this.dataset.id;
            document.getElementById('reviewContent').value = this.dataset.content;
            selectedRating = parseInt(this.dataset.rating);
            paintStars(selectedRating);
            rText.textContent = labels[selectedRating];

            const submitBtn = document.querySelector('.btn-submit-review');
            submitBtn.innerHTML = '<i class="fas fa-save me-1"></i> Cập nhật đánh giá';
            document.querySelector('.dp-write-title').textContent = 'Chỉnh sửa đánh giá';
            document.querySelector('.dp-write-review').scrollIntoView({ behavior:'smooth', block:'center' });
        });
    });

    // ── Delete review ──
    document.querySelectorAll('.btn-delete-review').forEach(btn => {
        btn.addEventListener('click', function() {
            const id = this.dataset.id;
            Swal.fire({
                title:'Xóa đánh giá?',
                text:'Hành động này không thể hoàn tác.',
                icon:'warning',
                showCancelButton:true,
                confirmButtonColor:'#dc2626',
                cancelButtonColor:'#6b7280',
                confirmButtonText:'Xóa',
                cancelButtonText:'Hủy'
            }).then(res => {
                if (!res.isConfirmed) return;
                fetch('@Url.Action("DeleteCustomerReview","Reviews")', {
                    method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ reviewId: id })
                })
                .then(r => r.json())
                .then(data => {
                    if (data.success) Swal.fire('Đã xóa!','','success').then(() => location.reload());
                    else Swal.fire('Lỗi!', data.message, 'error');
                });
            });
        });
    });
});
</script>
}
