                        </div>
                        <div class="total-numReview">@numReview lượt đánh giá</div>
                    </div>

                    <div class="rating-breakdown">
                        @{ 
                            var p5 = getLineCount(4.5, 5, numReview);
                            var p4 = getLineCount(3.5, 4, numReview);
                            var p3 = getLineCount(2.5, 3, numReview);
                            var p2 = getLineCount(1.5, 2, numReview);
                            var p1 = getLineCount(0, 1, numReview);
                        }
                        <div class="rating-bar"><span class="rating-bar-label">5 Sao</span><div class="rating-bar-fill"><div class="rating-bar-inner" style="width: @p5%"></div></div><span class="rating-bar-count">@getStarCount(4.5, 5, numReview)</span></div>
                        <div class="rating-bar"><span class="rating-bar-label">4 Sao</span><div class="rating-bar-fill"><div class="rating-bar-inner" style="width: @p4%"></div></div><span class="rating-bar-count">@getStarCount(3.5, 4, numReview)</span></div>
                        <div class="rating-bar"><span class="rating-bar-label">3 Sao</span><div class="rating-bar-fill"><div class="rating-bar-inner" style="width: @p3%"></div></div><span class="rating-bar-count">@getStarCount(2.5, 3, numReview)</span></div>
                        <div class="rating-bar"><span class="rating-bar-label">2 Sao</span><div class="rating-bar-fill"><div class="rating-bar-inner" style="width: @p2%"></div></div><span class="rating-bar-count">@getStarCount(1.5, 2, numReview)</span></div>
                        <div class="rating-bar"><span class="rating-bar-label">1 Sao</span><div class="rating-bar-fill"><div class="rating-bar-inner" style="width: @p1%"></div></div><span class="rating-bar-count">@getStarCount(0, 1, numReview)</span></div>
                    </div>
                </div>

                <div class="write-review-section">
                    <h3 class="write-review-title">Chia sẻ trải nghiệm của bạn</h3>
                    <form id="reviewForm" class="row g-4">
