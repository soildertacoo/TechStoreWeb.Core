@model TechStore.Models.RelatedPro
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    // 1. TẠO BIẾN AN TOÀN TRƯỚC
    int numReview = 0;
    decimal avg = 0;
    string? currentCustomerId = User.Identity.IsAuthenticated ? User.Identity.Name : null;

    // 2. KIỂM TRA MODEL CÓ TỒN TẠI KHÔNG TRƯỚC KHI ĐẾM
    if (Model != null && Model.Products != null)
    {
        numReview = (Model.RelatedReviews != null) ? Model.RelatedReviews.Count() : 0;
        avg = numReview > 0 ? Model.RelatedReviews.Average(a => a.Rating) : 0;
    }
}
@functions{
    private int getStarCount(double min, int max , int numReview){
        return numReview > 0 && Model != null && Model.RelatedReviews != null ? Model.RelatedReviews.Count(s => s.Rating > (decimal)min && s.Rating <= max) : 0;
    }
    private double getLineCount(double min, int max, int numReview){
        return numReview > 0 && Model != null && Model.RelatedReviews != null ? Model.RelatedReviews.Count(s => s.Rating > (decimal)min && s.Rating <= max) / (double)numReview * 100 : 0;
    }
}

@if (Model == null || Model.Products == null)
{
    <div class="container text-center py-5 mt-5" style="min-height: 50vh;">
        <svg xmlns="http://www.w3.org/2000/svg" width="100" height="100" fill="#cbd5e1" class="bi bi-box-seam mb-4" viewBox="0 0 16 16">
          <path d="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.958l-7.15 2.85a1.5 1.5 0 0 1-1.114 0l-7.149-2.85A1 1 0 0 1 0 12.162V3.5a.5.5 0 0 1 .316-.464L7.443.184z"/>
        </svg>
        <h2 class="text-danger fw-bold" style="font-family: 'Inter', sans-serif;">Không tìm thấy sản phẩm!</h2>
        <p class="text-muted fs-5">Sản phẩm này không tồn tại, có thể đã bị xóa hoặc đường dẫn URL bị sai.</p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary px-4 py-2 mt-3" style="border-radius: 50px; font-weight: 600;">
            <i class="fas fa-arrow-left me-2"></i> Quay lại trang chủ
        </a>
    </div>
}
else
{
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <style>
        :root {
            --primary-color: #667eea;
            --primary-hover: #5a67d8;
            --secondary-color: #764ba2;
            --accent-color: #00d4ff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --price-color: #dc2626;
            --star-color: #fbbf24;
            --bg-body: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            --white: #ffffff;
            --shadow-sm: 0 4px 12px rgba(0,0,0,.08);
            --shadow-md: 0 12px 40px rgba(0,0,0,.12);
            --shadow-lg: 0 20px 60px rgba(102,126,234,.15);
            --shadow-glow: 0 0 30px rgba(102,126,234,.3);
            --radius-lg: 28px;
            --radius-md: 20px;
            --radius-sm: 12px;
        }

        .pd-page-wrap { background: var(--bg-body); min-height: 60vh; padding-bottom: 60px; }

        .Products-detail { max-width: 1280px; margin: 0 auto; padding: 16px 24px 80px; }

        /* ── Breadcrumb ── */
        .pd-breadcrumb {
            display: flex; align-items: center; gap: 10px;
            font-size: .9rem; color: var(--text-muted);
            margin-bottom: 24px; flex-wrap: wrap;
            padding: 12px 20px;
            background: rgba(255,255,255,.8);
            backdrop-filter: blur(10px);
            border-radius: 50px;
            border: 1px solid rgba(0,0,0,.06);
        }
        .pd-breadcrumb a { color: var(--text-muted); text-decoration: none; transition: all .3s; font-weight: 500; }
        .pd-breadcrumb a:hover { color: var(--primary-color); transform: translateX(4px); }
        .pd-breadcrumb .sep { opacity: .3; }
        .pd-breadcrumb .current { color: var(--text-main); font-weight: 700; }

        /* ── Main product layout ── */
        .pd-main {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0;
            background: #fff;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-md);
            border: 2px solid rgba(0,0,0,.06);
            margin-bottom: 40px;
            transition: box-shadow .3s;
        }
        .pd-main:hover { box-shadow: var(--shadow-lg); }

        /* Gallery – Đổi sang nền sáng */
        .pd-gallery {
            position: relative;
            background: #ffffff; /* Đổi nền gradient tối thành màu trắng */
            min-height: 560px;
            display: flex; align-items: center; justify-content: center;
            overflow: hidden;
            padding: 56px 48px;
            border-right: 1px solid #f1f5f9; /* Gạch dọc mờ ngăn cách với cột nội dung */
        }
        .pd-gallery::before {
            content: '';
            position: absolute; inset: 0;
            background-image: radial-gradient(rgba(0,0,0,.04) 1px, transparent 1px); /* Đổi chấm bi thành xám nhạt */
            background-size: 32px 32px;
        }
        .pd-gallery-orb {
            position: absolute; border-radius: 50%; filter: blur(80px); pointer-events: none;
        }
        /* Giảm độ đậm của 2 vệt sáng để hợp với nền trắng */
        .pd-gallery-orb-1 { width: 350px; height: 350px; background: rgba(102,126,234,.1); top: -80px; left: -60px; animation: pdOrb 18s ease-in-out infinite alternate; }
        .pd-gallery-orb-2 { width: 300px; height: 300px; background: rgba(0,212,255,.1); bottom: -60px; right: -40px; animation: pdOrb 22s ease-in-out infinite alternate reverse; }
        @@keyframes pdOrb { from { transform: translate(0,0); } to { transform: translate(30px,-35px); } }
        .pd-gallery-inner {
            position: relative; z-index: 2;
            width: 100%; max-width: 420px;
            aspect-ratio: 1;
            display: flex; align-items: center; justify-content: center;
        }
        .pd-gallery-inner img {
            width: 100%; max-height: 400px;
            object-fit: contain;
            filter: drop-shadow(0 30px 60px rgba(0,0,0,.6));
            transition: transform .6s cubic-bezier(.23,1,.32,1);
        }
        .pd-gallery:hover .pd-gallery-inner img { transform: scale(1.08) translateY(-8px); }

        .pd-badge {
            position: absolute; top: 0; left: 0;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            color: #fff; padding: 8px 20px;
            border-radius: 50px; font-size: .8rem; font-weight: 800;
            letter-spacing: .5px; z-index: 3;
            box-shadow: 0 6px 20px rgba(239,68,68,.4);
        }
        .pd-badge.discount {
            background: linear-gradient(135deg, #667eea, #764ba2);
            box-shadow: 0 6px 20px rgba(102,126,234,.4);
        }

        /* Buy box – light side */
        .pd-buybox {
            padding: 48px 52px;
            display: flex; flex-direction: column;
            background: #fff;
        }

        .pd-chips { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
        .pd-chip {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 8px 16px; border-radius: 50px;
            font-size: .8rem; font-weight: 700;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); color: #475569;
            border: 2px solid #e9ecef;
            transition: all .3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .pd-chip:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(0,0,0,.08); }
        .pd-chip i { font-size: .8rem; }
        .pd-chip.chip-star { background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%); color: #b45309; border-color: #fde68a; }
        .pd-chip.chip-star i { color: #f59e0b; }
        .pd-chip.chip-stock-ok { background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); color: #047857; border-color: #a7f3d0; }
        .pd-chip.chip-stock-no { background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); color: #b91c1c; border-color: #fecaca; }
        .pd-chip.chip-auth { background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%); color: #4338ca; border-color: #c7d2fe; }

        .pd-title {
            font-size: clamp(1.8rem, 2.8vw, 2.4rem);
            font-weight: 600; /* Hạ từ 900 xuống 600 để chữ bình thường, bớt cục mịch */
            color: #0f172a;
            line-height: 1.25; 
            margin-bottom: 24px;
            /* Đã xóa hiệu ứng background-clip gradient để chữ hiển thị bình thường */
        }

        .pd-price-block {
            background: linear-gradient(135deg, #faf5ff 0%, #eef2ff 100%);
            border: 2px solid #e0e7ff;
            border-radius: var(--radius-md);
            padding: 24px 28px;
            margin-bottom: 24px;
            position: relative;
            overflow: hidden;
        }
        .pd-price-block::before {
            content: '';
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(102,126,234,.05), transparent);
            animation: shimmer 3s infinite;
        }
        @@keyframes shimmer { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }
        .pd-price {
            font-size: 2.5rem; 
            font-weight: 700; /* Hạ từ 900 xuống 700 */
            color: #dc2626; 
            line-height: 1;
            margin-bottom: 6px; 
            /* Đã xóa text-shadow đỏ chót để số tiền nhìn sắc nét hơn */
        }
        .pd-price-sub { font-size: .9rem; color: #64748b; font-weight: 500; }

        .pd-trust {
            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: 12px; margin-bottom: 28px;
        }
        .pd-trust-item {
            text-align: center; padding: 16px 12px;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border-radius: var(--radius-sm);
            border: 2px solid #f1f5f9;
            transition: all .3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .pd-trust-item:hover { border-color: #c7d2fe; background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%); transform: translateY(-3px); box-shadow: 0 8px 20px rgba(102,126,234,.15); }
        .pd-trust-item i { font-size: 1.4rem; color: #667eea; margin-bottom: 8px; display: block; }
        .pd-trust-item span { font-size: .75rem; font-weight: 700; color: #475569; line-height: 1.4; display: block; }

        .pd-desc {
            flex: 1; margin-bottom: 28px;
            border-top: 2px solid #f1f5f9;
            padding-top: 24px;
        }
        .pd-desc-title {
            font-size: .85rem; font-weight: 800;
            text-transform: uppercase; letter-spacing: .1em;
            color: #667eea; margin-bottom: 16px;
            display: flex; align-items: center; gap: 10px;
        }
        .pd-desc-body {
            font-size: .95rem; color: #475569; line-height: 1.8;
            max-height: 160px; overflow-y: auto;
            padding-right: 12px;
            scrollbar-width: thin;
            scrollbar-color: #c7d2fe transparent;
        }
        .pd-desc-body::-webkit-scrollbar { width: 6px; }
        .pd-desc-body::-webkit-scrollbar-thumb { background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50px; }

        .pd-purchase {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border: 2px solid #e2e8f0;
            border-radius: var(--radius-md);
            padding: 24px;
            margin-top: auto;
        }
        .pd-purchase-row {
            display: flex; align-items: center;
            justify-content: space-between;
            gap: 20px; margin-bottom: 20px; flex-wrap: wrap;
        }
        .pd-qty-label { font-size: .9rem; font-weight: 800; color: #334155; margin-bottom: 10px; display: block; }

        .pd-stepper {
            display: inline-flex; align-items: center;
            background: #fff; border: 2px solid #e2e8f0;
            border-radius: 50px; overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,.06);
        }
        .pd-stepper button {
            width: 44px; height: 44px; border: none;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); color: #475569;
            font-size: 1.2rem; font-weight: 800;
            cursor: pointer; transition: all .3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex; align-items: center; justify-content: center;
        }
        .pd-stepper button:hover { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; transform: scale(1.1); }
        .pd-stepper button:disabled { opacity: .4; cursor: not-allowed; }
        .pd-stepper input {
            width: 60px; height: 44px; border: none;
            border-left: 2px solid #e2e8f0;
            border-right: 2px solid #e2e8f0;
            text-align: center; font-weight: 800; font-size: 1.1rem;
            color: #0f172a; background: #fff;
        }
        .pd-stepper input:focus { outline: none; }

        .pd-stock {
            display: inline-flex; align-items: center; gap: 8px;
            font-size: .9rem; font-weight: 700;
            padding: 10px 18px; border-radius: 50px;
        }
        .pd-stock.in-stock { background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%); color: #047857; border: 2px solid #a7f3d0; }
        .pd-stock.out-stock { background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); color: #b91c1c; border: 2px solid #fecaca; }

        .pd-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
        .btn-modern {
            padding: 18px 24px; border: none; border-radius: 50px;
            font-weight: 800; font-size: 1rem;
            transition: all .3s cubic-bezier(.23,1,.32,1);
            display: inline-flex; align-items: center; justify-content: center; gap: 10px;
            cursor: pointer; text-decoration: none;
            position: relative; overflow: hidden;
        }
        .btn-modern::before {
            content: '';
            position: absolute; top: 50%; left: 50%;
            width: 0; height: 0;
            border-radius: 50%;
            background: rgba(255,255,255,.3);
            transform: translate(-50%, -50%);
            transition: width .6s, height .6s;
        }
        .btn-modern:hover::before { width: 300px; height: 300px; }
        .btn-primary-modern {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff; box-shadow: 0 8px 25px rgba(102,126,234,.4);
            grid-column: span 2;
            font-size: 1.1rem; padding: 20px;
        }
        .btn-primary-modern:hover:not(:disabled) { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(102,126,234,.5); color: #fff; }
        .btn-primary-modern:disabled { opacity: .5; cursor: not-allowed; transform: none; }
        .btn-secondary-modern {
            background: #fff; color: #334155;
            border: 2px solid #e2e8f0;
        }
        .btn-secondary-modern:hover:not(:disabled) { background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border-color: #667eea; color: #667eea; transform: translateY(-3px); box-shadow: 0 8px 20px rgba(102,126,234,.2); }
        .btn-secondary-modern:disabled { opacity: .5; cursor: not-allowed; }

        /* Legacy aliases kept for review section */
        .Products-card { display: none; }
        .Products-image, .Products-info, .Products-meta, .Products-title,
        .Products-price, .Products-description, .quantity-selector, .action-buttons,
        .stock-badge, .quantity-input, .quantity-label { /* migrated to pd-* */ }

        .feature-highlight {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
            color: #fff; padding: 0;
            border-radius: var(--radius-lg); margin: 40px 0;
            display: grid; grid-template-columns: repeat(4, 1fr);
            overflow: hidden;
            box-shadow: var(--shadow-lg);
            border: 2px solid rgba(102,126,234,.2);
            position: relative;
        }
        .feature-highlight::before {
            content: '';
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at 20% 50%, rgba(102,126,234,.2) 0%, transparent 50%),
                        radial-gradient(circle at 80% 50%, rgba(0,212,255,.15) 0%, transparent 50%);
            pointer-events: none;
        }
        .feature-highlight-item {
            padding: 32px 24px; text-align: center;
            border-right: 1px solid rgba(255,255,255,.08);
            transition: all .3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative; z-index: 1;
        }
        .feature-highlight-item:last-child { border-right: none; }
        .feature-highlight-item:hover { background: rgba(102,126,234,.15); transform: translateY(-4px); }
        .feature-highlight-item i { font-size: 1.8rem; color: #00d4ff; margin-bottom: 12px; display: block; transition: transform .3s; }
        .feature-highlight-item:hover i { transform: scale(1.2) rotate(5deg); }
        .feature-highlight-item strong { display: block; font-size: .9rem; font-weight: 800; color: #fff; margin-bottom: 6px; }
        .feature-highlight-item span { font-size: .8rem; color: rgba(255,255,255,.7); }
        .feature-highlight-icon, .feature-highlight h4, .feature-highlight p { display: none; }

        .section-title {
            font-size: 1.8rem; font-weight: 900; color: var(--text-main);
            margin: 0 0 32px; display: flex; align-items: center; gap: 12px;
            letter-spacing: -.03em;
            background: linear-gradient(135deg, #0f172a 0%, #334155 100%);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
        }
        .section-title i { color: #667eea; font-size: 1.4rem; }

        /* Review section */
        .review-section {
            background: var(--white);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            padding: 48px;
            margin: 40px 0;
            border: 2px solid rgba(0,0,0,.06);
        }

        .review-stats {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 40px;
            margin-bottom: 40px;
            padding: 32px;
            background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
            border-radius: var(--radius-md);
            border: 2px solid #e2e8f0;
        }
        .overall-rating {
            text-align: center;
            padding: 28px 32px;
            background: var(--white);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            min-width: 180px;
            border: 2px solid #e2e8f0;
        }
        .rating-number { font-size: 3.6rem; font-weight: 900; line-height: 1; color: var(--text-main); background: linear-gradient(135deg, #0f172a 0%, #334155 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .rating-stars { margin: 12px 0; }
        .rating-stars i { color: var(--star-color); font-size: 1.3rem; }
        .total-numReview { font-size: .95rem; color: var(--text-muted); font-weight: 600; }

        .rating-breakdown { flex-grow: 1; }
        .rating-bar { display: flex; align-items: center; gap: 16px; margin-bottom: 12px; }
        .rating-bar-label { min-width: 56px; font-weight: 700; font-size: .9rem; color: var(--text-main); }
        .rating-bar-fill { flex-grow: 1; height: 10px; background: #e2e8f0; border-radius: 50px; overflow: hidden; }
        .rating-bar-inner { height: 100%; background: linear-gradient(90deg, #fbbf24, #f59e0b); border-radius: 50px; transition: width 1s cubic-bezier(.4,0,.2,1); }
        .rating-bar-count { min-width: 40px; font-size: .9rem; color: var(--text-muted); text-align: right; font-weight: 600; }

        .write-review-section {
            background: linear-gradient(135deg, #fafafa 0%, #f8fafc 100%);
            border-radius: var(--radius-md);
            padding: 32px;
            margin: 32px 0 40px;
            border: 2px solid #e2e8f0;
            position: relative;
        }
        .write-review-section::before {
            content: '✍️';
            position: absolute; top: -18px; left: 32px;
            background: var(--white); padding: 0 12px;
            font-size: 1.4rem;
        }
        .write-review-title { font-size: 1.3rem; font-weight: 800; margin-bottom: 24px; color: var(--text-main); }
        .rating-stars-input { display: flex; gap: 8px; }
        .rating-stars-input i { font-size: 1.8rem; color: #cbd5e1; cursor: pointer; transition: all .3s cubic-bezier(0.4, 0, 0.2, 1); }
        .rating-stars-input i:hover, .rating-stars-input i.active { color: var(--star-color); transform: scale(1.2) rotate(5deg); }
        .form-input { padding: 16px; border: 2px solid #e2e8f0; border-radius: var(--radius-sm); font-size: 1rem; background: #fff; transition: all .3s cubic-bezier(0.4, 0, 0.2, 1); width: 100%; }
        .form-input:focus { border-color: #667eea; box-shadow: 0 0 0 5px rgba(102,126,234,.15); outline: none; }

        .review-list-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
        .review-count-badge { background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%); color: #667eea; padding: 6px 16px; border-radius: 50px; font-size: .85rem; font-weight: 800; border: 2px solid #c7d2fe; }

        .review-item {
            background: var(--white);
            border-radius: var(--radius-md);
            padding: 28px 32px;
            margin-bottom: 20px;
            border: 2px solid #e2e8f0;
            transition: all .3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
        }
        .review-item:hover { border-color: #c7d2fe; box-shadow: 0 8px 25px rgba(102,126,234,.12); transform: translateY(-3px); }
        .review-item::before {
            content: '"';
            position: absolute; top: 16px; right: 24px;
            font-size: 3.5rem; color: #eef2ff; font-family: Georgia, serif; line-height: 1;
        }
        .reviewer-avatar {
            width: 48px; height: 48px; border-radius: 50%;
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: #fff; font-weight: 800; font-size: 1.1rem;
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 6px 16px rgba(102,126,234,.3);
        }
        .review-content { color: var(--text-main); font-size: 1rem; margin-top: 16px; line-height: 1.8; }

        .review-action-group { display: flex; justify-content: flex-end; gap: 12px; margin-top: 16px; padding-top: 16px; border-top: 2px dashed #e2e8f0; }
        .btn-review-action {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border: 2px solid #e2e8f0;
            color: #64748b; padding: 8px 18px;
            border-radius: 50px; font-size: .85rem; font-weight: 700;
            transition: all .3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; align-items: center; gap: 6px; cursor: pointer;
        }
        .btn-review-action.edit:hover { background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%); border-color: #667eea; color: #667eea; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(102,126,234,.15); }
        .btn-review-action.delete:hover { background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%); border-color: #fecaca; color: #dc2626; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(220,38,38,.15); }

        .review-empty {
            text-align: center; padding: 64px 32px;
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border-radius: var(--radius-md); border: 2px dashed #cbd5e1;
        }
        .review-empty i { font-size: 3rem; color: #cbd5e1; margin-bottom: 16px; display: block; }

        .review-hidden { display: none; }
        .show-animation { animation: reviewFadeIn .5s cubic-bezier(0.4, 0, 0.2, 1); }
        @@keyframes reviewFadeIn { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }

        .btn-load-more {
            background: #fff; border: 2px solid #667eea;
            color: #667eea; padding: 12px 32px;
            border-radius: 50px; font-weight: 800; font-size: .95rem;
            transition: all .3s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer;
        }
        .btn-load-more:hover { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; transform: translateY(-2px); box-shadow: 0 8px 25px rgba(102,126,234,.3); }

        @@media (max-width: 991px) {
            .pd-main { grid-template-columns: 1fr; }
            .pd-gallery { min-height: 380px; padding: 40px 32px; }
            .pd-buybox { padding: 36px 32px; }
            .pd-trust { grid-template-columns: repeat(3, 1fr); }
            .pd-price { font-size: 2.2rem; }
            .review-stats { grid-template-columns: 1fr; }
            .feature-highlight { grid-template-columns: repeat(2, 1fr); }
            .feature-highlight-item:nth-child(2) { border-right: none; }
        }
        @@media (max-width: 576px) {
            .pd-trust { grid-template-columns: 1fr; }
            .pd-actions { grid-template-columns: 1fr; }
            .btn-primary-modern { grid-column: span 1; }
            .feature-highlight { grid-template-columns: 1fr; }
            .feature-highlight-item { border-right: none; border-bottom: 1px solid rgba(255,255,255,.08); }
            .pd-buybox { padding: 28px 20px; }
            .pd-gallery { padding: 32px 20px; }
            .review-section { padding: 32px 20px; }
        }
    </style>

    <div class="container-fluid pd-page-wrap">
        @* <nav class="breadcrumb-modern container" data-aos="fade-down">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "CustomerPro")">Sản phẩm</a></li>
                <li class="breadcrumb-item active">@Model.Products.NamePro</li>
            </ol>
        </nav> *@

        <div class="Products-detail">
