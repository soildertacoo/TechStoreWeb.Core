                    <span class="sep">›</span>
                    <a href="@Url.Action("Index", "Home")#ts-products">Sản phẩm</a>
                    <span class="sep">›</span>
                    <span class="current">@Model.Products.NamePro</span>
                </nav>

                <div class="pd-main" data-aos="fade-up">
                    <div class="pd-gallery">
                        <div class="pd-gallery-orb pd-gallery-orb-1"></div>
                        <div class="pd-gallery-orb pd-gallery-orb-2"></div>
                        <div class="pd-gallery-inner">
