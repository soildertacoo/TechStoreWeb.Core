    @using Microsoft.EntityFrameworkCore.Diagnostics
    @model TechStore.Models.RelatedPro
    @{
        ViewBag.Title = "Chi tiết sản phẩm";
        Layout = "~/Views/Shared/_Layout.cshtml";
        int numReview = Model.RelatedReviews.Count() > 0 ? Model.RelatedReviews.Count() :  0;
        decimal avg = numReview > 0 ? Model.RelatedReviews.Average(a => a.Rating) : 0;
        
    }
    @functions{
        
        private int getStarCount(double min, int max , int numReview){
            return numReview > 0 ? Model.RelatedReviews.Count(s => s.Rating > (decimal)min && s.Rating <= max) : 0;
        }
        private double getLineCount(double min, int max, int numReview){
            return numReview > 0 ? Model.RelatedReviews.Count(s => s.Rating > (decimal)min && s.Rating <= max) 
            / numReview * 100 : 0;
        }
    }
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <style>
        /* =======================================
        HỆ MÀU & BIẾN CSS MỚI (HIỆN ĐẠI, TỐI GIẢN)
        ======================================= */
        :root {
            --primary-color: #4f46e5; /* Indigo sang trọng */
            --primary-hover: #4338ca;
            --secondary-color: #f1f5f9;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --price-color: #ef4444; /* Đỏ rực thu hút */
            --star-color: #fbbf24;
            --bg-body: #f8fafc;
            --white: #ffffff;
            
            --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);
            --shadow-md: 0 10px 30px rgba(0, 0, 0, 0.06);
            --shadow-hover: 0 20px 40px rgba(79, 70, 229, 0.12);
            
            --radius-lg: 20px;
            --radius-md: 12px;
            --radius-sm: 8px;
        }

        body {
            background-color: var(--bg-body);
            font-family: 'Inter', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; /* Thêm font Inter hiện đại */
            color: var(--text-main);
            line-height: 1.6;
        }

        /* BREADCRUMB */
        .breadcrumb-modern {
            padding: 25px 0 15px;
            font-size: 0.95rem;
        }
        .breadcrumb-modern a {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.2s;
        }
        .breadcrumb-modern a:hover { color: var(--primary-color); }
        .breadcrumb-modern .breadcrumb-item.active {
            color: var(--primary-color);
            font-weight: 600;
        }

        /* KHỐI SẢN PHẨM CHÍNH */
        .Products-detail { max-width: 1200px; margin: 0 auto; padding: 0 15px; }
        
        .Products-card {
            background: var(--white);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            padding: 20px;
            margin-bottom: 40px;
            border: 1px solid rgba(0,0,0,0.02);
        }

        /* HÌNH ẢNH SẢN PHẨM */
        .Products-image {
            position: relative;
            border-radius: var(--radius-md);
            overflow: hidden;
            background: #fff;
            padding: 10px;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .Products-image img {
            width: 100%;
            max-height: 450px;
            object-fit: contain;
            transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }
        .Products-image:hover img { transform: scale(1.08); }
        
        .Products-badge {
            position: absolute;
            top: 20px;
            right: 20px;
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
            padding: 6px 16px;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 1px;
            box-shadow: 0 4px 10px rgba(239, 68, 68, 0.3);
        }

        /* THÔNG TIN SẢN PHẨM */
        .Products-info { padding: 20px 20px 20px 40px; }
        
        .Products-title {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--text-main);
            line-height: 1.3;
            margin-bottom: 15px;
        }

        .Products-price {
            font-size: 2.4rem;
            font-weight: 800;
            color: var(--price-color);
            margin: 15px 0 25px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .Products-description {
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 30px;
            padding: 20px 25px;
            background: #f8fafc;
            border-radius: var(--radius-md);
            border-left: 4px solid var(--primary-color);
        }

        /* SỐ LƯỢNG & NÚT BẤM */
        .quantity-selector {
            display: flex;
            align-items: center;
            gap: 15px;
            margin: 25px 0;
        }
        .quantity-input {
            width: 90px;
            padding: 12px;
            border: 2px solid #e2e8f0;
            border-radius: var(--radius-sm);
            text-align: center;
            font-weight: 700;
            font-size: 1.1rem;
            color: var(--text-main);
            transition: border 0.3s;
        }
        .quantity-input:focus { border-color: var(--primary-color); outline: none; }

        .action-buttons { display: flex; gap: 15px; margin-top: 30px; }
        
        .btn-modern {
            padding: 16px 32px;
            border: none;
            border-radius: 50px;
            font-weight: 700;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            text-decoration: none;
            cursor: pointer;
        }
        .btn-primary-modern {
            background: var(--primary-color);
            color: white;
            flex: 1; /* Cho nút Mua Ngay to hơn */
            box-shadow: 0 8px 20px rgba(79, 70, 229, 0.25);
        }
        .btn-primary-modern:hover {
            background: var(--primary-hover);
            transform: translateY(-3px);
            color: white;
            box-shadow: 0 12px 25px rgba(79, 70, 229, 0.35);
        }
        .btn-secondary-modern {
            background: var(--secondary-color);
            color: var(--text-main);
            flex: 1;
        }
        .btn-secondary-modern:hover {
            background: #e2e8f0;
            transform: translateY(-3px);
        }

        /* HIGHLIGHT CAM KẾT */
        .feature-highlight {
            background: linear-gradient(to right, #1e293b, #0f172a);
            color: white;
            padding: 30px;
            border-radius: var(--radius-lg);
            margin: 40px 0;
            text-align: center;
            box-shadow: var(--shadow-md);
        }
        .feature-highlight h4 { font-weight: 700; margin-bottom: 10px; color: #38bdf8; }
        .feature-highlight p { margin: 0; color: #cbd5e1; font-size: 1.05rem; }

        /* TIÊU ĐỀ PHẦN */
        .section-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--text-main);
            margin: 0 0 30px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .section-title i { color: var(--primary-color); }

        /* REVIEW SECTION */
        .review-section {
            background: var(--white);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            padding: 40px;
            margin: 40px 0;
            border: 1px solid rgba(0,0,0,0.02);
        }

        .review-stats {
            display: flex;
            align-items: center;
            gap: 40px;
            margin-bottom: 40px;
            padding: 30px;
            background: var(--bg-body);
            border-radius: var(--radius-md);
        }

        .overall-rating {
            text-align: center;
            padding: 25px 30px;
            background: var(--white);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow-sm);
            min-width: 180px;
        }
        .rating-number { font-size: 3.5rem; font-weight: 800; line-height: 1; color: var(--text-main); }
        .rating-stars { margin: 10px 0; }
        .rating-stars i { color: var(--star-color); font-size: 1.3rem; }
        .total-numReview { font-size: 0.95rem; color: var(--text-muted); font-weight: 500; }

        .rating-breakdown { flex-grow: 1; }
        .rating-bar { display: flex; align-items: center; gap: 15px; margin-bottom: 12px; }
        .rating-bar-label { min-width: 50px; font-weight: 600; color: var(--text-main); }
        .rating-bar-fill { flex-grow: 1; height: 10px; background: #e2e8f0; border-radius: 10px; overflow: hidden; }
        .rating-bar-inner { height: 100%; background: var(--star-color); border-radius: 10px; transition: width 0.8s ease; }
        .rating-bar-count { min-width: 40px; font-size: 0.9rem; color: var(--text-muted); text-align: right; }

        /* FORM ĐÁNH GIÁ */
        .write-review-section {
            background: var(--white);
            border-radius: var(--radius-md);
            padding: 35px;
            margin: 30px 0 50px;
            border: 2px solid #e2e8f0;
        }
        .write-review-title { font-size: 1.4rem; font-weight: 700; margin-bottom: 25px; color: var(--text-main); }
        .rating-stars-input i { font-size: 1.8rem; color: #cbd5e1; cursor: pointer; transition: 0.2s; }
        .rating-stars-input i:hover, .rating-stars-input i.active { color: var(--star-color); transform: scale(1.1); }
        
        .form-input {
            padding: 15px;
            border: 2px solid #e2e8f0;
            border-radius: var(--radius-sm);
            font-size: 1rem;
            background: #f8fafc;
            transition: all 0.3s;
        }
        .form-input:focus {
            background: var(--white);
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
            outline: none;
        }

        /* ITEMS REVIEW */
        .review-item {
            background: var(--white);
            border-radius: var(--radius-md);
            padding: 25px;
            margin-bottom: 20px;
            border: 1px solid #e2e8f0;
            box-shadow: var(--shadow-sm);
        }
        .reviewer-avatar {
            width: 48px; height: 48px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary-color), #818cf8);
            color: white; font-weight: 700; font-size: 1.2rem;
            display: flex; align-items: center; justify-content: center;
        }
        .review-content { color: var(--text-main); font-size: 1.05rem; margin-top: 15px; }

        /* RESPONSIVE CSS */
        @@media (max-width: 991px) {
            .Products-info { padding: 30px 10px 10px; }
            .Products-title { font-size: 1.8rem; }
            .Products-price { font-size: 2rem; }
            .review-stats { flex-direction: column; gap: 20px; }
            .overall-rating { width: 100%; }
            .action-buttons { flex-direction: column; }
        }
    </style>

    <div class="container-fluid">
        <nav class="breadcrumb-modern container" data-aos="fade-down">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="@Url.Action("Index", "CustomerPro")">Sản phẩm</a></li>
                <li class="breadcrumb-item active">@Model.Products.NamePro</li>
            </ol>
        </nav>

        <div class="Products-detail">
            @using (Html.BeginForm("AddToShowCart", "Cart", FormMethod.Post))
            {
                @Html.Hidden("id", Model.Products.ProductID)
                
                <div class="Products-card" data-aos="fade-up">
                    <div class="row g-0 align-items-center">
                        <div class="col-lg-5">
                            <div class="Products-image">
                                <img src="~/Images/@Model.Products.ImagePro" alt="@Model.Products.NamePro" />
                                <div class="Products-badge"><i class="fas fa-fire me-1"></i> HOT</div>
                            </div>
                        </div>

                        <div class="col-lg-7">
                            <div class="Products-info">
                                <h1 class="Products-title">@Model.Products.NamePro</h1>
                                <div class="Products-price">
                                    @String.Format("{0:#,##0}", Model.Products.Price) ₫
                                </div>

                                <div class="Products-description">
                                    <strong class="text-dark d-block mb-2"><i class="fas fa-info-circle me-2"></i>Thông tin nổi bật:</strong>
                                    @Model.Products.DecriptionPro
                                </div>

                                <div class="quantity-selector">
                                    <label class="quantity-label fw-bold">Số lượng:</label>
                                    <input type="number" name="quantity" class="quantity-input" value="1" min="1" max="999" id="quantityInput">
                                </div>

                                <div class="mt-4">
                                    <span class="badge bg-success fs-6">
                                        Tồn kho: @Model.StockQuantity
                                    </span>
                                </div>

                                <div class="action-buttons">
                                    <button type="submit" class="btn-modern btn-primary-modern">
                                        <i class="fas fa-bolt"></i> Mua Ngay
                                    </button>

                                    @if (TempData["Error"] != null)
                                    {
                                        <div class="alert alert-danger">
                                            @TempData["Error"]
                                        </div>
}
                                    <button type="submit" class="btn-modern btn-secondary-modern">
                                        <i class="fas fa-cart-plus"></i> Thêm Vào Giỏ
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="feature-highlight" data-aos="fade-up">
                <h4><i class="fas fa-shield-check me-2"></i> Mua sắm an tâm</h4>
                <p>Hàng chính hãng 100% • Bảo hành điện tử 12 tháng • Miễn phí vận chuyển • Đổi trả 7 ngày</p>
            </div>

            <div class="review-section" data-aos="fade-up">
                <h2 class="section-title"><i class="fas fa-star"></i> Khách Hàng Đánh Giá</h2>

                <div class="review-stats">
                    <div class="overall-rating">
                        <div class="rating-number">@Math.Round(avg, 1)</div>
                        <div class="rating-stars">
                            @for (int s = 1; s <= 5; s++)
                            {
                                if (s <= Math.Round(avg)) { <i class="fas fa-star"></i> }
                                else { <i class="far fa-star" style="color:#cbd5e1"></i> }
                            }
                        </div>
                        <div class="total-numReview">@numReview lượt đánh giá</div>
                    </div>

                    <div class="rating-breakdown">
                        @{ 
                            var p5 = getLineCount(4.5, 5, numReview);
                            var p4 = getLineCount(3.5, 4, numReview);
                            var p3 = getLineCount(2.5, 3, numReview);
                            var p2 = getLineCount(1.5, 2, numReview);
                            var p1 = getLineCount(0, 1, numReview);
                        }
                        <div class="rating-bar"><span class="rating-bar-label">5 Sao</span><div class="rating-bar-fill"><div class="rating-bar-inner" style="width: @p5%"></div></div><span class="rating-bar-count">@getStarCount(4.5, 5, numReview)</span></div>
                        <div class="rating-bar"><span class="rating-bar-label">4 Sao</span><div class="rating-bar-fill"><div class="rating-bar-inner" style="width: @p4%"></div></div><span class="rating-bar-count">@getStarCount(3.5, 4, numReview)</span></div>
                        <div class="rating-bar"><span class="rating-bar-label">3 Sao</span><div class="rating-bar-fill"><div class="rating-bar-inner" style="width: @p3%"></div></div><span class="rating-bar-count">@getStarCount(2.5, 3, numReview)</span></div>
                        <div class="rating-bar"><span class="rating-bar-label">2 Sao</span><div class="rating-bar-fill"><div class="rating-bar-inner" style="width: @p2%"></div></div><span class="rating-bar-count">@getStarCount(1.5, 2, numReview)</span></div>
                        <div class="rating-bar"><span class="rating-bar-label">1 Sao</span><div class="rating-bar-fill"><div class="rating-bar-inner" style="width: @p1%"></div></div><span class="rating-bar-count">@getStarCount(0, 1, numReview)</span></div>
                    </div>
                </div>

                <div class="write-review-section">
                    <h3 class="write-review-title">Chia sẻ trải nghiệm của bạn</h3>
                    <form id="reviewForm" class="row g-4">
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Đánh giá sao:</label>
                            <div class="d-flex align-items-center gap-3">
                                <div class="rating-stars-input" id="ratingInput">
                                    <i class="fas fa-star" data-rating="1"></i>
                                    <i class="fas fa-star" data-rating="2"></i>
                                    <i class="fas fa-star" data-rating="3"></i>
                                    <i class="fas fa-star" data-rating="4"></i>
                                    <i class="fas fa-star" data-rating="5"></i>
                                </div>
                                <span id="ratingText" class="badge bg-secondary">Chưa chọn</span>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Nội dung đánh giá:</label>
                            <textarea id="reviewContent" class="form-control form-input" rows="4" placeholder="Sản phẩm này như thế nào? Chia sẻ nhé..."></textarea>
                        </div>
                        <div class="col-md-12 text-end">
                            <button type="submit" class="btn-modern btn-primary-modern px-5 btn-submit-review" style="border-radius: 8px;">
                                <i class="fas fa-paper-plane me-2"></i> Gửi Đánh Giá
                            </button>
                        </div>
                    </form>
                </div>

                <div class="review-list">
                    @if (numReview > 0)
                    {
                        <div id="reviewContainer">
                            @{ var numReviewToShow = 3; }
                            @for (int i = 0; i < numReview; i++)
                            {
                                var item = Model.RelatedReviews[i];
                                string hideClass = i >= numReviewToShow ? "review-hidden" : "";
                                
                                <div class="review-item @hideClass" data-review-index="@i">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="reviewer-avatar">
                                                @(string.IsNullOrEmpty(item.ReviewerName) ? "U" : item.ReviewerName.Substring(0,1).ToUpper())
                                            </div>
                                            <div>
                                                <h6 class="mb-1 fw-bold text-dark">@(string.IsNullOrEmpty(item.ReviewerName) ? "Khách hàng ẩn danh" : item.ReviewerName)</h6>
                                                <small class="text-muted">Đã mua hàng • @(item.ReviewDate?.ToString("dd/MM/yyyy") ?? "")</small>
                                            </div>
                                        </div>
                                        <div class="rating-stars m-0">
                                            @for (int j = 0; j < 5; j++)
                                            {
                                                if (j < item.Rating) { <i class="fas fa-star" style="font-size:1rem;"></i> }
                                                else { <i class="far fa-star" style="color:#cbd5e1; font-size:1rem;"></i> }
                                            }
                                        </div>
                                    </div>
                                    <div class="review-content">@item.ReviewContent</div>
                                </div>
                            }
                        </div>

                        if (numReview > numReviewToShow)
                        {
                            <div class="text-center mt-4" id="loadMoreContainer">
                                <button class="btn btn-outline-primary rounded-pill px-4 py-2 fw-bold" id="loadMoreBtn">
                                    Xem thêm <span id="remainingCount">@(numReview - numReviewToShow)</span> đánh giá <i class="fas fa-angle-down ms-1"></i>
                                </button>
                            </div>
                            <div class="text-center mt-4" style="display: none;" id="showLessContainer">
                                <button class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-bold" id="showLessBtn">
                                    Thu gọn <i class="fas fa-angle-up ms-1"></i>
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 bg-light rounded-3">
                            <i class="fas fa-box-open text-muted mb-3" style="font-size: 3rem;"></i>
                            <h5 class="text-dark fw-bold">Chưa có đánh giá nào</h5>
                            <p class="text-muted">Hãy là người đầu tiên trải nghiệm và đánh giá sản phẩm này.</p>
                        </div>
                    }
                </div>
                
                <div class="mt-5 pt-4 border-top">
                    <h2 class="section-title"><i class="fas fa-layer-group"></i> Sản Phẩm Liên Quan</h2>
                    <div class="Products-grid">
                        </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Khởi tạo AOS Animation
        AOS.init({
            duration: 800,
            easing: 'ease-in-out',
            once: true
        });

        // Đưa TẤT CẢ logic vào DOMContentLoaded để đảm bảo an toàn, tránh lỗi null HTML
        document.addEventListener('DOMContentLoaded', function() {
            
            // ==========================================
            // 1. XỬ LÝ XEM THÊM / THU GỌN ĐÁNH GIÁ
            // ==========================================
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            const showLessBtn = document.getElementById('showLessBtn');
            const loadMoreContainer = document.getElementById('loadMoreContainer');
            const showLessContainer = document.getElementById('showLessContainer');
            const remainingCountSpan = document.getElementById('remainingCount');

            let currentlyVisible = 3; 
            const totalnumReview = @Model.RelatedReviews.Count(); // Razor biến giữ nguyên
            const numReviewPerLoad = 5; 

            if (loadMoreBtn) {
                loadMoreBtn.addEventListener('click', function() {
                    const numReviewToShow = Math.min(numReviewPerLoad, totalnumReview - currentlyVisible);
                    const targetVisible = currentlyVisible + numReviewToShow;

                    // Hiển thị các review tiếp theo
                    for (let i = currentlyVisible; i < targetVisible; i++) {
                        const review = document.querySelector(`[data-review-index="${i}"]`);
                        if (review) {
                            review.classList.remove('review-hidden');
                            review.classList.add('show-animation');
                        }
                    }

                    // Scroll nhẹ xuống vùng review mới load (mượt mà hơn)
                    const firstNewReview = document.querySelector(`[data-review-index="${currentlyVisible}"]`);
                    if (firstNewReview) {
                        setTimeout(() => {
                            firstNewReview.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }, 100); 
                    }

                    currentlyVisible = targetVisible;
                    const remaining = totalnumReview - currentlyVisible;
                    remainingCountSpan.textContent = remaining;

                    if (remaining <= 0) loadMoreContainer.style.display = 'none';
                    showLessContainer.style.display = 'block';
                });
            }

            if (showLessBtn) {
                showLessBtn.addEventListener('click', function() {
                    // Ẩn tất cả review trừ 3 cái đầu
                    for (let i = 3; i < totalnumReview; i++) {
                        const review = document.querySelector(`[data-review-index="${i}"]`);
                        if (review) {
                            review.classList.add('review-hidden');
                            review.classList.remove('show-animation');
                        }
                    }

                    currentlyVisible = 3;
                    remainingCountSpan.textContent = totalnumReview - 3;

                    loadMoreContainer.style.display = 'block';
                    showLessContainer.style.display = 'none';

                    // Cuộn về lại tiêu đề danh sách review
                    document.querySelector('.review-list h4').scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                });
            }

            // ==========================================
            // 2. XỬ LÝ SỐ LƯỢNG & SCROLL MƯỢT
            // ==========================================
            const quantityInput = document.getElementById('quantityInput');
            if (quantityInput) {
                quantityInput.addEventListener('change', function () {
                    console.log('Số lượng đã chọn:', this.value);
                });
            }

            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            });

            // ==========================================
            // 3. XỬ LÝ ĐÁNH GIÁ SAO (RATING)
            // ==========================================
            const ratingStars = document.querySelectorAll('#ratingInput i');
            const ratingText = document.getElementById('ratingText');
            const ratingTexts = ['', 'Rất tệ', 'Tệ', 'Bình thường', 'Tốt', 'Rất tốt'];
            let selectedRating = 0;

            const updateStarDisplay = (rating) => {
                ratingStars.forEach((star, index) => {
                    star.classList.toggle('active', index < rating);
                });
            };

            ratingStars.forEach((star, index) => {
                star.addEventListener('click', () => {
                    selectedRating = index + 1;
                    updateStarDisplay(selectedRating);
                    ratingText.textContent = ratingTexts[selectedRating] || 'Chưa chọn';
                });

                star.addEventListener('mouseenter', () => updateStarDisplay(index + 1));
                star.addEventListener('mouseleave', () => updateStarDisplay(selectedRating));
            });

            // ==========================================
            // 4. XỬ LÝ GỬI FORM REVIEW QUA API
            // ==========================================
            const btnReviewList = document.querySelectorAll(".btn-submit-review");
            btnReviewList.forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault(); // Rất quan trọng: Ngăn trình duyệt tự tải lại trang
                    
                    const content = document.getElementById('reviewContent').value.trim();

                    if (selectedRating === 0) {
                        Swal.fire("Cảnh báo", "Vui lòng chọn số sao đánh giá!", "warning");
                        return;
                    }
                    if (!content) {
                        Swal.fire("Cảnh báo", "Vui lòng điền nội dung đánh giá!", "warning");
                        return;
                    }

                    // Lưu text gốc và đổi sang trạng thái đang chờ
                    const originalBtnText = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...';
                    this.style.pointerEvents = 'none'; // Không cho bấm liên tiếp

                    fetch('@Url.Action("CreateReview", "CustomerPro")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ 
                            score: selectedRating, 
                            content: content, 
                            proID: @Model.Products.ProductID 
                        })
                    })
                    .then(response => response.json())
                    .then(data => {
                        // Xử lý chuẩn xác kết quả từ Controller
                        if (data.success) {
                            Swal.fire({
                                title: "Thành công!",
                                text: data.message || "Đánh giá của bạn đã được ghi nhận.",
                                icon: "success", 
                                confirmButtonColor: "#3085d6"
                            }).then(() => {
                                window.location.reload(); // Tải lại trang để hiện review
                            }); 
                        } else {
                            Swal.fire({
                                title: "Thất bại!",
                                text: data.message || "Không thể gửi đánh giá, vui lòng kiểm tra lại.",
                                icon: "error", 
                                confirmButtonColor: "#d33"
                            });
                        }
                    })
                    .catch(error => {
                        console.error("Lỗi Fetch:", error);
                        Swal.fire("Lỗi kết nối", "Có lỗi xảy ra khi giao tiếp với máy chủ.", "error");
                    })
                    .finally(() => {
                        // Khôi phục lại nút bấm dù lỗi hay thành công
                        this.innerHTML = originalBtnText;
                        this.style.pointerEvents = 'auto';
                    });
                });
            });

            // ==========================================
            // 5. XỬ LÝ NÚT HỮU ÍCH (Chống spam click)
            // ==========================================
            document.querySelectorAll('.review-action-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    // Chỉ cho phép click 1 lần bằng cách ktra class 'liked'
                    if (this.innerHTML.includes('thumbs-up') && !this.classList.contains('liked')) {
                        const currentText = this.textContent;
                        const match = currentText.match(/\d+/);
                        const currentCount = match ? parseInt(match[0]) : 0;
                        
                        this.innerHTML = `<i class="fas fa-thumbs-up"></i> Hữu ích (${currentCount + 1})`;
                        this.style.color = '#667eea';
                        this.classList.add('liked'); // Đánh dấu là đã bấm
                    }
                });
            });
        });
    </script>