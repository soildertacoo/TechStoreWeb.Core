    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Khởi tạo AOS Animation
        AOS.init({
            duration: 800,
            easing: 'ease-in-out',
            once: true
        });

        // Đưa TẤT CẢ logic vào DOMContentLoaded để đảm bảo an toàn, tránh lỗi null HTML
        document.addEventListener('DOMContentLoaded', function() {
            
            // ==========================================
            // 1. XỬ LÝ XEM THÊM / THU GỌN ĐÁNH GIÁ
            // ==========================================
            const loadMoreBtn = document.getElementById('loadMoreBtn');
            const showLessBtn = document.getElementById('showLessBtn');
            const loadMoreContainer = document.getElementById('loadMoreContainer');
            const showLessContainer = document.getElementById('showLessContainer');
            const remainingCountSpan = document.getElementById('remainingCount');

            let currentlyVisible = 3; 
            const totalnumReview = @numReview; // Đã đổi biến cho an toàn
            const numReviewPerLoad = 5; 

            if (loadMoreBtn) {
                loadMoreBtn.addEventListener('click', function() {
                    const numReviewToShow = Math.min(numReviewPerLoad, totalnumReview - currentlyVisible);
                    const targetVisible = currentlyVisible + numReviewToShow;

                    for (let i = currentlyVisible; i < targetVisible; i++) {
                        const review = document.querySelector(`[data-review-index="${i}"]`);
                        if (review) {
                            review.classList.remove('review-hidden');
                            review.classList.add('show-animation');
                        }
                    }

                    const firstNewReview = document.querySelector(`[data-review-index="${currentlyVisible}"]`);
                    if (firstNewReview) {
                        setTimeout(() => {
                            firstNewReview.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }, 100); 
                    }

                    currentlyVisible = targetVisible;
                    const remaining = totalnumReview - currentlyVisible;
                    remainingCountSpan.textContent = remaining;

                    if (remaining <= 0) loadMoreContainer.style.display = 'none';
                    showLessContainer.style.display = 'block';
                });
            }

            if (showLessBtn) {
                showLessBtn.addEventListener('click', function() {
                    for (let i = 3; i < totalnumReview; i++) {
                        const review = document.querySelector(`[data-review-index="${i}"]`);
                        if (review) {
                            review.classList.add('review-hidden');
                            review.classList.remove('show-animation');
                        }
                    }

                    currentlyVisible = 3;
                    remainingCountSpan.textContent = totalnumReview - 3;

                    loadMoreContainer.style.display = 'block';
                    showLessContainer.style.display = 'none';

                    document.querySelector('.review-list h4')?.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                });
            }

            // ==========================================
            // 2. XỬ LÝ SỐ LƯỢNG & SCROLL MƯỢT
            // ==========================================
            const quantityInput = document.getElementById('quantityInput');
            const qtyMinus = document.getElementById('qtyMinus');
            const qtyPlus = document.getElementById('qtyPlus');
            if (quantityInput) {
                const max = parseInt(quantityInput.max) || 1;
                const min = parseInt(quantityInput.min) || 1;
                const syncQty = () => {
                    let v = parseInt(quantityInput.value) || min;
                    v = Math.max(min, Math.min(max, v));
                    quantityInput.value = v;
                    if (qtyMinus) qtyMinus.disabled = v <= min;
                    if (qtyPlus) qtyPlus.disabled = v >= max;
                };
                syncQty();
                qtyMinus?.addEventListener('click', () => { quantityInput.value = Math.max(min, parseInt(quantityInput.value) - 1); syncQty(); });
                qtyPlus?.addEventListener('click', () => { quantityInput.value = Math.min(max, parseInt(quantityInput.value) + 1); syncQty(); });
                quantityInput.addEventListener('change', syncQty);
            }

            // Gallery 3D tilt
            const gallery = document.querySelector('.pd-gallery');
            const mainImg = document.getElementById('pdMainImg');
            if (gallery && mainImg) {
                gallery.addEventListener('mousemove', e => {
                    const rect = gallery.getBoundingClientRect();
                    const x = (e.clientX - rect.left) / rect.width - 0.5;
                    const y = (e.clientY - rect.top) / rect.height - 0.5;
                    mainImg.style.transform = `scale(1.05) translateY(-6px) rotateY(${x * 10}deg) rotateX(${-y * 8}deg)`;
                });
                gallery.addEventListener('mouseleave', () => { mainImg.style.transform = ''; });
            }

            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                });
            });

            // ==========================================
            // 3. XỬ LÝ ĐÁNH GIÁ SAO (RATING)
            // ==========================================
            const ratingStars = document.querySelectorAll('#ratingInput i');
            const ratingText = document.getElementById('ratingText');
            const ratingTexts = ['', 'Rất tệ', 'Tệ', 'Bình thường', 'Tốt', 'Rất tốt'];
            let selectedRating = 0;

            const updateStarDisplay = (rating) => {
                ratingStars.forEach((star, index) => {
                    star.classList.toggle('active', index < rating);
                });
            };

            ratingStars.forEach((star, index) => {
                star.addEventListener('click', () => {
                    selectedRating = index + 1;
                    updateStarDisplay(selectedRating);
                    ratingText.textContent = ratingTexts[selectedRating] || 'Chưa chọn';
                });

                star.addEventListener('mouseenter', () => updateStarDisplay(index + 1));
                star.addEventListener('mouseleave', () => updateStarDisplay(selectedRating));
            });

            // ==========================================
            // 4. XỬ LÝ GỬI FORM REVIEW QUA API
            // ==========================================
             const btnReviewList = document.querySelectorAll(".btn-submit-review");
            btnReviewList.forEach(btn => {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    
                    const content = document.getElementById('reviewContent').value.trim();
                    const editId = parseInt(document.getElementById('editReviewId').value);

                    if (selectedRating === 0) {
                        Swal.fire("Cảnh báo", "Vui lòng chọn số sao đánh giá!", "warning");
                        return;
                    }
                    if (!content) {
                        Swal.fire("Cảnh báo", "Vui lòng điền nội dung đánh giá!", "warning");
                        return;
                    }

                    const originalBtnText = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang xử lý...';
                    this.style.pointerEvents = 'none';

                    const apiUrl = editId > 0 ? '@Url.Action("EditReview", "Reviews")' : '@Url.Action("CreateReview", "CustomerPro")';
                    
                    const payload = { 
                        score: selectedRating, 
                        content: content, 
                        proID: @Model.Products.ProductID 
                    };
                    
                    if (editId > 0) { payload.reviewId = editId; }

                    fetch(apiUrl, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            Swal.fire({
                                title: "Thành công!",
                                text: data.message || "Đã lưu đánh giá của bạn.",
                                icon: "success", 
                                confirmButtonColor: "#3085d6"
                            }).then(() => window.location.reload()); 
                        } else {
                            Swal.fire("Thất bại!", data.message || "Lỗi xử lý, vui lòng thử lại.", "error");
                        }
                    })
                    .catch(error => {
                        Swal.fire("Lỗi kết nối", "Có lỗi xảy ra khi giao tiếp với máy chủ.", "error");
                    })
                    .finally(() => {
                        this.innerHTML = originalBtnText;
                        this.style.pointerEvents = 'auto';
                    });
                });
            });

            // ==========================================
            // 5. XỬ LÝ NÚT HỮU ÍCH (Chống spam click)
            // ==========================================
            document.querySelectorAll('.review-action-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    // Chỉ cho phép click 1 lần bằng cách ktra class 'liked'
                    if (this.innerHTML.includes('thumbs-up') && !this.classList.contains('liked')) {
                        const currentText = this.textContent;
                        const match = currentText.match(/\d+/);
                        const currentCount = match ? parseInt(match[0]) : 0;
                        
                        this.innerHTML = `<i class="fas fa-thumbs-up"></i> Hữu ích (${currentCount + 1})`;
                        this.style.color = '#667eea';
                        this.classList.add('liked'); // Đánh dấu là đã bấm
                    }
                });
            });

            // ==========================================
            // 6. NÚT SỬA VÀ XÓA CỦA KHÁCH HÀNG
            // ==========================================
            document.querySelectorAll('.btn-edit-review').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.dataset.id;
                    const content = this.dataset.content;
                    const rating = parseInt(this.dataset.rating);

                    document.getElementById('editReviewId').value = id;
                    document.getElementById('reviewContent').value = content;
                    
                    selectedRating = rating;
                    updateStarDisplay(rating);
                    document.getElementById('ratingText').textContent = ratingTexts[rating];

                    const submitBtn = document.querySelector('.btn-submit-review');
                    submitBtn.innerHTML = '<i class="fas fa-save me-2"></i> Cập nhật đánh giá';
                    submitBtn.classList.replace('btn-primary-modern', 'btn-warning');
                    document.querySelector('.write-review-title').textContent = "Sửa đánh giá của bạn";

                    document.querySelector('.write-review-section').scrollIntoView({ behavior: 'smooth', block: 'center' });
                });
            });

            document.querySelectorAll('.btn-delete-review').forEach(btn => {
                btn.addEventListener('click', function() {
                    const id = this.dataset.id;
                    
                    Swal.fire({
                        title: 'Bạn có chắc chắn?',
                        text: "Đánh giá này sẽ bị xóa vĩnh viễn!",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#d33',
                        cancelButtonColor: '#3085d6',
                        confirmButtonText: 'Vâng, xóa nó!',
                        cancelButtonText: 'Hủy'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            fetch('@Url.Action("DeleteCustomerReview", "Reviews")', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ reviewId: id })
                            })
                            .then(res => res.json())
                            .then(data => {
                                if (data.success) {
                                    Swal.fire('Đã xóa!', 'Đánh giá của bạn đã bị xóa.', 'success')
                                    .then(() => window.location.reload());
                                } else {
                                    Swal.fire('Lỗi!', data.message, 'error');
                                }
                            });
                        }
                    });
                });
            });

        });
    </script>
}