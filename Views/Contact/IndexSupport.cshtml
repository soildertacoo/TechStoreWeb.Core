                                    <label class="form-label">Số điện thoại</label>
                                    <div class="custom-input">@Html.DisplayFor(model => model.PhoneNumber)</div>
                                </div>
                            </div>
                            
                            <div class="mb-4">
                                <label class="form-label">Email liên hệ</label>
                                <div class="custom-input">@Html.DisplayFor(model => model.Email)</div>
                            </div>

