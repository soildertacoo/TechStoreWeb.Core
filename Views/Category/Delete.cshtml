@model TechStore.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh; padding-top: 40px;">
    
    <div class="card shadow-sm rounded-4 border-0" style="max-width: 480px; width: 100%;">
        <div class="card-body p-4 p-md-5">
            
            @if (ViewBag.Loi != null)
            {
                <div class="alert text-center mb-4 rounded-3 border-0" style="background-color: #fee2e2; color: #991b1b;">
                    @ViewBag.Loi
                </div>
            }

            <div class="text-center mb-4">
                <span style="font-size: 3.5rem; color: #ef4444; line-height: 1;">&#9888;</span>
                <h4 class="mt-2 mb-2" style="font-weight: 700; color: #ef4444;">Bạn có chắc chắn xóa?</h4>
                <p class="text-secondary mb-0" style="font-size: 0.95rem;">Hành động này không thể hoàn tác.</p>
            </div>

            <div class="d-flex justify-content-center mb-4 pb-2">
                <table class="table table-borderless w-auto mb-0" style="font-size: 1.05rem;">
                    <tbody>
                        <tr>
                            <td class="text-secondary text-end pe-3 py-1">ID Phân loại:</td>
                            <td class="fw-bold text-dark py-1">@Html.DisplayFor(model => model.IDCate)</td>
                        </tr>
                        <tr>
                            <td class="text-secondary text-end pe-3 py-1">Tên phân loại:</td>
                            <td class="fw-bold text-dark py-1">@Html.DisplayFor(model => model.NameCate)</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                
                @Html.HiddenFor(model => model.Id)
                @Html.HiddenFor(model => model.IDCate) 
                
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-danger rounded-pill px-4 py-2 shadow-sm" style="background-color: #ef4444; border: none; font-weight: 500;">
                        Xác nhận xóa
                    </button>
                    
                    <a href="@Url.Action("Index")" class="btn btn-light text-secondary border rounded-pill px-4 py-2 shadow-sm" style="font-weight: 500;">
                        Quay lại
                    </a>
                </div>
            }
            
        </div>
    </div>
</div>