@{
    ViewBag.Title = "DangKy";
    Layout = "~/Views/Shared/_LogSignLayout.cshtml";
}

<div class="auth-page">
    <aside class="auth-brand">
        <div class="auth-orb auth-orb-1"></div>
        <div class="auth-orb auth-orb-2"></div>
        <div class="auth-orb auth-orb-3"></div>
        <div class="auth-brand-inner">
            <div class="auth-logo">
                <div class="auth-logo-icon"><i class="fas fa-microchip"></i></div>
                <div class="auth-logo-text">TechStore<span>VN</span></div>
            </div>
            <h2>Tham gia cộng đồng <em>TechStoreVN</em></h2>
            <p>Tạo tài khoản miễn phí và nhận ngay ưu đãi chào mừng cùng quyền lợi VIP khi mua sắm.</p>
            <ul class="auth-features">
                <li><i class="fas fa-gift"></i> Ưu đãi thành viên mới</li>
                <li><i class="fas fa-star"></i> Tích điểm VIP tự động</li>
                <li><i class="fas fa-bolt"></i> Thanh toán nhanh 1 chạm</li>
                <li><i class="fas fa-bell"></i> Thông báo khuyến mãi sớm nhất</li>
            </ul>
        </div>
    </aside>

    <main class="auth-form-panel">
        <div class="auth-card register-card">
            <div class="header">
                <h1>Đăng ký tài khoản</h1>
                <p>Điền thông tin cá nhân để tiếp tục</p>
            </div>

            <div class="progress-steps">
                <span id="stepLabel1" class="step-active">① Thông tin tài khoản</span>
                <span id="stepLabel2">② Địa chỉ giao hàng</span>
            </div>
            <div class="progress-bar">
                <div class="progress-fill" id="progressFill"></div>
            </div>

            <div id="alertContainer">
                <div class="alert alert-info" id="errorAlert" style="display: none;">
                    <i class="fas fa-info-circle"></i>
                    <span id="errorMessage"></span>
                </div>
                <div class="alert alert-success" id="successAlert" style="display: none;">
                    <i class="fas fa-check-circle"></i>
                    <span id="successMessage"></span>
                </div>
            </div>

            <form asp-action="DangKy" asp-controller="User" method="post" class="needs-validation" novalidate>
                <div asp-validation-summary="All" class="text-danger"></div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-info"><i class="fas fa-info-circle"></i> @ViewBag.Error</div>
                }
                else if (ViewBag.Success != null)
                {
                    <div class="alert alert-success"><i class="fas fa-check-circle"></i> @ViewBag.Success</div>
                }

                <div id="accountInfo" class="auth-step active">
                    <div class="form-group">
                        <label for="nameCus" class="field-label">Tên bạn</label>
                        <div class="input-wrapper">
                            <input type="text" class="form-control" id="nameCus" name="NameCus" required placeholder="Nhập tên bạn vào" />
                            <i class="fas fa-user input-icon"></i>
                        </div>
                        <div class="invalid-feedback">Vui lòng nhập tên của bạn.</div>
                    </div>

                    <div class="form-group">
                        <label for="phoneCus" class="field-label">Số điện thoại</label>
                        <div class="input-wrapper">
                            <input type="tel" class="form-control" id="phoneCus" name="PhoneCus" required placeholder="Nhập số điện thoại" pattern="^\d{10}$" />
                            <i class="fas fa-phone input-icon"></i>
                        </div>
                        <div class="invalid-feedback">Số của bạn phải đủ 10 số.</div>
                    </div>

                    <div class="form-group">
                        <label for="emailCus" class="field-label">Email của bạn</label>
                        <div class="input-wrapper">
                            <input type="email" class="form-control" id="emailCus" name="EmailCus" required placeholder="Nhập email" />
                            <i class="fas fa-envelope input-icon"></i>
                        </div>
                        <div class="invalid-feedback">Vui lòng nhập email hợp lệ.</div>
                    </div>

                    <div class="form-group">
                        <label for="passCus" class="field-label">Mật khẩu</label>
                        <div class="input-wrapper">
                            <input type="password" class="form-control" id="passCus" name="PassCus" required placeholder="Nhập mật khẩu" />
                            <i class="fas fa-lock input-icon"></i>
                        </div>
                        <div class="invalid-feedback">Mật khẩu ít nhất 8 ký tự, gồm số và chữ.</div>
                        <div class="password-strength">
                            <div class="strength-bar">
                                <div class="strength-fill" id="strengthFill"></div>
                            </div>
                            <div class="strength-text" id="strengthText">Độ mạnh mật khẩu</div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="dateOfBirth" class="field-label">Sinh nhật</label>
                        <div class="input-wrapper">
                            <input type="date" class="form-control" id="dateOfBirth" name="DateOfBirth" required />
                            <i class="fas fa-calendar input-icon"></i>
                        </div>
                    </div>

                    <button type="button" class="btn btn-primary" onclick="showAddressInfo()">
                        Tiếp theo <i class="fas fa-arrow-right"></i>
                    </button>
                </div>

                <div id="addressInfo" class="auth-step">
                    <div class="form-group">
                        <label for="streetAddress" class="field-label">Địa chỉ nhà</label>
                        <div class="input-wrapper">
                            <input type="text" class="form-control" id="streetAddress" name="StreetAddress" required placeholder="Nhập địa chỉ nhà" />
                            <i class="fas fa-home input-icon"></i>
                        </div>
                        <div class="invalid-feedback">Vui lòng nhập địa chỉ.</div>
                    </div>

                    <div class="form-group">
                        <label for="ward" class="field-label">Phường, xã</label>
                        <div class="input-wrapper">
                            <input type="text" class="form-control" id="ward" name="Ward" required placeholder="Nhập phường, xã" />
                            <i class="fas fa-map-marker-alt input-icon"></i>
                        </div>
                        <div class="invalid-feedback">Vui lòng nhập phường, xã.</div>
                    </div>

                    <div class="form-group">
                        <label for="district" class="field-label">Quận, huyện</label>
                        <div class="input-wrapper">
                            <input type="text" class="form-control" id="district" name="District" required placeholder="Nhập quận, huyện" />
                            <i class="fas fa-map-marker-alt input-icon"></i>
                        </div>
                        <div class="invalid-feedback">Vui lòng nhập quận, huyện.</div>
                    </div>

                    <div class="form-group">
                        <label for="city" class="field-label">Tỉnh, Thành phố</label>
                        <div class="input-wrapper">
                            <input type="text" class="form-control" id="city" name="City" required placeholder="Nhập thành phố" />
                            <i class="fas fa-city input-icon"></i>
                        </div>
                        <div class="invalid-feedback">Vui lòng nhập thành phố, tỉnh.</div>
                    </div>

                    <div class="btn-group">
                        <button type="button" class="btn btn-secondary" onclick="showAccountInfo()">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </button>
                        <button type="submit" id="btnSubmit" class="btn btn-success">
                            <i class="fas fa-check"></i> Hoàn tất đăng ký
                        </button>
                    </div>
                </div>

                <div id="2factorform" class="auth-step">
                    <div class="otp-card">
                        <div class="otp-header">
                            <i class="fas fa-shield-alt otp-icon"></i>
                            <h3>Xác thực hai lớp (2FA)</h3>
                            <p>Dùng app Google Authenticator hay Microsoft Authenticator để lấy mã OTP</p>
                        </div>
                        <div class="otp-qr-section">
                            <img id="imgQR" alt="QR Code ứng dụng" class="otp-qr-img" />
                        </div>
                        <div class="otp-input-section">
                            <label for="otpCode" class="otp-label">Nhập mã OTP từ ứng dụng</label>
                            <div class="input-wrapper">
                                <input type="number" class="form-control otp-input" id="otpCode" placeholder="Nhập mã OTP" />
                                <i class="fas fa-key input-icon"></i>
                            </div>
                            <div class="invalid-feedback" id="invalid-otp" style="display:none">Vui lòng nhập đủ mã OTP gồm 6 số.</div>
                        </div>
                        <div class="otp-actions">
                            <button type="button" class="btn btn-primary" id="otpSubmit" onclick="verifyOTP()">
                                <i class="fas fa-check-circle"></i> Xác thực OTP
                            </button>
                        </div>
                    </div>
                </div>
            </form>

            <div class="login-link">
                <p>Đã có tài khoản?</p>
                <a href="@Url.Action("DangNhap", "User")">Đăng nhập ngay</a>
            </div>
        </div>
    </main>
</div>

<script>
    let currentStep = 1;
    let modelOTP = null;

    function showAddressInfo() {
        if (validateCurrentStep()) {
            currentStep = 2;
            document.getElementById("accountInfo").classList.remove("active");
            document.getElementById("addressInfo").classList.add("active");
            updateProgress();
        }
    }

    function show2Factor() {
        if (validateCurrentAdreessStep()) {
            document.getElementById("addressInfo").classList.remove("active");
            document.getElementById("2factorform").classList.add("active");
            setupOTP();
        }
    }

    function setupOTP() {
        const name = document.getElementById("nameCus").value;
        const pass = document.getElementById("passCus").value;
        fetch('@Url.Action("Factor2Setup", "User")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ user: name, pass: pass })
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                document.getElementById("imgQR").src = "data:image/png;base64," + data.factorModel.qrCodeImage;
                modelOTP = data.factorModel;
            }
        })
        .catch(error => alert("Có lỗi khi setup OTP " + error));
    }

    function verifyOTP() {
        const feedback = document.getElementById("invalid-otp");
        if (feedback.style.display === "block") feedback.style.display = "none";

        const input = document.getElementById("otpCode").value;
        if (/^[0-9]{6}$/.test(input)) {
            fetch('@Url.Action("VerifyOTP", "User")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ model: modelOTP, OtpCode: input })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById("btnSubmit").style.display = "block";
                    document.getElementById("otpSubmit").style.display = "none";
                } else {
                    document.getElementById("btnSubmit").style.display = "none";
                    feedback.style.display = "block";
                    alert("Nhập OTP không chính xác, vui lòng nhập lại");
                }
            })
            .catch(error => alert("Có lỗi khi gửi mã OTP lên server" + error));
        } else {
            feedback.style.display = "block";
        }
    }

    function showAccountInfo() {
        currentStep = 1;
        document.getElementById("addressInfo").classList.remove("active");
        document.getElementById("accountInfo").classList.add("active");
        updateProgress();
    }

    function updateProgress() {
        document.getElementById("progressFill").style.width = currentStep === 1 ? "50%" : "100%";
        document.getElementById("stepLabel1").classList.toggle("step-active", currentStep === 1);
        document.getElementById("stepLabel2").classList.toggle("step-active", currentStep === 2);
    }

    function validateCurrentStep() {
        const inputs = document.getElementById("accountInfo").querySelectorAll("input[required]");
        let isValid = true;
        inputs.forEach(input => {
            if (!input.checkValidity()) {
                input.classList.add("is-invalid");
                const feedback = input.closest(".form-group")?.querySelector(".invalid-feedback");
                if (feedback) feedback.classList.add("show");
                isValid = false;
            } else {
                input.classList.remove("is-invalid");
                input.classList.add("is-valid");
                const feedback = input.closest(".form-group")?.querySelector(".invalid-feedback");
                if (feedback) feedback.classList.remove("show");
            }
        });
        return isValid;
    }

    function validateCurrentAdreessStep() {
        const inputs = document.getElementById("addressInfo").querySelectorAll("input[required]");
        let isValid = true;
        inputs.forEach(input => {
            if (!input.checkValidity()) {
                input.classList.add("is-invalid");
                const feedback = input.closest(".form-group")?.querySelector(".invalid-feedback");
                if (feedback) feedback.classList.add("show");
                isValid = false;
            } else {
                input.classList.remove("is-invalid");
                input.classList.add("is-valid");
                const feedback = input.closest(".form-group")?.querySelector(".invalid-feedback");
                if (feedback) feedback.classList.remove("show");
            }
        });
        return isValid;
    }

    document.querySelectorAll("input[required]").forEach(input => {
        input.addEventListener("input", function () {
            const feedback = this.closest(".form-group")?.querySelector(".invalid-feedback");
            if (this.checkValidity()) {
                this.classList.remove("is-invalid");
                this.classList.add("is-valid");
                if (feedback) feedback.classList.remove("show");
            } else {
                this.classList.add("is-invalid");
                this.classList.remove("is-valid");
                if (feedback) feedback.classList.add("show");
            }
        });
    });

    document.getElementById("passCus").addEventListener("input", function () {
        const password = this.value;
        const strengthFill = document.getElementById("strengthFill");
        const strengthText = document.getElementById("strengthText");
        const checks = [
            password.length >= 8,
            /[A-Z]/.test(password),
            /[a-z]/.test(password),
            /[0-9]/.test(password),
            /[^A-Za-z0-9]/.test(password)
        ];
        const strength = checks.filter(c => c).length;
        const colors = ["#ef4444", "#f97316", "#eab308", "#10b981", "#3b82f6"];
        const widths = ["20%", "40%", "60%", "80%", "100%"];
        const texts = ["Rất yếu", "Yếu", "Trung bình", "Mạnh", "Rất mạnh"];

        if (password.length === 0) {
            strengthFill.style.width = "1%";
            strengthFill.style.backgroundColor = "#e2e8f0";
            strengthText.textContent = "Độ mạnh mật khẩu";
        } else {
            strengthFill.style.width = widths[strength - 1] || "20%";
            strengthFill.style.backgroundColor = colors[strength - 1] || "#ef4444";
            strengthText.textContent = texts[strength - 1] || "Rất yếu";
        }
    });
</script>
