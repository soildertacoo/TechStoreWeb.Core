@model TechStore.Models.Customer
@{
    ViewBag.Title = "Reset Password";
    Layout = "~/Views/Shared/_LogSignLayout.cshtml";
}
<link rel="stylesheet" href="~/Content/bootstrap.min.css" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>
    /* GIỮ NGUYÊN TOÀN BỘ CSS CỦA BẠN - KHÔNG SỬA GÌ Ở ĐÂY VÌ ĐÃ QUÁ ĐẸP */
    :root {
        --primary-color: #6366f1;
        --primary-dark: #4f46e5;
        --success-color: #10b981;
        --danger-color: #ef4444;
        --warning-color: #f59e0b;
        --text-color: #1f2937;
        --text-muted: #6b7280;
        --border-color: #e5e7eb;
        --bg-light: #f8fafc;
    }

    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px 0;
    }

    .reset-container {
        max-width: 480px;
        width: 100%;
        margin: 0 auto;
    }

    .card {
        border: none;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
        overflow: hidden;
        backdrop-filter: blur(10px);
        background: rgba(255, 255, 255, 0.95);
    }

    .card-header {
        background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
        color: white;
        padding: 2rem;
        text-align: center;
        border: none;
    }

        .card-header h2 {
            margin: 0;
            font-weight: 600;
            font-size: 1.75rem;
        }

        .card-header .subtitle {
            margin-top: 0.5rem;
            opacity: 0.9;
            font-size: 0.95rem;
        }

    .card-body {
        padding: 2.5rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
        position: relative;
    }

    .form-label {
        font-weight: 600;
        color: var(--text-color);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .form-control {
        border: 2px solid var(--border-color);
        border-radius: 12px;
        padding: 0.875rem 1rem;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: var(--bg-light);
    }

        .form-control:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
            background: white;
        }

        .form-control.is-invalid {
            border-color: var(--danger-color);
            background-image: none;
        }

    .invalid-feedback {
        display: block;
        margin-top: 0.5rem;
        color: var(--danger-color);
        font-size: 0.875rem;
        font-weight: 500;
    }

    .alert {
        border: none;
        border-radius: 12px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        font-weight: 500;
        display: none; /* Mặc định ẩn để JS xử lý */
    }

    .alert-danger {
        background: rgba(239, 68, 68, 0.1);
        color: var(--danger-color);
        border-left: 4px solid var(--danger-color);
    }

    .alert-success {
        background: rgba(16, 185, 129, 0.1);
        color: var(--success-color);
        border-left: 4px solid var(--success-color);
    }

    .btn-submit {
        background: linear-gradient(135deg, var(--success-color), #059669);
        border: none;
        border-radius: 12px;
        padding: 0.875rem 2rem;
        font-size: 1.1rem;
        font-weight: 600;
        color: white;
        width: 100%;
        transition: all 0.3s ease;
    }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(16, 185, 129, 0.3);
            background: linear-gradient(135deg, #059669, #047857);
        }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--primary-color), var(--primary-dark));
        color: white;
        border: none;
        border-radius: 12px;
        padding: 0.875rem 2rem;
        font-size: 1.1rem;
        font-weight: 600;
        width: 100%;
        transition: all 0.3s ease;
    }

    .btn-primary-custom:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(99, 102, 241, 0.3);
        color: white;
    }

    .password-strength {
        margin-top: 0.75rem;
    }

    .strength-label {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-muted);
        margin-bottom: 0.5rem;
    }

    .strength-bar {
        height: 6px;
        background: var(--border-color);
        border-radius: 3px;
        overflow: hidden;
        position: relative;
    }

    .strength-progress {
        height: 100%;
        width: 1%;
        background: var(--danger-color);
        border-radius: 3px;
        transition: all 0.3s ease;
    }

    .card-footer {
        background: var(--bg-light);
        padding: 1.5rem 2.5rem;
        text-align: center;
        border: none;
        color: var(--text-muted);
    }

        .card-footer a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .card-footer a:hover {
                color: var(--primary-dark);
                text-decoration: underline;
            }

    .icon {
        width: 18px;
        height: 18px;
    }

    /* Floating Shapes */
    .floating-shapes {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: -1;
    }

    .shape {
        position: absolute;
        opacity: 0.1;
        animation: float 20s infinite linear;
    }

        .shape:nth-child(1) { top: 20%; left: 10%; width: 80px; height: 80px; background: white; border-radius: 50%; }
        .shape:nth-child(2) { top: 60%; right: 15%; width: 60px; height: 60px; background: white; transform: rotate(45deg); animation-delay: 5s; }
        .shape:nth-child(3) { bottom: 30%; left: 20%; width: 40px; height: 40px; background: white; clip-path: polygon(50% 0%, 0% 100%, 100% 100%); animation-delay: 10s; }

    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(180deg); }
    }
</style>

<body>
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <div class="reset-container">
        <div class="card">
            <div class="card-header">
                <h2><i class="fas fa-key me-2"></i>Đặt lại mật khẩu</h2>
                <div class="subtitle" id="formSubtitle">Vui lòng nhập Email để tìm kiếm tài khoản</div>
            </div>
            
            <div class="card-body">
                <div id="alertMessage" class="alert"></div>

                <div id="step1-email">
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fas fa-envelope icon"></i>
                            Địa chỉ Email của bạn
                        </label>
                        <input type="email" id="txtEmail" class="form-control" placeholder="Nhập email đã đăng ký..." required />
                        <div class="invalid-feedback" id="emailError">Vui lòng nhập email hợp lệ.</div>
                    </div>
                    <div class="form-group">
                        <button type="button" class="btn-primary-custom" id="btnSendOTP">
                            <i class="fas fa-paper-plane me-1"></i> Gửi mã xác nhận
                        </button>
                    </div>
                </div>

                <div id="step2-otp" style="display: none; text-align: center;">
                    <i class="fas fa-shield-alt fa-3x mb-3" style="color: var(--primary-color);"></i>
                    <h4 style="font-weight: 600; color: var(--text-color);">Xác thực Email</h4>
                    <p style="color: var(--text-muted); margin-bottom: 20px;">Mở hộp thư của bạn để lấy mã 6 số</p>
                    
                    <div class="form-group">
                        <input type="text" id="otpCode" class="form-control" maxlength="6" placeholder="000000" style="letter-spacing: 15px; text-align: center; font-size: 1.5rem; font-weight: bold;" />
                    </div>
                    
                    <div class="form-group d-flex" style="gap: 10px;">
                        <button type="button" class="btn-submit" style="background: #9ca3af;" onclick="window.location.reload()">Hủy</button>
                        <button type="button" class="btn-primary-custom" id="btnVerifyOTP">
                            <i class="fas fa-check-circle me-1"></i> Xác thực
                        </button>
                    </div>
                </div>

                <div id="step3-password" style="display: none;">
                    @using (Html.BeginForm("ResetPassword", "User", FormMethod.Post, new { @id = "resetForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Email" id="hiddenEmail" value="" />

                        <div class="form-group">
                            <label class="form-label">
                                <i class="fas fa-lock icon"></i>
                                Nhập mật khẩu mới
                            </label>
                            @Html.Password("PassCus", null, new { @class = "form-control", required = "required", placeholder = "Nhập mật khẩu mới của bạn", onkeyup = "validatePassword()" })
                            <label class="form-label">
                                <i class="fas fa-lock icon"></i>
                                Nhập lại mật khẩu
                            </label>
                            <input type="password" id="retypePass" class="form-control" placeholder="Xác nhận MK lại để chính xác"/>
                            <div class="password-strength">
                                <div class="strength-label">Độ mạnh mật khẩu</div>
                                <div class="strength-bar">
                                    <div class="strength-progress" id="powerPoint"></div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn-submit" disabled>
                                <i class="fas fa-save me-1"></i> Xác nhận mật khẩu lại
                            </button>
                        </div>
                    }
                </div>

            </div>
            
            <div class="card-footer">
                <i class="fas fa-lightbulb me-1"></i>
                Nhớ mật khẩu rồi ư?
                <a href="@Url.Action("DangNhap", "User")">Đăng nhập ngay</a>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script>
        // Hàm hiển thị thông báo
        function showAlert(message, isSuccess = false) {
            const alertBox = document.getElementById('alertMessage');
            alertBox.className = isSuccess ? 'alert alert-success' : 'alert alert-danger';
            alertBox.innerHTML = isSuccess 
                ? `<i class="fas fa-check-circle me-2"></i>${message}` 
                : `<i class="fas fa-exclamation-triangle me-2"></i>${message}`;
            alertBox.style.display = 'block';
            
            // Tự tắt sau 5s nếu là lỗi
            if(!isSuccess) {
                setTimeout(() => { alertBox.style.display = 'none'; }, 5000);
            }
        }
        document.getElementById('retypePass').addEventListener('input', function () {
            let passInput = document.getElementById('PassCus').value.trim();
            let retypeInput = this.value.trim(); 
            let html = ``;
            const submit = document.querySelector('.btn-submit');

            // Kiểm tra trùng mật khẩu VÀ đảm bảo ô nhập lại không bị bỏ trống
            if (passInput === retypeInput && retypeInput !== "") {
                submit.disabled = false; // ĐÃ FIX: Cách mở khóa nút chuẩn
                html = `<i class="fas fa-save me-1"></i> Lưu mật khẩu mới`;
            }
            else {
                submit.disabled = true;  // ĐÃ FIX: Cách khóa nút chuẩn
                html = `<i class="fas fa-exclamation-triangle me-1"></i> Mật khẩu không khớp`;
            }
            
            submit.innerHTML = html;
        });
        // ==========================
        // BƯỚC 1: GỬI OTP QUA EMAIL
        // ==========================
        document.getElementById('btnSendOTP').addEventListener('click', async function() {
            const emailInput = document.getElementById('txtEmail').value;
            if (!emailInput) {
                showAlert('Vui lòng nhập địa chỉ Email!');
                return;
            }

            // Thay đổi nút thành trạng thái Loading
            const btn = this;
            const originalText = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Đang gửi...';
            btn.disabled = true;

            try {
                // Gọi lên C# để gửi mail (Sửa lại tên Action của bạn nếu khác)
                let response = await fetch(`/User/SendResetOTP?email=${emailInput}`, {
                    method: 'GET',
                    headers: { 'Content-Type': 'application/json' }
                });

                let data = await response.json();

                if (data.success) {
                    // Chuyển sang Bước 2
                    document.getElementById('step1-email').style.display = 'none';
                    document.getElementById('step2-otp').style.display = 'block';
                    document.getElementById('formSubtitle').innerText = 'Nhập mã OTP để xác thực';
                    showAlert('Đã gửi mã OTP đến Email của bạn!', true);
                } else {
                    showAlert(data.message);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (error) {
                showAlert('Lỗi kết nối đến máy chủ!');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        });

        // ==========================
        // BƯỚC 2: XÁC THỰC MÃ OTP
        // ==========================
        document.getElementById('btnVerifyOTP').addEventListener('click', async function() {
            const otpInput = document.getElementById('otpCode').value.trim();
            const emailInput = document.getElementById('txtEmail').value.trim();

            if (otpInput.length !== 6) {
                showAlert("Vui lòng nhập đủ 6 số OTP!");
                return;
            }

            try {
                let response = await fetch('/User/VerifyResetOTP', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                // Giấu kín dữ liệu vào Body, mã hóa thành chuỗi JSON
                body: JSON.stringify({ 
                    emailInput: emailInput, 
                    otpInput: otpInput 
                })
            });

                let data = await response.json();

                if (data.success) {
                    // Chuyển sang Bước 3
                    document.getElementById('step2-otp').style.display = 'none';
                    document.getElementById('step3-password').style.display = 'block';
                    document.getElementById('formSubtitle').innerText = 'Tạo mật khẩu mới cho tài khoản';
                    
                    // Gắn Email vào thẻ ẩn để Submit Form
                    document.getElementById('hiddenEmail').value = emailInput;
                    
                    showAlert('Xác thực thành công! Mời nhập mật khẩu mới.', true);
                } else {
                    showAlert(data.message);
                    document.getElementById('otpCode').value = '';
                }
            } catch (error) {
                showAlert('Lỗi kết nối đến máy chủ!');
            }
        });

        // ==========================
        // KIỂM TRA ĐỘ MẠNH MẬT KHẨU (Giữ nguyên)
        // ==========================
        function validatePassword() {
            var password = document.getElementById("PassCus").value;
            var powerPoint = document.getElementById("powerPoint");
            var minLength = 8;
            var hasUpperCase = /[A-Z]/.test(password);
            var hasLowerCase = /[a-z]/.test(password);
            var hasNumber = /[0-9]/.test(password);
            var hasSpecialChar = /[!#$%^&*(),.?":{}|<>]/.test(password);
            var strength = 0;

            if (password.length >= minLength) strength += 1;
            if (hasUpperCase) strength += 1;
            if (hasLowerCase) strength += 1;
            if (hasNumber) strength += 1;
            if (hasSpecialChar) strength += 1;
            
            switch (strength) {
                case 1:
                    powerPoint.style.width = "25%";
                    powerPoint.style.background = "linear-gradient(90deg, #ef4444, #dc2626)";
                    break;
                case 2:
                    powerPoint.style.width = "50%";
                    powerPoint.style.background = "linear-gradient(90deg, #f59e0b, #d97706)";
                    break;
                case 3:
                    powerPoint.style.width = "60%";
                    powerPoint.style.background = "linear-gradient(90deg, #eab308, #ca8a04)";
                    break;
                case 4:
                    powerPoint.style.width = "75%";
                    powerPoint.style.background = "linear-gradient(90deg, #10b981, #059669)";
                    break;
                case 5:
                    powerPoint.style.width = "100%";
                    powerPoint.style.background = "linear-gradient(90deg, #059669, #047857)";
                    break;
                default:
                    powerPoint.style.width = "1%";
                    powerPoint.style.background = "linear-gradient(90deg, #ef4444, #dc2626)";
                    break;
            }
        }
    </script>
</body>