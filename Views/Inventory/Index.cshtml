@model IEnumerable<TechStore.Models.Inventory>
@using TechStoreWeb.Core.InventoryServices

@{
    ViewData["Title"] = "Quản lý tồn kho";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var lowStockThreshold = (int)(ViewBag.LowStockThreshold ?? InventoryConstants.LowStockThreshold);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-warehouse mr-2"></i> Quản lý tồn kho</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus"></i> Nhập kho mới
    </a>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="thead-light">
            <tr>
                <th>ID</th>
                <th>Sản phẩm</th>
                <th>Số lượng tồn</th>
                <th>Ngày cập nhật</th>
                <th>Ghi chú</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.InventoryID</td>
                    <td>@item.Product?.NamePro</td>
                    <td>
                        <span class="badge @(item.StockQuantity < lowStockThreshold ? "badge-danger" : "badge-success")">
                            @item.StockQuantity
                        </span>
                    </td>
                    <td>@item.LastUpdated.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Note</td>
                    <td>
                        <div class="btn-group">
                            <a asp-action="Details" asp-route-id="@item.InventoryID" class="btn btn-sm btn-primary" title="Chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.InventoryID" class="btn btn-sm btn-info" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.InventoryID" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa bản ghi kho này?');" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
