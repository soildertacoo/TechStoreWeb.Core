@model TechStore.Models.Inventory
@using TechStore.Models
@using TechStoreWeb.Core.InventoryServices

@{
    ViewData["Title"] = "Chi tiết tồn kho";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var summary = ViewBag.StockSummary as InventoryStockSummary;
    var lowStockThreshold = (int)(ViewBag.LowStockThreshold ?? InventoryConstants.LowStockThreshold);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-info-circle mr-2"></i> Chi tiết tồn kho</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.InventoryID" class="btn btn-info">
            <i class="fas fa-edit"></i> Chỉnh sửa
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-lg">
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-4 text-center border-right">
                <h5 class="text-muted mb-3">Hình ảnh sản phẩm</h5>
                <div class="img-thumbnail p-2 bg-light d-inline-block">
                    @if (Model.Product != null && !string.IsNullOrEmpty(Model.Product.ImagePro))
                    {
                        <img src="~/Images/@Model.Product.ImagePro" alt="@Model.Product.NamePro" class="img-fluid rounded" style="max-height: 200px;" />
                    }
                    else
                    {
                        <img src="https://via.placeholder.com/200?text=No+Image" alt="No Image" class="img-fluid rounded" />
                    }
                </div>
                <h4 class="mt-3 text-primary">@Model.Product?.NamePro</h4>
                <p class="text-muted small">Mã SP: @Model.ProductID</p>
            </div>
            <div class="col-md-8">
                <h5 class="text-muted mb-3">Thông tin kho hàng</h5>
                <dl class="row">
                    <dt class="col-sm-4">Số lượng hiện có:</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.StockQuantity < lowStockThreshold ? "badge-danger" : "badge-success") p-2" style="font-size: 1.1em;">
                            @Model.StockQuantity đơn vị
                        </span>
                    </dd>

                    @if (summary != null)
                    {
                        <dt class="col-sm-4">Trạng thái:</dt>
                        <dd class="col-sm-8">
                            <span class="badge @(summary.Status == StockStatus.OutOfStock ? "badge-danger" : summary.Status == StockStatus.LowStock ? "badge-warning" : "badge-success")">
                                @summary.StatusLabel
                            </span>
                        </dd>

                        <dt class="col-sm-4">Đã bán (tham khảo):</dt>
                        <dd class="col-sm-8">@summary.UnitsSold đơn vị</dd>
                    }

                    <dt class="col-sm-4">Cập nhật lần cuối:</dt>
                    <dd class="col-sm-8 text-info font-weight-bold">
                        @Model.LastUpdated.ToString("dd/MM/yyyy HH:mm:ss")
                    </dd>

                    <dt class="col-sm-4">Ghi chú:</dt>
                    <dd class="col-sm-8">
                        @(string.IsNullOrEmpty(Model.Note) ? "Không có ghi chú" : Model.Note)
                    </dd>
                </dl>

                <div class="alert alert-info mt-4">
                    <i class="fas fa-lightbulb mr-2"></i>
                    <strong>Gợi ý:</strong>
                    @if (Model.StockQuantity < lowStockThreshold)
                    {
                        <span>Số lượng sản phẩm trong kho đang ở mức thấp (&lt; @lowStockThreshold). Vui lòng xem xét nhập thêm hàng.</span>
                    }
                    else
                    {
                        <span>Số lượng hàng trong kho hiện tại đang ổn định.</span>
                    }
                </div>
            </div>
        </div>

        <div class="mt-5">
            <h5 class="text-muted mb-3 border-bottom pb-2">
                <i class="fas fa-history mr-2"></i> Lịch sử nhập / xuất / điều chỉnh
            </h5>
            @if (summary?.RecentMovements?.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover border">
                        <thead class="bg-light">
                            <tr>
                                <th>Thời gian</th>
                                <th>Loại</th>
                                <th class="text-center">Thay đổi</th>
                                <th class="text-center">Trước → Sau</th>
                                <th>Ghi chú</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var move in summary.RecentMovements)
                            {
                                var typeLabel = move.MovementType switch
                                {
                                    InventoryMovementType.Import => "Nhập kho",
                                    InventoryMovementType.Export => "Xuất kho",
                                    InventoryMovementType.Adjustment => "Điều chỉnh",
                                    InventoryMovementType.Initial => "Khởi tạo",
                                    _ => "Khác"
                                };
                                var changeClass = move.QuantityChange >= 0 ? "text-success" : "text-danger";
                                var changeSign = move.QuantityChange >= 0 ? "+" : "";
                                <tr>
                                    <td>@move.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@typeLabel</td>
                                    <td class="text-center font-weight-bold @changeClass">@changeSign@move.QuantityChange</td>
                                    <td class="text-center">@move.StockBefore → @move.StockAfter</td>
                                    <td>@(move.Note ?? "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle mr-2"></i> Chưa có lịch sử nhập / xuất / điều chỉnh cho sản phẩm này!
                </div>
            }
        </div>

        @if (ViewBag.SameCategoryProducts != null)
        {
            <div class="mt-5">
                <h5 class="text-muted mb-3 border-bottom pb-2">
                    <i class="fas fa-layer-group mr-2"></i> Danh sách sản phẩm cùng loại: <span class="text-primary">@Model.Product?.Category1?.NameCate</span>
                </h5>
                <div class="table-responsive">
                    <table class="table table-hover border">
                        <thead class="bg-light">
                            <tr>
                                <th>Ảnh</th>
                                <th>Tên sản phẩm</th>
                                <th class="text-center">Số lượng tồn</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in (List<TechStore.Models.Products>)ViewBag.SameCategoryProducts)
                            {
                                <tr class="@(item.ProductID == Model.ProductID ? "table-warning" : "")">
                                    <td style="width: 60px;">
                                        <img src="~/Images/@item.ImagePro" alt="@item.NamePro" class="rounded" style="width: 40px; height: 40px; object-fit: cover;" />
                                    </td>
                                    <td>
                                        @item.NamePro
                                        @if (item.ProductID == Model.ProductID)
                                        {
                                            <span class="badge badge-pill badge-dark ml-2">Đang xem</span>
                                        }
                                    </td>
                                    <td class="text-center font-weight-bold">
                                        @{
                                            var stockInfo = ViewBag.StockInfo as Dictionary<int, int>;
                                            int quantity = (stockInfo != null && stockInfo.ContainsKey(item.ProductID)) ? stockInfo[item.ProductID] : 0;
                                            @quantity
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (quantity <= 0)
                                        {
                                            <span class="badge badge-danger">Hết hàng</span>
                                        }
                                        else if (quantity < lowStockThreshold)
                                        {
                                            <span class="badge badge-warning">Sắp hết</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-success">Sẵn sàng</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
