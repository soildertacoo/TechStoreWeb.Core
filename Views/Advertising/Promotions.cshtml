@model IEnumerable<TechStore.Models.Promotion>

@{
    ViewData["Title"] = "Chương trình khuyến mãi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-percentage mr-2"></i> Chương trình khuyến mãi</h2>
    <div>
        <a asp-action="CreatePromotion" class="btn btn-primary">
            <i class="fas fa-plus"></i> Tạo khuyến mãi mới
        </a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="thead-light">
            <tr>
                <th>Tên chương trình</th>
                <th>Giảm giá (%)</th>
                <th>Thời gian</th>
                <th>Trạng thái</th>
                <th>Áp dụng cho sản phẩm</th>
                <th>Áp dụng cho ngành hàng</th>
                <th>Số lượng</th>
                <th>Mức độ ưu tiên</th>
                <th>Loại Voucher</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td><span class="text-danger font-weight-bold">@item.DiscountPercentage%</span></td>
                    <td>
                        <small>
                            Từ: @item.StartDate.ToString("dd/MM/yyyy")<br />
                            Đến: @item.EndDate.ToString("dd/MM/yyyy")
                        </small>
                    </td>
                    <td>
                        @{
                            var now = DateTime.Now;
                            if (!item.IsActive) { <span class="badge badge-secondary">Tạm dừng</span> }
                            else if (now < item.StartDate) { <span class="badge badge-info">Sắp diễn ra</span> }
                            else if (now > item.EndDate) { <span class="badge badge-danger">Đã kết thúc</span> }
                            else { <span class="badge badge-success">Đang diễn ra</span> }
                        }
                    </td>
                    <td>@(item.ApplyProduct != null ? item.Products?.NamePro : "Tất cả sản phẩm")</td>
                    <td>@(item.ApplyCategory?.Trim() == "ALL" ? "Tất cả ngành hàng" : item.Category1?.NameCate)</td>
                    <td>@item.VoucherLength</td>
                    <td>
                     @if (item.PriorityLength == 1)
                        {
                            <span class="badge bg-secondary">Thấp</span>
                        }
                        else if (item.PriorityLength == 2)
                        {
                            <span class="badge bg-info">Trung bình</span>
                        }
                        else if (item.PriorityLength == 3)
                        {
                            <span class="badge bg-warning">Cao</span>
                        }
                        else 
                        {
                            <span class="badge bg-danger">Rất cao</span>
                        }
                    </td>
                    <td>@item.TypeVoucher</td>
                    <td>
                        <div class="btn-group">
                            <a asp-action="PromotionDetails" asp-route-id="@item.PromotionID" class="btn btn-sm btn-primary" title="Chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="EditPromotion" asp-route-id="@item.PromotionID" class="btn btn-sm btn-info" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="DeletePromotion" asp-route-id="@item.PromotionID" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa chương trình khuyến mãi này?');" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
