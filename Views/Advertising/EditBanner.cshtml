@model TechStore.Models.Banner

@{
    ViewData["Title"] = "Chỉnh sửa Banner";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-edit mr-2"></i> Chỉnh sửa Banner</h2>
    <a asp-action="Banners" class="btn btn-secondary">
        <i class="fas fa-arrow-left"></i> Quay lại danh sách
    </a>
</div>

<div class="card shadow-sm border-0 rounded-lg">
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-7">
                <form asp-action="EditBanner" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="BannerID" />
                    <input type="hidden" asp-for="CreatedDate" />
                    <input type="hidden" asp-for="LinkUrl" />

                    <div class="form-group mb-3">
                        <label asp-for="Title" class="control-label font-weight-bold"></label>
                        <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề banner" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="ImageUrl" class="control-label font-weight-bold"></label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-image"></i></span>
                            </div>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://example.com/image.jpg" />
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        <small class="form-text text-muted">Đường dẫn hình ảnh từ internet hoặc thư mục Images.</small>
                    </div>

                    <div class="alert alert-info mb-3">
                        Chọn <b>1 trong 2</b>:
                        <br />
                         • Danh mục → Banner mở toàn bộ sản phẩm của danh mục.
                         <br />
                         • Sản phẩm → Banner mở các sản phẩm cùng loại.
                    </div>

                    <div class="form-group mb-3">
                        <label>Danh mục</label>

                        <select asp-for="CategoryID"
                                asp-items="ViewBag.Categories"
                                class="form-control">
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label>Sản phẩm</label>
                        <select asp-for="ProductID"
                                asp-items="ViewBag.Products"
                                class="form-control">
                            <option value="">-- Chọn sản phẩm --</option>
                        </select>
                    </div>


                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="DisplayOrder" class="control-label font-weight-bold"></label>
                                <input asp-for="DisplayOrder" class="form-control" type="number" />
                                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6 d-flex align-items-center mt-4">
                            <div class="form-group form-check">
                                <label class="form-check-label">
                                    <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                                </label>
                            </div>
                        </div>
                    </div>

                    <hr />

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="StartDate" class="control-label font-weight-bold"></label>
                                <input asp-for="StartDate" class="form-control" type="datetime-local" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group mb-3">
                                <label asp-for="EndDate" class="control-label font-weight-bold"></label>
                                <input asp-for="EndDate" class="form-control" type="datetime-local" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group mt-4">
                        <button type="submit" class="btn btn-primary px-4 py-2">
                            <i class="fas fa-save mr-1"></i> Cập nhật Banner
                        </button>
                    </div>
                </form>
            </div>
            <div class="col-md-5 d-flex flex-column align-items-center justify-content-center border-left">
                <h5 class="text-muted mb-3">Xem trước ảnh hiện tại</h5>
                <div class="img-thumbnail p-2 bg-light shadow-sm">
                    <img id="imagePreview" src="@Model.ImageUrl" alt="Preview" class="img-fluid rounded" style="max-height: 250px;" onerror="this.src='https://via.placeholder.com/300x150?text=Lỗi+ảnh'" />
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#ImageUrl').on('input', function() {
                var url = $(this).val();
                if (url) {
                    $('#imagePreview').attr('src', url);
                }
            });
        });
    </script>
    
    <script>
        $(function () {
            $("#ProductID").change(function () {
                if($(this).val()!=""){
                    $("#CategoryID").val("");
                }
            });
        });

        $(function () {
            $("#CategoryID").change(function () {
                if($(this).val()!=""){
                    $("#ProductID").val("");
                }
            });
        });
    </script>
}
