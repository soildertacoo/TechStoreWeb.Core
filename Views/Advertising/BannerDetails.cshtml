@model TechStore.Models.Banner

@{
    ViewData["Title"] = "Chi tiết Banner";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-info-circle mr-2"></i> Chi tiết Banner</h2>
    <div>
        <a asp-action="EditBanner" asp-route-id="@Model.BannerID" class="btn btn-info">
            <i class="fas fa-edit"></i> Chỉnh sửa
        </a>
        <a asp-action="Banners" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-lg">
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-6 mb-4 mb-md-0 text-center">
                <h5 class="text-muted mb-3">Hình ảnh hiển thị</h5>
                <div class="img-thumbnail p-2 bg-light d-inline-block">
                    <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid rounded" style="max-height: 400px;" />
                </div>
            </div>
            <div class="col-md-6">
                <h5 class="text-muted mb-3">Thông tin chi tiết</h5>
                <dl class="row">
                    <dt class="col-sm-4">Tiêu đề:</dt>
                    <dd class="col-sm-8 font-weight-bold text-primary">@Model.Title</dd>

                    <dt class="col-sm-4">Đường dẫn ảnh:</dt>
                    <dd class="col-sm-8 text-break"><a href="@Model.ImageUrl" target="_blank">@Model.ImageUrl</a></dd>

                    <dt class="col-sm-4">Liên kết:</dt>
                    <dd class="col-sm-8 text-break">
                        @if (!string.IsNullOrEmpty(Model.LinkUrl))
                        {
                            <a href="@Model.LinkUrl" target="_blank">@Model.LinkUrl</a>
                        }
                        else
                        {
                            <span class="text-muted">Không có liên kết</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Thứ tự hiển thị:</dt>
                    <dd class="col-sm-8">@Model.DisplayOrder</dd>

                    <dt class="col-sm-4">Trạng thái:</dt>
                    <dd class="col-sm-8">
                        <span class="badge @(Model.IsActive ? "badge-success" : "badge-secondary") p-2">
                            @(Model.IsActive ? "Đang hoạt động" : "Tạm dừng")
                        </span>
                    </dd>

                    <dt class="col-sm-4">Ngày tạo:</dt>
                    <dd class="col-sm-8">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
