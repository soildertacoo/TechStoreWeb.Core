@model IEnumerable<TechStore.Models.Banner>

@{
    ViewData["Title"] = "Quản lý Banner";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-images mr-2"></i> Quản lý Banner</h2>
    <div>
        <a asp-action="CreateBanner" class="btn btn-primary">
            <i class="fas fa-plus"></i> Thêm Banner mới
        </a>
        <a asp-action="Promotions" class="btn btn-outline-info ml-2">
            <i class="fas fa-percentage"></i> Quản lý Khuyến mãi
        </a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="thead-light">
            <tr>
                <th>Ảnh</th>
                <th>Tiêu đề</th>
                <th>Thứ tự</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.ImageUrl" alt="@item.Title" style="width: 100px; height: auto; border-radius: 4px;" />
                    </td>
                    <td>@item.Title</td>
                    <td>@item.DisplayOrder</td>
                    <td>
                        <span class="badge @(item.IsActive ? "badge-success" : "badge-secondary")">
                            @(item.IsActive ? "Hoạt động" : "Tạm dừng")
                        </span>
                    </td>
                    <td>
                        <div class="btn-group">
                            <a asp-action="BannerDetails" asp-route-id="@item.BannerID" class="btn btn-sm btn-primary" title="Xem chi tiết">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="EditBanner" asp-route-id="@item.BannerID" class="btn btn-sm btn-info" title="Chỉnh sửa">
                                <i class="fas fa-edit"></i> Sửa
                            </a>
                            <form asp-action="DeleteBanner" asp-route-id="@item.BannerID" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa banner này không?');" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
