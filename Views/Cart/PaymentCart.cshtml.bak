@model TechStore.Models.Payment
@{
    ViewBag.Title = "Thanh toán đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body {
        margin: 0; padding: 0; overflow-x: hidden;
    }
    .payment-container {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh; width: 100%; padding: 50px 0; box-sizing: border-box;
    }
    .payment-wrapper {
        max-width: 1400px; margin: 0 auto; padding: 0 25px;
    }
    .payment-header {
        text-align: center; margin-bottom: 50px;
    }
    .payment-title {
        color: white; font-size: 2.5rem; font-weight: 700; margin-bottom: 10px; text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }
    .payment-subtitle {
        color: rgba(255,255,255,0.8); font-size: 1.1rem; margin-bottom: 0;
    }
    .modern-card {
        background: white; border-radius: 24px; box-shadow: 0 25px 50px rgba(0,0,0,0.12); border: none; overflow: hidden; transition: all 0.3s ease; margin-bottom: 35px;
    }
    .modern-card:hover {
        transform: translateY(-5px); box-shadow: 0 30px 60px rgba(0,0,0,0.15);
    }
    .card-header-modern {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px 35px; position: relative; overflow: hidden;
    }
    .card-header-modern h4 {
        margin: 0; font-size: 1.5rem; font-weight: 600; position: relative; z-index: 1;
    }
    .card-header-modern .icon {
        position: absolute; right: 30px; top: 50%; transform: translateY(-50%); font-size: 1.5rem; opacity: 0.7;
    }
    .card-body-modern {
        padding: 40px 35px;
    }
    .form-group-modern {
        margin-bottom: 30px; position: relative;
    }
    .form-control-modern {
        border: 2px solid #e8ecf4; border-radius: 12px; padding: 15px 20px; font-size: 1rem; transition: all 0.3s ease; background: #f8f9fc; width: 100%; box-sizing: border-box;
    }
    .form-control-modern:focus {
        border-color: #667eea; box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1); background: white; outline: none;
    }
    .form-label-modern {
        font-weight: 600; color: #2d3748; margin-bottom: 8px; display: block; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.5px;
    }
    .user-info-display {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white; padding: 20px; border-radius: 15px; margin-bottom: 25px; text-align: center;
    }
    .user-info-display strong {
        font-size: 1.1rem; display: block; margin-bottom: 5px;
    }
    .address-grid, .address-grid-full {
        display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 15px;
    }
    .Products-table {
        background: white; border-radius: 15px; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.05); margin-bottom: 25px;
    }
    .Products-table table {
        width: 100%; margin: 0; border-collapse: collapse;
    }
    .Products-table thead {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;
    }
    .Products-table th {
        padding: 20px 15px; font-weight: 600; text-align: left; font-size: 0.9rem;
    }
    .Products-table td {
        padding: 20px 15px; border-bottom: 1px solid #f1f5f9; vertical-align: middle; color: #2d3748;
    }
    .btn-delete {
        background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%); color: white; padding: 8px 16px; border-radius: 20px; font-size: 0.8rem; text-decoration: none; display: inline-block;
    }
    .total-amount {
        background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%); color: white; padding: 20px; border-radius: 15px; text-align: center; margin-bottom: 25px; font-size: 1.3rem; font-weight: 700;
    }
    .payment-method-select select {
        appearance: none; background: white url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6,9 12,15 18,9"/></svg>') no-repeat right 20px center; background-size: 20px; padding-right: 50px;
    }
    .btn-payment {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; border: none; padding: 18px 40px; border-radius: 50px; font-size: 1.1rem; font-weight: 600; width: 100%; text-transform: uppercase; cursor: pointer; transition: transform 0.3s;
    }
    .btn-payment:hover {
        transform: translateY(-3px); box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
    }
    .progress-steps {
        display: flex; justify-content: center; margin-bottom: 50px;
    }
    .step {
        display: flex; align-items: center; color: rgba(255,255,255,0.6); font-weight: 500;
    }
    .step.active { color: white; }
    .step-number {
        width: 30px; height: 30px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; margin-right: 10px; font-weight: 600;
    }
    .step.active .step-number {
        background: white; color: #667eea;
    }
    .step-divider {
        width: 50px; height: 2px; background: rgba(255,255,255,0.2); margin: 0 20px;
    }
    
    /* --- CSS CHO BÁO LỖI (VALIDATION) --- */
    .text-danger {
        color: #ef4444; font-size: 0.85rem; font-style: italic; margin-top: 8px; display: block; animation: fadeIn 0.3s ease;
    }
    .input-validation-error {
        border-color: #ef4444 !important; background-color: #fef2f2 !important;
    }
  
</style>

<div class="payment-container">
    <div class="payment-wrapper">
        <div class="payment-header">
            <h1 class="payment-title">Thanh Toán</h1>
            <p class="payment-subtitle">Hoàn tất đơn hàng của bạn</p>
        </div>

        <div class="progress-steps">
            <div class="step">
                <div class="step-number">1</div><span>Giỏ hàng</span>
            </div>
            <div class="step-divider"></div>
            <div class="step active">
                <div class="step-number">2</div><span>Thanh toán</span>
            </div>
            <div class="step-divider"></div>
            <div class="step">
                <div class="step-number">3</div><span>Hoàn tất</span>
            </div>
        </div>

        @using (Html.BeginForm("PaymentCart", "Cart", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            
            @Html.ValidationSummary(true, "", new { @class = "text-danger", style = "text-align:center; font-size:1.2rem; margin-bottom:20px; font-weight:bold;" })

            <div class="row">
                <div class="col-lg-7">
                    <div class="modern-card">
                        <div class="card-header-modern">
                            <h4>Thông tin khách hàng</h4>
                            <div class="icon">👤</div>
                        </div>
                        
                        <div class="card-body-modern">
                            @Html.HiddenFor(model => model.Customers.IDCus)

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <div class="user-info-display">
                                    <strong>@User.Identity.Name</strong>
                                </div>
                            }
                            
                            <div class="form-group-modern">
                                @Html.LabelFor(model => model.Customers.NameCus, "Tên khách hàng", new { @class = "form-label-modern" })
                                @Html.TextBoxFor(model => model.Customers.NameCus, new { @class = "form-control-modern", placeholder = "Nhập tên đầy đủ" })
                                @Html.ValidationMessageFor(model => model.Customers.NameCus, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group-modern">
                                @Html.LabelFor(model => model.Customers.PhoneCus, "Số điện thoại", new { @class = "form-label-modern" })
                                @Html.TextBoxFor(model => model.Customers.PhoneCus, new { @class = "form-control-modern", placeholder = "Nhập số điện thoại" })
                                @Html.ValidationMessageFor(model => model.Customers.PhoneCus, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group-modern">
                                @Html.LabelFor(model => model.Customers.EmailCus, "Email", new { @class = "form-label-modern" })
                                @Html.TextBoxFor(model => model.Customers.EmailCus, new { @class = "form-control-modern", placeholder = "Nhập địa chỉ email" })
                                @Html.ValidationMessageFor(model => model.Customers.EmailCus, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group-modern">
                                <label class="form-label-modern">Địa chỉ giao hàng</label>
                                <div class="address-grid">
                                    @Html.TextBoxFor(model => model.Customers.StreetAddress, new { @class = "form-control-modern", placeholder = "Số nhà, tên đường" })
                                </div>
                                @Html.ValidationMessageFor(model => model.Customers.StreetAddress, "", new { @class = "text-danger", style="margin-bottom: 10px;" })
                                
                                <div class="form-col">
                                    <div class="enhanced-form-group">
                                        @Html.LabelFor(model => model.Customers.City, "Tỉnh/Thành phố", new { @class = "enhanced-label form-label-modern" })
                                        <div style="position: relative;">
                                            <select id="province" name="Customers.City" class="form-control-modern" required>
                                                @if (!string.IsNullOrEmpty(Model.Customers.City))
                                                {
                                                    <option value="@Model.Customers.City" selected>@Model.Customers.City</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected disabled>-- Chọn Tỉnh/Thành phố --</option>
                                                }
                                            </select>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Customers.City, "", new { @class = "text-danger" })
                                    </div>
                                </div>

                                <div class="form-col mt-3">
                                    <div class="enhanced-form-group">
                                        @Html.LabelFor(model => model.Customers.Ward, "Phường/Xã/Quận", new { @class = "enhanced-label form-label-modern" })
                                        <div style="position: relative;">
                                            <select id="ward" name="Customers.Ward" class="form-control-modern" required>
                                                @if (!string.IsNullOrEmpty(Model.Customers.Ward))
                                                {
                                                    <option value="@Model.Customers.Ward" selected>@Model.Customers.Ward</option>
                                                }
                                                else
                                                {
                                                    <option value="" selected disabled>-- Vui lòng chọn Tỉnh/Thành trước --</option>
                                                }
                                            </select>
                                        </div>
                                        @Html.ValidationMessageFor(model => model.Customers.Ward, "", new { @class = "text-danger" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div> 

                <div class="col-lg-5">
                    <div class="modern-card">
                        <div class="card-header-modern">
                            <h4>Đơn hàng của bạn</h4>
                            <div class="icon">🛒</div>
                        </div>
                        
                        <div class="card-body-modern">
                            <div class="Products-table">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th>SL</th>
                                            <th>Giá</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.mycart)
                                        {
                                            <tr>
                                                <td><strong>@item.NamePro</strong></td>
                                                <td>@item.Number</td>
                                                <td>
                                                    <strong>@string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", item.Price)</strong>
                                                    <br><small style="color: #666;">/ sp</small>
                                                </td>
                                                <td>
                                                    @Html.ActionLink("Xóa", "RemoveFromCart", new { id = @item.ProductID }, new { @class = "btn-delete" })
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="payment-method-select form-group-modern mb-4">
                                <label class="form-label-modern">Phương thức vận chuyển <span class="text-danger">*</span></label>
                                <select id="shippingProvider" name="ShippingProvider" class="form-control-modern" required>
                                    <option value="" disabled selected>-- Vui lòng chọn ĐVVC  --</option>
                                </select>
                                <select id="shippingMethod" name="ShippingMethod" class="form-control-modern" required>
                                    <option value="" disabled selected>-- Vui lòng chọn phương thức ĐVVC  --</option>
                                </select>
                            </div>

                            <div class="total-amount" style="text-align: left;">
                                <div class="d-flex justify-content-between mb-2" style="font-size: 1.1rem; font-weight: 500;">
                                    <span>Tạm tính:</span>
                                    <span id="subTotalDisplay">@string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", ViewBag.Total)</span>
                                </div>
                                <div class="d-flex justify-content-between mb-3" style="font-size: 1.1rem; font-weight: 500;">
                                    <span>Phí vận chuyển:</span>
                                    <span id="shippingFeeDisplay">0 ₫</span>
                                </div>
                                <hr style="border-color: rgba(255,255,255,0.3); border-width: 2px; margin: 15px 0;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span style="font-size: 1.1rem;">Tổng thanh toán:</span>
                                    <span id="finalTotalDisplay" style="font-size: 1.5rem; font-weight: 800;">@string.Format(new System.Globalization.CultureInfo("vi-VN"), "{0:C0}", ViewBag.Total)</span>
                                </div>
                                
                                <input type="hidden" id="hiddenShippingFee" name="Order.ShippingFee" value="0">
                            </div>
                            <div class="payment-method-select form-group-modern">
                                <label class="form-label-modern">Phương thức thanh toán</label>
                                @Html.DropDownListFor(model => model.Order.PaymentMethod, new SelectList(new List<SelectListItem>
                                {
                                    new SelectListItem { Text = "💵 Thanh toán khi nhận hàng (COD)", Value = "2" },
                                    new SelectListItem { Text = "💳 Thanh toán qua thẻ ATM / Visa", Value = "1" }
                                }, "Value", "Text"), new { @class = "form-control-modern" })
                            </div>

                            <button type="submit" class="btn-payment">Xác nhận thanh toán</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            
            // --- 1. BIẾN TOÀN CỤC & HÀM FORMAT TIỀN ---
            const baseTotal = parseFloat('@ViewBag.Total') || 0; 
            const formatVND = (amount) => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount);
            
            
            // Dùng Select để bóc tách đúng các cột cần thiết, dùng câu lệnh Razor từ html vào javascript 
            const providersData = @Html.Raw(Json.Serialize(Model.Providers?.Select(p => new {
                code = p.ProviderCode,
                name = p.ProviderName,
                supportStandard = p.SupportStandard, priceStandard = p.PriceStandard,
                supportFast = p.SupportFast, priceFast = p.PriceFast,
                supportExpress = p.SupportExpress, priceExpress = p.PriceExpress
            })));
            
            const provinceSelect = document.getElementById('province');
            const wardSelect = document.getElementById('ward');
            const shippingProvider = document.getElementById('shippingProvider');
            const shippingMethod = document.getElementById('shippingMethod');
        
           
            // --- 4. GỌI API ĐỊA CHỈ & XÂY DỰNG DANH SÁCH SHIP ---
            await loadAddressData();

            async function loadAddressData() {
                try {
                    const res = await fetch("https://cdn.jsdelivr.net/gh/giaodienblog/cdn@master/provinces-database.json");
                    const data = await res.json();
                    
                    const currentCity = '@Html.Raw(Model.Customers.City)';
                    
                    // 4.1. Đổ dữ liệu Tỉnh/Thành
                    data.forEach(p => {
                        const opt = document.createElement("option");
                        const name = p.Name || p.FullName || p.name;
                        
                        opt.value = name; 
                        opt.textContent = name;
                        opt.setAttribute('data-code', p.Code || p.code); 
                        
                        if (name !== currentCity) {
                            provinceSelect.appendChild(opt);
                        }
                    });

                    // --- SỰ KIỆN 1: KHI KHÁCH ĐỔI TỈNH/THÀNH PHỐ ---
                    provinceSelect.addEventListener("change", () => {
                        
                        // 1. Đổ lại Phường/Xã
                        wardSelect.innerHTML = '<option value="" selected disabled>-- Chọn Phường/Xã/Quận --</option>';
                        const selectedOption = provinceSelect.options[provinceSelect.selectedIndex];
                        const provinceCode = selectedOption.getAttribute('data-code');
                        
                        const prov = data.find(p => (p.Code || p.code) == provinceCode);
                        if (prov && prov.Wards) {
                            prov.Wards.forEach(w => {
                                const o = document.createElement("option");
                                const wardName = (w.AdministrativeUnitShortName ? w.AdministrativeUnitShortName + " " : "") + (w.Name || w.FullName || w.name);
                                o.value = wardName; o.textContent = wardName;
                                wardSelect.appendChild(o);
                            });
                        }

                        // 2. Mở khóa và nạp danh sách Đơn vị vận chuyển
                        shippingProvider.innerHTML = '<option value="" disabled selected>-- Chọn Đơn vị vận chuyển --</option>';
                        shippingProvider.disabled = false; // Mở khóa
                        
                        // Khóa lại ô Gói cước (bắt người dùng phải chọn ĐVVC mới)
                        shippingMethod.innerHTML = '<option value="" disabled selected>-- Vui lòng chọn ĐVVC trước --</option>';
                        shippingMethod.disabled = true;

                        // Đổ danh sách ĐVVC từ Database vào (Chỉ lấy Tên và Code)
                        providersData.forEach(provider => {
                            shippingProvider.insertAdjacentHTML('beforeend', 
                                `<option value="${provider.code}">${provider.name}</option>`
                            );
                        });
                        
                        // Reset lại tiền ship về 0 vì chưa chọn gói cước
                        calculateFinalTotal();
                    });

                    // --- SỰ KIỆN 2: KHI KHÁCH CHỌN ĐƠN VỊ VẬN CHUYỂN ---
                    shippingProvider.addEventListener("change", function() {
                        
                        // Lấy mã ĐVVC khách vừa chọn (VD: GHN)
                        const providerCode = this.value;
                        
                        // Tìm thông tin chi tiết của ĐVVC đó trong mảng providersData
                        const provider = providersData.find(p => p.code === providerCode);
                        
                        // Mở khóa và làm sạch ô Chọn Gói cước
                        shippingMethod.innerHTML = '<option value="" disabled selected>-- Chọn gói cước vận chuyển --</option>';
                        shippingMethod.disabled = false;
                        
                        // Kiểm tra xem khách có đang ở thành phố lớn không
                        const selectedCityName = provinceSelect.value;
                        const bigCityVN = ['Hồ Chí Minh', 'Hà Nội', 'Hải Phòng', 'Huế', 'Cần Thơ', 'Đồng Nai', 'Đà Nẵng'];
                        const isBigCity = bigCityVN.includes(selectedCityName); //trả true hay false 

                        // Bắt đầu đổ các gói cước tương ứng của ĐVVC đó vào
                        if (provider) {
                            if (provider.supportStandard) {
                                shippingMethod.insertAdjacentHTML('beforeend', 
                                    `<option value="Standard" data-fee="${provider.priceStandard}">Giao tiêu chuẩn: ${formatVND(provider.priceStandard)}</option>`
                                );
                            }
                            
                            if (provider.supportFast) {
                                shippingMethod.insertAdjacentHTML('beforeend', 
                                    `<option value="Fast" data-fee="${provider.priceFast}">Giao nhanh: ${formatVND(provider.priceFast)}</option>`
                                );
                            }
                            
                            if (provider.supportExpress && isBigCity) {
                                shippingMethod.insertAdjacentHTML('beforeend', 
                                    `<option value="Express" data-fee="${provider.priceExpress}">Hỏa tốc (2H): ${formatVND(provider.priceExpress)}</option>`
                                );
                            }
                        }
                    });
                    shippingMethod.addEventListener('change', calculateFinalTotal);
                                        

                } catch (error) {
                    console.error("Lỗi tải dữ liệu địa chỉ:", error);
                }
            }
            function calculateFinalTotal() {
                let shippingFee = 0;
                if (shippingMethod.selectedIndex > 0) {
                    const selectedOption = shippingMethod.options[shippingMethod.selectedIndex];
                    shippingFee = parseFloat(selectedOption.getAttribute('data-fee')) || 0;
                }

                const finalTotal = baseTotal + shippingFee;

                document.getElementById('shippingFeeDisplay').innerText = shippingFee > 0 ? formatVND(shippingFee) : '0 ₫';
                document.getElementById('finalTotalDisplay').innerText = formatVND(finalTotal);
                document.getElementById('hiddenShippingFee').value = shippingFee;
            }
        });
    </script>
}