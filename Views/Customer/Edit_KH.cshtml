@model TechStore.Models.Customer

@{
    ViewBag.Title = "Chỉnh sửa thông tin";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string ? errorMessage = TempData["Loi"] as string; 
    string defaultDOB = (Model != null && Model.DateOfBirth != null) 
                        ? Convert.ToDateTime(Model.DateOfBirth).ToString("dd-MM-yyyy") 
                        : "01-01-2000";
}   

<style>
    /* --- RESET TỔNG THỂ VỀ CLEAN UI --- */
    body {
        background-color: #f3f4f6;
        color: #1f2937;
    }

    .edit-customer-container {
        padding: 40px 0 80px 0;
        min-height: calc(100vh - 200px);
    }

    .form-card {
        background: #ffffff;
        border-radius: 20px;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
        padding: 40px;
        margin: 0 auto;
        max-width: 850px;
        border: 1px solid #e5e7eb;
        animation: fadeInUp 0.6s ease-out;
    }

    .page-title {
        color: #111827;
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 35px;
        position: relative;
    }

    /* --- PHÂN KHU THÔNG TIN --- */
    .form-section {
        background: #fafafa;
        padding: 25px 30px;
        border-radius: 16px;
        margin-bottom: 30px;
        border: 1px solid #f3f4f6;
    }

    .section-title {
        color: #374151;
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        padding-bottom: 12px;
        border-bottom: 2px dashed #e5e7eb;
    }

    .section-icon {
        margin-right: 10px;
        color: #2563eb;
        background: #eff6ff;
        padding: 8px;
        border-radius: 8px;
        font-size: 1.1rem;
    }

    /* --- Ô NHẬP LIỆU (INPUT) --- */
    .enhanced-form-group {
        margin-bottom: 20px;
        position: relative;
    }

    .enhanced-label {
        color: #4b5563;
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
        font-size: 0.95rem;
    }

    .enhanced-input, .form-control-modern {
        width: 100%;
        padding: 12px 16px 12px 42px; /* Chừa chỗ cho icon bên trái */
        border: 1px solid #d1d5db;
        border-radius: 10px;
        font-size: 1rem;
        transition: all 0.2s ease;
        background: #ffffff;
        color: #1f2937;
        box-sizing: border-box;
    }

    .enhanced-input:focus, .form-control-modern:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.15);
        outline: none;
    }

    .input-icon-left {
        position: absolute;
        left: 15px;
        top: 50%; /* Căn giữa tự động tuyệt đối theo chiều dọc */
        transform: translateY(-50%);
        color: #9ca3af;
        pointer-events: none;
        z-index: 2; /* Đảm bảo icon nằm trên input */
    }

    .icon-wrapper-select {
        position: relative;
    }

    /* --- CHIA CỘT --- */
    .form-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    /* --- KHU VỰC BẢN ĐỒ --- */
    .map-action-box {
        background: #eff6ff;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 25px;
        border: 1px dashed #93c5fd;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }
    
    .map-action-text h4 {
        color: #1e40af;
        margin: 0 0 5px 0;
        font-size: 1.05rem;
        font-weight: 600;
    }
    .map-action-text p {
        color: #3b82f6;
        margin: 0;
        font-size: 0.85rem;
    }

    .btn-map {
        background: #2563eb;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        border: none;
        transition: all 0.2s;
        white-space: nowrap;
    }
    .btn-map:hover {
        background: #1d4ed8;
        transform: translateY(-2px);
    }

    /* --- NÚT SUBMIT CHÍNH --- */
    .submit-container {
        text-align: center;
        margin-top: 30px;
    }

    .btn-submit-main {
        background: #2563eb;
        color: white;
        padding: 14px 40px;
        border: none;
        border-radius: 10px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.2);
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .btn-submit-main:hover {
        background: #1d4ed8;
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.3);
    }

    /* --- THÔNG BÁO LỖI --- */
    .text-danger {
        color: #ef4444 !important;
        font-size: 0.85rem;
        margin-top: 5px;
        display: block;
    }
    .alert-enhanced {
        background: #fef2f2;
        color: #b91c1c;
        padding: 15px 20px;
        border-radius: 10px;
        margin-bottom: 25px;
        border: 1px solid #fecaca;
    }

    /* --- RESPONSIVE --- */
    @@media (max-width: 768px) {
        .form-card { padding: 25px 20px; }
        .form-grid-2 { grid-template-columns: 1fr; gap: 0; }
        .map-action-box { flex-direction: column; text-align: center; }
        .btn-map { width: 100%; }
        .btn-submit-main { width: 100%; justify-content: center;}
    }
</style>

<div class="edit-customer-container">
    <div class="container">
        <div class="form-card">
            
            <h2 class="page-title">Cập nhật hồ sơ</h2>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-enhanced">
                    <i class="fas fa-exclamation-triangle" style="margin-right: 8px;"></i>
                    @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm("Edit_KH", "Customer", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.IDCus)
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                <div class="form-section">
                    <h3 class="section-title">
                        <i class="fas fa-user section-icon"></i> Thông tin cá nhân
                    </h3>
                    
                    <div class="enhanced-form-group">
                        @Html.LabelFor(model => model.NameCus, "Họ và tên", new { @class = "enhanced-label" })
                        <div style="position: relative;">
                            <i class="fas fa-id-card input-icon-left"></i>
                            @Html.EditorFor(model => model.NameCus, new { htmlAttributes = new { @class = "enhanced-input", @placeholder = "Nhập họ và tên đầy đủ" } })
                        </div>
                        @Html.ValidationMessageFor(model => model.NameCus, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-grid-2">
                        <div class="enhanced-form-group">
                            @Html.LabelFor(model => model.PhoneCus, "Số điện thoại", new { @class = "enhanced-label" })
                            <div style="position: relative;">
                                <i class="fas fa-phone-alt input-icon-left"></i>
                                @Html.EditorFor(model => model.PhoneCus, new { htmlAttributes = new { @class = "enhanced-input", @placeholder = "VD: 0912345678" } })
                            </div>
                            @Html.ValidationMessageFor(model => model.PhoneCus, "", new { @class = "text-danger" })
                        </div>

                        <div class="enhanced-form-group">
                            @Html.LabelFor(model => model.EmailCus, "Email liên hệ", new { @class = "enhanced-label" })
                            <div style="position: relative;">
                                <i class="fas fa-envelope input-icon-left"></i>
                                @Html.EditorFor(model => model.EmailCus, new { htmlAttributes = new { @class = "enhanced-input", @placeholder = "email@domain.com" } })
                            </div>
                            @Html.ValidationMessageFor(model => model.EmailCus, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="enhanced-form-group">
                        @Html.LabelFor(model => model.DateOfBirth, "Ngày sinh", new { @class = "enhanced-label" })
                        <div style="position: relative;">
                            <i class="fas fa-calendar-alt input-icon-left"></i>
                            <input type="text" id="DateOfBirth" name="dateOBirth" class="enhanced-input" value="@defaultDOB" />
                        </div>
                        @Html.ValidationMessageFor(model => model.DateOfBirth, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="section-title">
                        <i class="fas fa-map-marker-alt section-icon"></i> Địa chỉ giao hàng
                    </h3>
                    
                    <div class="map-action-box">
                        <div class="map-action-text">
                            <h4><i class="fas fa-map-marked-alt"></i> Trợ lý bản đồ</h4>
                            <p>Kéo thả ghim trên bản đồ để tự động điền địa chỉ chính xác nhất.</p>
                        </div>
                        <button type="button" id="btn-open-map" class="btn-map">
                            Mở bản đồ ngay
                        </button>
                    </div>

                    <div id="map-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 9999; backdrop-filter: blur(5px);">
                        <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: #fff; padding: 25px; border-radius: 15px; width: 90%; max-width: 800px; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
                            <h4 style="margin-top: 0; color: #1f2937; font-weight: 700; border-bottom: 1px solid #e5e7eb; padding-bottom: 15px;">
                                <i class="fas fa-map-pin" style="color: #ef4444; margin-right: 5px;"></i> Di chuyển ghim để chọn vị trí
                            </h4>
                            <div id="google-map" style="width: 100%; height: 400px; border-radius: 10px; margin: 15px 0; border: 1px solid #e5e7eb;"></div>
                            <p style="font-weight: 600; color: #374151;">Đang chọn: <span id="map-selected-address" style="color: #2563eb; font-weight: 500;">Đang tải...</span></p>
                            
                            <div style="text-align: right; margin-top: 20px;">
                                <button type="button" id="btn-close-map" style="padding: 10px 20px; border: none; background: #f3f4f6; color: #4b5563; border-radius: 8px; cursor: pointer; margin-right: 10px; font-weight: 600;">Đóng</button>
                                <button type="button" id="btn-confirm-map" class="btn-map">Xác nhận vị trí</button>
                            </div>
                        </div>
                    </div>
                    
                    @await Html.PartialAsync(partialViewName: "~/Views/_mapViewPartial.cshtml")
                    
                    <div class="enhanced-form-group">
                        @Html.LabelFor(model => model.StreetAddress, "Số nhà, Tên đường", new { @class = "enhanced-label" })
                        <div style="position: relative;">
                            <i class="fas fa-home input-icon-left"></i>
                            @Html.EditorFor(model => model.StreetAddress, new { htmlAttributes = new { @class = "enhanced-input", @placeholder = "VD: 123 Đường Lê Lợi" } })
                        </div>
                        @Html.ValidationMessageFor(model => model.StreetAddress, "", new { @class = "text-danger" })
                    </div>
                    
                    <div class="form-grid-2">
                        <div class="enhanced-form-group">
                            @Html.LabelFor(model => model.City, "Tỉnh/Thành phố", new { @class = "enhanced-label" })
                            <div class="icon-wrapper-select">
                                <i class="fas fa-city input-icon-left"></i>
                                <select id="province" name="City" class="form-control-modern" required style="padding-left: 42px;">
                                    @if (!string.IsNullOrEmpty(Model.City))
                                    {
                                        <option value="@Model.City" selected>@Model.City</option>
                                    }
                                    else
                                    {
                                        <option value="" selected disabled>-- Chọn Tỉnh/Thành --</option>
                                    }
                                </select>
                            </div>
                            @Html.ValidationMessageFor(model => model.City, "", new { @class = "text-danger" })
                        </div>

                        <div class="enhanced-form-group">
                            @Html.LabelFor(model => model.Ward, "Phường/Xã/Quận", new { @class = "enhanced-label" })
                            <div class="icon-wrapper-select">
                                <i class="fas fa-map input-icon-left"></i>
                                <select id="ward" name="Ward" class="form-control-modern" required style="padding-left: 42px;">
                                    @if (!string.IsNullOrEmpty(Model.Ward))
                                    {
                                        <option value="@Model.Ward" selected>@Model.Ward</option>
                                    }
                                    else
                                    {
                                        <option value="" selected disabled>-- Vui lòng chọn Tỉnh/Thành trước --</option>
                                    }
                                </select>
                            </div>
                            @Html.ValidationMessageFor(model => model.Ward, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>

                @Html.HiddenFor(model => model.PassCus)
                @Html.HiddenFor(model => model.RegisteredDate)
                @Html.HiddenFor(model => model.MembershipLevel)
                @Html.HiddenFor(model => model.IsVIP)

                <div class="submit-container">
                    <button type="submit" class="btn-submit-main">
                        <i class="fas fa-save"></i> Lưu thông tin
                    </button>
                </div>
            } 
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            
            // Xử lý Lịch
            flatpickr("#DateOfBirth", {
                locale: "vn", 
                dateFormat: "d-m-Y", 
                allowInput: true, 
                minDate: "01-01-1936",
                maxDate: "31-12-2099",
            });
            
            // API Địa chỉ
            await loadAddressData();
        });

        async function loadAddressData() {
            try {
                const res = await fetch("https://cdn.jsdelivr.net/gh/giaodienblog/cdn@master/provinces-database.json");
                const data = await res.json();
                
                const provinceSelect = document.getElementById('province');
                const wardSelect = document.getElementById('ward');
                
                const currentCity = '@Html.Raw(Model.City)';
                
                // Đổ danh sách Tỉnh/Thành
                data.forEach(p => {
                    const opt = document.createElement("option");
                    const name = p.Name || p.FullName || p.name;
                    
                    opt.value = name; 
                    opt.textContent = name;
                    opt.setAttribute('data-code', p.Code || p.code); 
                    
                    if (name !== currentCity) {
                        provinceSelect.appendChild(opt);
                    }
                });

                // Xử lý khi đổi Tỉnh/Thành
                provinceSelect.addEventListener("change", () => {
                    wardSelect.innerHTML = '<option value="" selected disabled>-- Chọn Phường/Xã/Quận --</option>';
                    
                    const selectedOption = provinceSelect.options[provinceSelect.selectedIndex];
                    const provinceCode = selectedOption.getAttribute('data-code');
                    
                    const prov = data.find(p => (p.Code || p.code) == provinceCode);
                    
                    if (prov && prov.Wards) {
                        prov.Wards.forEach(w => {
                            const o = document.createElement("option");
                            const wardName = (w.AdministrativeUnitShortName ? w.AdministrativeUnitShortName + " " : "") + (w.Name || w.FullName || w.name);
                            o.value = wardName;
                            o.textContent = wardName;
                            wardSelect.appendChild(o);
                        });
                    }
                });

            } catch (error) {
                console.error("Lỗi tải dữ liệu địa chỉ:", error);
            }
        }
    </script>
}